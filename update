Tour_SpotRect(name, W, H) {
    global mainCardRects, tabh, tabrects
    if (name = "") 
        return {x:0, y:0, w:0, h:0}
    if (name = "tabs")
        return {x:6, y:6, w:W-12, h:tabh-8}
    if (name = "panel") {
        leftEdge := (IsObject(tabrects) && tabrects.MaxIndex() >= 1) ? tabrects[1].x - 10 : 230
        return {x:leftEdge, y:tabh+6, w:(W-16)-leftEdge, h:H-tabh-84}
    }
    for i, c in mainCardRects {
        if (c.id = name)
            return {x:c.x-4, y:c.y-4, w:c.w+8, h:c.h+8}
    }
    if (name = "cards" && IsObject(mainCardRects) && mainCardRects.MaxIndex() >= 1) {
        a := mainCardRects[1], b := mainCardRects[mainCardRects.MaxIndex()]
        return {x:a.x-4, y:a.y-4, w:(b.x + b.w) - a.x + 8, h:(b.y + b.h) - a.y + 8}
    }
    return {x:0, y:0, w:0, h:0}
}

TutTickFn() {
    global tutOpen
