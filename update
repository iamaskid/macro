}

ClearLingeringToasts() {
    global activeToasts
    if (!activeToasts.MaxIndex())
        return
    newList := []
    for i, toast in activeToasts {
        Gui, % toast.name . ":+LastFound"
        if (WinExist("ahk_id " . toast.hwnd))
            newList.Push(toast)
        else {
            Toast_Free(toast)
            Gui, % toast.name . ":Destroy"
        }
    }
    activeToasts := newList
}

RearrangeToasts() {
    global activeToasts, toastHeight, toastWidth, toastSpacing, notifPos
    if (!activeToasts.MaxIndex())
        return
    SysGet, MonitorWorkArea, MonitorWorkArea
    baseX := (notifPos = 1 || notifPos = 3) ? (MonitorWorkAreaLeft + 16) : (MonitorWorkAreaRight - toastWidth - 16)
    if (notifPos >= 2)
        baseY := MonitorWorkAreaBottom - 16 - toastHeight
    else
        baseY := MonitorWorkAreaTop + 16
    for i, toast in activeToasts {
        if (notifPos >= 2)
            newY := baseY - ((i - 1) * (toastHeight + toastSpacing))
        else
            newY := baseY + ((i - 1) * (toastHeight + toastSpacing))
        toast.y := newY
        currentHwnd := toast.hwnd
        if (WinExist("ahk_id " . currentHwnd))
            WinMove, ahk_id %currentHwnd%,, baseX, %newY%
    }
}

