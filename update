#NoEnv
#SingleInstance Force
SetBatchLines, -1
#MaxThreadsPerHotkey 1

; ==============================================================================
; SETTINGS
; ==============================================================================
keybind := "XButton2" ; MAIN KEY : CHANGE HERE
scroll := "on" ; alternative of the macro (uses scrollwheel instead) ; true, false / on, off/ 1, 0.

autoupdate := "on" ; true, false / on, off/ 1, 0.
panickey := "F12"  ; TERMINATE SCRIPT : CHANGE HERE

; ==============================================================================
; MW3 SETTINGS
; ==============================================================================
delay := 25   ; CHANGE KEYBOARD DELAY HERE (the higher the slower)
sdelay := 15  ; CHANGE SCROLLWHEEL DELAY HERE (the higher the slower)

; ==============================================================================
; MW19 SETTINGS
; ==============================================================================
wdelay := 38   ; CHANGE KEYBOARD DELAY HERE (the higher the slower)
swdelay := 80  ; CHANGE SCROLLWHEEL DELAY HERE (the higher the slower)

kdelay := 130  ; CHANGE KEYBOARD & SCROLLWHEEL DELAY HERE (the higher the slower)

; ==============================================================================
; WARZONE SETTINGS
; ==============================================================================
wzdelay := 25   ; CHANGE KEYBOARD DELAY HERE (the higher the slower)
swzdelay := 15  ; CHANGE SCROLLWHEEL DELAY HERE (the higher the slower)

; ==============================================================================
; ==============================================================================

; ==============================================================================
; version := 1.6
updateurl := "https://raw.githubusercontent.com/iamaskid/macro/refs/heads/main/update"

if (autoupdate = "on" || autoupdate = "true" || autoupdate = 1)
{
    try {
        FileRead, localcode, %A_ScriptFullPath%
        localversion := 0
        if RegExMatch(localcode, "i);\s*version\s*:=\s*([\d\.]+)", localmatch) {
            localversion := localmatch1 + 0
        }

        whr := ComObjCreate("WinHttp.WinHttpRequest.5.1")
        whr.Open("GET", updateurl, false)
        whr.Send()
        onlinecode := whr.ResponseText

        if RegExMatch(onlinecode, "i);\s*version\s*:=\s*([\d\.]+)", match) {
            onlineversion := match1 + 0
            if (onlineversion > localversion) {
                Gui, Updater:New, -MinimizeBox -MaximizeBox +AlwaysOnTop, Updater
                Gui, Updater:Font, s10, Segoe UI
                Gui, Updater:Add, Text, x20 y15 w260 h20 vStatusText, Downloading update...
                Gui, Updater:Add, Progress, x20 y40 w260 h20 -Smooth vProgressBar Range0-100, 0
                Gui, Updater:Show, w300 h80, Updating...

                Loop, 80 {
                    GuiControl, Updater:, ProgressBar, %A_Index%
                    Sleep, 15
                }

                onlinecode := RegExReplace(onlinecode, "m)^autoupdate\s*:=\s*.*", "autoupdate := """ . autoupdate . """")
                onlinecode := RegExReplace(onlinecode, "m)^scroll\s*:=\s*.*", "scroll := """ . scroll . """")
                onlinecode := RegExReplace(onlinecode, "m)^panickey\s*:=\s*.*", "panickey := """ . panickey . """")
                onlinecode := RegExReplace(onlinecode, "m)^keybind\s*:=\s*.*", "keybind := """ . keybind . """")
                onlinecode := RegExReplace(onlinecode, "m)^delay\s*:=\s*\d+", "delay := " . delay)
                onlinecode := RegExReplace(onlinecode, "m)^sdelay\s*:=\s*\d+", "sdelay := " . sdelay)
                onlinecode := RegExReplace(onlinecode, "m)^wdelay\s*:=\s*\d+", "wdelay := " . wdelay)
                onlinecode := RegExReplace(onlinecode, "m)^swdelay\s*:=\s*\d+", "swdelay := " . swdelay)
                onlinecode := RegExReplace(onlinecode, "m)^kdelay\s*:=\s*\d+", "kdelay := " . kdelay)
                onlinecode := RegExReplace(onlinecode, "m)^wzdelay\s*:=\s*\d+", "wzdelay := " . wzdelay)
                onlinecode := RegExReplace(onlinecode, "m)^swzdelay\s*:=\s*\d+", "swzdelay := " . swzdelay)

                file := FileOpen(A_ScriptFullPath, "w")
                file.Write(onlinecode)
                file.Close()

                GuiControl, Updater:, ProgressBar, 100
                GuiControl, Updater:, StatusText, Complete!
                Sleep, 600
                Gui, Updater:Destroy

                Reload
                ExitApp
            }
        }
    }
}

if not A_IsAdmin
{
    Run *RunAs "%A_ScriptFullPath%"
    ExitApp
}

SetKeyDelay, 0, 40

if (panickey != "")
    Hotkey, %panickey%, panicexit

if (keybind != "") {
    Hotkey, IfWinActive, ahk_exe cod23-cod.exe
    Hotkey, $*%keybind%, mw3swap
    
    Hotkey, IfWinActive, ahk_exe ModernWarfare.exe
    Hotkey, $*%keybind%, mw19swap
    
    Hotkey, IfWinActive, ahk_exe cod.exe
    Hotkey, $*%keybind%, wzswap
    Hotkey, IfWinActive
}

kali := false
lastpress := 0
return

panicexit:
    ExitApp
return

isscroll() {
    global scroll
    return (scroll = "on" || scroll = "true" || scroll = 1)
}

sendup() {
    if isscroll()
        Send, {WheelUp}
    else {
        Send, {1 Down}
        Sleep, 30
        Send, {1 Up}
    }
}

senddown() {
    if isscroll()
        Send, {WheelDown}
    else {
        Send, {2 Down}
        Sleep, 30
        Send, {2 Up}
    }
}

sendreset() {
    Send, {1 Down}
    Sleep, 20
    Send, {1 Up}
}

#IfWinActive ahk_exe cod23-cod.exe

mw3swap:
    cur_delay := isscroll() ? sdelay : delay

    while GetKeyState(keybind, "P")
    {
        if GetKeyState("RButton", "P")
        {
            while GetKeyState("RButton", "P")
            {
                if !GetKeyState(keybind, "P")
                    break 2
                Sleep, 10
            }
            Sleep, 50
        }

        sendup()
        Sleep, cur_delay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        senddown()
        Sleep, cur_delay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        sendup()
        Sleep, cur_delay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        senddown()
        Sleep, cur_delay
    }

    sendreset()
return

#IfWinActive

#IfWinActive ahk_exe ModernWarfare.exe

~1::
    kali := false
return

$2::
    Send, {2}
    
    if GetKeyState(keybind, "P")
        return

    if (A_TickCount - lastpress < 5125)
    {
        kali := false
        lastpress := 0
        return
    }
    lastpress := A_TickCount
    kali := true
return

mw19swap:
    cur_wdelay := isscroll() ? swdelay : wdelay
    cur_kdelay := kdelay

    while GetKeyState(keybind, "P")
    {
        if GetKeyState("RButton", "P")
        {
            while GetKeyState("RButton", "P")
            {
                if !GetKeyState(keybind, "P")
                    break 2
                Sleep, 10
            }
            Sleep, 50
        }

        if (kali)
        {
            senddown()
            Sleep, cur_kdelay
            
            if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
                break

            Sleep, cur_wdelay
            if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
                break
        }
        else
        {
            sendup()
            Sleep, cur_wdelay
            if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
                break

            senddown()
            Sleep, cur_wdelay
            if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
                break

            sendup()
            Sleep, cur_wdelay
            if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
                break

            senddown()
            Sleep, cur_wdelay
        }
    }

    sendreset()
    kali := false
return

#IfWinActive

#IfWinActive ahk_exe cod.exe

wzswap:
    cur_wzdelay := isscroll() ? swzdelay : wzdelay

    while GetKeyState(keybind, "P")
    {
        if GetKeyState("RButton", "P")
        {
            while GetKeyState("RButton", "P")
            {
                if !GetKeyState(keybind, "P")
                    break 2
                Sleep, 10
            }
            Sleep, 50
        }

        sendup()
        Sleep, cur_wzdelay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        senddown()
        Sleep, cur_wzdelay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        sendup()
        Sleep, cur_wzdelay
        if (!GetKeyState(keybind, "P") || GetKeyState("RButton", "P"))
            break

        senddown()
        Sleep, cur_wzdelay
    }

    sendreset()
return

#IfWinActive

!M::Reload
