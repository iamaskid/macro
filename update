BackgroundFade() {
    global guiOpa, guiDragging, dragStyle
    f := guiOpa / 100
    f := (guiDragging && dragStyle = 3) ? f * 0.45 : f
    return f
}

ApplyAlpha(argb, a) {
    if (a >= 1.0)
        return argb
    origA := (argb >> 24) & 0xFF
    newA  := Round(origA * a)
    return (newA << 24) | (argb & 0x00FFFFFF)
}

EaseOutCubic(x) {
    if (x <= 0)
        return 0
    if (x >= 1)
        return 1
    y := 1 - x
    return 1 - y*y*y
}

EaseInOutCubic(x) {
    if (x <= 0)
        return 0
    if (x >= 1)
        return 1
    if (x < 0.5)
        return 4*x*x*x
    y := -2*x + 2
    return 1 - y*y*y/2
}

AnimFrac(key, target, speed=0.30) {
    global animVals, animFrame, lite
    if (lite) {
        animVals[key] := target
        return target
    }
    cur := animVals.HasKey(key) ? animVals[key] : target
    diff := target - cur
    if (Abs(diff) <= 0.0016) {
        animVals[key] := target
        return target
    }
    animFrame := true
    cur += diff * speed
    animVals[key] := cur
    return cur
}

AnimTween(key, durMs, easing="out") {
    global tweenStart, animFrame, lite
    if (lite) {
        if (tweenStart.HasKey(key))
            tweenStart.Delete(key)
        return 1
    }
    if (!tweenStart.HasKey(key))
        tweenStart[key] := A_TickCount
    t := (A_TickCount - tweenStart[key]) / durMs
    if (t >= 1) {
        t := 1
    } else {
        animFrame := true
    }
    if (easing = "inout")
        return EaseInOutCubic(t)
    if (easing = "linear")
        return t
    return EaseOutCubic(t)
}

RestartAnim(key) {
    global tweenStart
    tweenStart.Delete(key)
}

MixARGB(a, b, t) {
    if (t <= 0)
        return a
    if (t >= 1)
        return b
    aA := (a >> 24) & 0xFF, bA := (b >> 24) & 0xFF
    aR := (a >> 16) & 0xFF, bR := (b >> 16) & 0xFF
    aG := (a >> 8) & 0xFF,  bG := (b >> 8) & 0xFF
    aB := a & 0xFF,         bB := b & 0xFF
    A := Round(aA + (bA-aA)*t)
    R := Round(aR + (bR-aR)*t)
    G := Round(aG + (bG-aG)*t)
    B := Round(aB + (bB-aB)*t)
    return (A << 24) | (R << 16) | (G << 8) | B
}

mixhex(a, b, t) {
    return ARGBToHex(MixARGB(HexToARGB(a), HexToARGB(b), t))
}

HexToARGB(s) {
    n := 0
    Loop, 8
        n := (n << 4) | HexNibble(SubStr(s, A_Index, 1))
    return n
}

HexNibble(c) {
    static d := "0123456789ABCDEF"
    p := InStr(d, c)
    return (p > 0) ? p - 1 : 0
}

RotPt(px, py, cx, cy, deg) {
    if (deg = 0)
        return [px, py]
    rad := deg * 0.0174532925
    dx := px - cx, dy := py - cy
    return [cx + dx*Cos(rad) - dy*Sin(rad), cy + dx*Sin(rad) + dy*Cos(rad)]
}

ARGBToHex(n) {
    static d := "0123456789ABCDEF"
    n := n & 0xFFFFFFFF
    out := ""
    Loop, 4 {
        shift := (4 - A_Index) * 8
        byte := (n >> shift) & 0xFF
        out .= SubStr(d, (byte >> 4) + 1, 1) . SubStr(d, (byte & 15) + 1, 1)
    }
    return out
}

StartAnim() {
    global animOn, lite
    if (animOn || lite)
        return
    animOn := true
    SetTimer, AnimTick, 33
}

StopAnim() {
    global animOn
    animOn := false
    SetTimer, AnimTick, Off
}

AnimTick:
    global animFrame, animOn, menuhwnd, isdragging, lastDraw
    global mediahwnd, mediaWinOpen
    menuOn := (menuhwnd && !isdragging && DllCall("IsWindowVisible", "Ptr", menuhwnd)) ? true : false
    ovOn := Ov_Visible()
    global animActive
    mediaOn := (mediahwnd && (mediaWinOpen || animActive) && DllCall("IsWindowVisible", "Ptr", mediahwnd)) ? true : false
    if (!menuOn && !ovOn && !mediaOn) {
        StopAnim()
        return
    }
    if (menuOn && !ovOn && !mediaOn && (A_TickCount - lastDraw < 7))
        return
    animFrame := false
    Media_Smooth()
    if (menuOn)
        DrawMenu()
    if (ovOn)
        DrawOverlay()
    if (mediaOn)
        DrawMediaWindow()
    if (!animFrame)
        StopAnim()
return

drawslider(G, x, y, w, val, varName, minV=0, maxV=100) {
    global sldrects, sldValRects, mousex, mousey, cA1, cA2
    global slEditId, editTxt, cFld, cTx
    trackH := 4
    trackY := y + 4
    thumbR := 5
    valX := x + w - 44, valY := y - 15, valW := 48, valH := 18
    if (slEditId = varName) {
        pField := Gdip_BrushCreateSolid(ApplyAlpha(cFld, 0.95))
        lfillroundrect(G, pField, valX, valY, valW, valH, 3)
        Gdip_DeleteBrush(pField)
        pFieldPen := Gdip_CreatePen(cA2, 1)
        ldrawroundrect(G, pFieldPen, valX, valY, valW, valH, 3)
        Gdip_DeletePen(pFieldPen)
        DrawFieldText(G, editTxt, "sldedit", true, valX + 4, valY, valW - 8, valH, cTx, 9, "Segoe UI", "Left")
    } else {
        lstroketext(G, val, x + w - 34, y - 14, 38, 14, cDim, 8, "Right")
    }
    sldValRects.Push({x: valX, y: valY, w: valW, h: valH, id: varName, minV: minV, maxV: maxV})
    disp := AnimFrac("sld:" . varName, val, 0.55)
    onTrack := (mousex >= x && mousex <= x+w && mousey >= trackY-6 && mousey <= trackY+trackH+6)
    thov := AnimFrac("sldtrack:" . varName, onTrack ? 1 : 0, 0.35)
    pTrackBg := Gdip_BrushCreateSolid(MixARGB(cTrk, cTrkHot, thov))
    lfillroundrect(G, pTrackBg, x, trackY, w, trackH, 2)
    Gdip_DeleteBrush(pTrackBg)
    frac := (maxV > minV) ? ((disp-minV) / (maxV-minV)) : 0
    frac := (frac < 0) ? 0 : frac
    frac := (frac > 1) ? 1 : frac
    fillW := Round(w * frac)
    if (fillW > 0) {
        pGrad := Gdip_CreateLineBrush(x, trackY, x + fillW, trackY, cA1, cA2, 1)
        lfillroundrect(G, pGrad, x, trackY, fillW, trackH, 2)
        Gdip_DeleteBrush(pGrad)
    }
    thumbX := x + fillW - thumbR
    thumbY := trackY + (trackH // 2) - thumbR
    hover  := (mousex >= thumbX - 5 && mousex <= thumbX + thumbR * 2 + 5 && mousey >= thumbY - 5 && mousey <= thumbY + thumbR * 2 + 5)
    hov := AnimFrac("sldhov:" . varName, hover ? 1 : 0, 0.35)
    tClr := ApplyAlpha(cA2, 0.85 + 0.15*hov)
    rad  := thumbR + 0.9*hov
    pB   := Gdip_BrushCreateSolid(tClr)
    Gdip_FillEllipse(G, pB, thumbX + thumbR - rad, thumbY + thumbR - rad, rad * 2, rad * 2)
    Gdip_DeleteBrush(pB)
    pThumbPen := Gdip_CreatePen(MixARGB(cA1, cKb, hov), 1)
    Gdip_DrawEllipse(G, pThumbPen, thumbX, thumbY, thumbR * 2, thumbR * 2)
    Gdip_DeletePen(pThumbPen)
    sldrects.Push({x: x, y: trackY, w: w, h: trackH + 6, id: varName, minV: minV, maxV: maxV})
    return y + 14
}

