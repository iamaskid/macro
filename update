        , 0xFFF0B95A, 0xFF5FA8E8, 0xFFFF8A4A, 0xFFC9C9D6]
    return (idx >= 0 && idx < cols.MaxIndex() + 1) ? cols[idx+1] : 0xFFD8D8E8
}

ChatTextHeight(txt, w, size) {
    if (txt = "" || w <= 0)
        return 0
    lh := size + 5
    per := w / (size * 0.60)
    per := (per < 1) ? 1 : per
    lines := 0
    for i, ln in StrSplit(txt, "`n") {
        n := Ceil(StrLen(ln) / per)
        n := (n < 1) ? 1 : n
        lines += n
    }
    lines := (lines > 5) ? 5 : lines
    return lines * lh
}

FileToBase64(path) {
    b64 := ""
    try {
        stream := ComObjCreate("ADODB.Stream")
        stream.Type := 1
        stream.Open()
        stream.LoadFromFile(path)
        node := ComObjCreate("Msxml2.DOMDocument").createElement("b64")
        node.dataType := "bin.base64"
        node.nodeTypedValue := stream.Read()
        b64 := RegExReplace(node.text, "\s", "")
        stream.Close()
    } catch e {
        b64 := ""
    }
    return b64
}

Base64ToFile(b64, path) {
    ok := false
    try {
        node := ComObjCreate("Msxml2.DOMDocument").createElement("b64")
        node.dataType := "bin.base64"
        node.text := b64
        stream := ComObjCreate("ADODB.Stream")
        stream.Type := 1
        stream.Open()
        stream.Write(node.nodeTypedValue)
        stream.SaveToFile(path, 2)
        stream.Close()
        ok := true
    } catch e {
        ok := false
    }
    return ok
}

ChatImageGet(key, data) {
