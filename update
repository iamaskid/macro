menumousemove(wParam, lParam, msg, hwnd) {
    global menuhwnd, mousex, mousey, chathwnd, sliderDragId, sldrects, dpiScale
    global lite, hovSig
    global resizing, winw, winh, overlayhwnd, linkhwnd
    if (hwnd = linkhwnd) {
        lp := XY_FromLParam(lParam)
        mousex := lp[1], mousey := lp[2]
        Link_Draw()
        return
    }
    global guiDragging, guiDragOffX, guiDragOffY, dragStyle, menuhwnd
    if (hwnd = overlayhwnd) {
        p := XY_FromLParam(lParam)
        mousex := p[1], mousey := p[2]
        Ov_HandleMove(p[1], p[2])
        DrawOverlay()
        return
    }
    if (hwnd = mediahwnd) {
        mp2 := XY_FromLParam(lParam)
        mousex := mp2[1], mousey := mp2[2]
        Media_HandleMove(mp2[1], mp2[2])
        DrawMediaWindow()
        return
    }
    if (hwnd != menuhwnd && hwnd != chathwnd)
        return
    rawX := lParam & 0xFFFF
    rawY := (lParam >> 16) & 0xFFFF
    if (rawX > 0x7FFF)
        rawX -= 0x10000
    if (rawY > 0x7FFF)
        rawY -= 0x10000
    x := rawX, y := rawY
    if (hwnd = menuhwnd) {
        x := Round(x / dpiScale)
        y := Round(y / dpiScale)
    }
    mousex := x, mousey := y
    if (hwnd = menuhwnd) {
        if (guiDragging) {
            MouseGetPos, msx, msy
            DllCall("SetWindowPos", "Ptr", menuhwnd, "Ptr", 0
                , "Int", Round(msx - guiDragOffX), "Int", Round(msy - guiDragOffY)
                , "Int", 0, "Int", 0, "UInt", 0x0015)
            return
        }
        if (resizing) {
            newW := Round(rawX / dpiScale)
            newH := Round(rawY / dpiScale)
            newW := (newW < 360) ? 360 : newW
            newW := (newW > 900) ? 900 : newW
            if (newH < 320)
                newH := 320
            if (newH > 900)
                newH := 900
            if (newW != winw || newH != winh) {
                winw := newW, winh := newH
                ApplyWindowGeometry()
            }
            return
        }
        global codeDragging, codeCursorPos, codeSelAnchor, dragStart
        if (codeDragging) {
            hit := CodeXYToPos(x, y)
            if (!codeSelAnchor && hit.pos != dragStart)
                codeSelAnchor := dragStart
            codeCursorPos := hit.pos
            RequestMenuRedraw()
            return
        }
        if (sliderDragId != "") {
            for i, r in sldrects {
                if (r.id = sliderDragId)
                    UpdateSliderFromMouse(r, x)
            }
            return
        }
        if (lite) {
            sig := HoverSignature(x, y)
            if (sig = hovSig)
                return
            hovSig := sig
        }
        RequestMenuRedraw()
    } else {
        global chatResizing
        if (chatResizing) {
            MouseGetPos, rzx, rzy
            WinGetPos, rwx, rwy,,, ahk_id %chathwnd%
            newW := rzx - rwx, newH := rzy - rwy
            if (newW < 220)
                newW := 220
            if (newH < 220)
                newH := 220
            if (newW > 700)
                newW := 700
            if (newH > 900)
                newH := 900
            if (newW != chatw || newH != chath)
                ChatResize(newW, newH)
            return
        }
        global chatMenuOpen
        if (chatMenuOpen)
            DrawChatPanel()
    }
}

menumouseup(wParam, lParam, msg, hwnd) {
    global sbdragging, sliderDragId, resizing, slTrackW, mediahwnd
    global chatResizing, chathwnd
    global mainDragId, mainCardRects, mainOrder, mainLayout, gap
    if (mainDragId != "") {
        DllCall("ReleaseCapture")
        mp := XY_FromLParamScaled(lParam)
        mx := mp[1], my := mp[2]
        src := mainDragId
        mainDragId := ""
        idx := 0
        if (IsObject(mainLayout)) {
            if (mx < mainLayout.rx)
                idx := (my < mainLayout.midY) ? 1 : 2
            else
                idx := 3
        }
        iSrc := 0
        for i, id in mainOrder {
            if (id = src)
                iSrc := i
        }
        if (iSrc && idx && idx != iSrc) {
            mainOrder.RemoveAt(iSrc)
            mainOrder.InsertAt(idx, src)
            MainOrder_Save()
        }
        DrawMenu()
        return
    }
    if (chatResizing) {
        DllCall("ReleaseCapture")
        chatResizing := false
        Storage_AutoSave()
        return
    }
    if (hwnd = mediahwnd) {
        Media_HandleUp()
        return
    }
    global codeDragging, codeSelAnchor, codeCursorPos, dragStart
    global overlayhwnd, ovDragMode, guiDragging
    if (hwnd = overlayhwnd || ovDragMode != "") {
        Ov_HandleUp()
        return
    }
    if (guiDragging) {
        DllCall("ReleaseCapture")
        guiDragging := false
        Storage_AutoSave()
        DrawMenu()
        return
    }
    if (resizing) {
        DllCall("ReleaseCapture")
        Storage_AutoSave()
    }
    if (codeDragging) {
        DllCall("ReleaseCapture")
        codeDragging := false
        dragStart := 0
    }
    sbdragging := false
    sliderDragId := ""
    slTrackW := 0
    resizing := false
