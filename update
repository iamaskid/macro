    else if (menuhwnd)
        WinGetPos, cx, cy, cw, ch, ahk_id %menuhwnd%
    if (cw <= 0)
        cw := linkW, ch := linkH
    px := cx + (cw - linkW) // 2
    py := cy + (ch - linkH) // 3
