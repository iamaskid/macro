LinkHost(url) {
    u := RegExReplace(url, "i)^https?://", "")
    p := InStr(u, "/")
    u := (p) ? SubStr(u, 1, p-1) : u
    p := InStr(u, "?")
    u := (p) ? SubStr(u, 1, p-1) : u
    return RegExReplace(u, "i)^www\.", "")
}

LinkTrustedLoad() {
