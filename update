DrawTooltipOverlay(G, W, H) {
    global tips, mousex, mousey, btnrects, chkrects, sldrects, tabrects, sbIconRects, overMenu, ddrects, ddopen, ddrenderdata
    if (!tips || !overMenu)
        return
    if (ddopen != "") {
        if (IsObject(ddrenderdata) && IsObject(ddrenderdata.tips)) {
            for i, r in ddrects {
                if (r.tag != "option")
                    continue
                if (mousex >= r.x && mousex <= r.x+r.w && mousey >= r.y && mousey <= r.y+r.h) {
                    t := ddrenderdata.tips.HasKey(r.idx + 1) ? ddrenderdata.tips[r.idx + 1] : ""
                    if (t != "")
                        DrawTooltipBox(G, W, H, t)
                    return
                }
            }
        }
        return
    }
    text := ""
    sideLabels := {1:"Configure - pick your target game.", 2:"Main - enable and set up the macro.", 3:"Editor & Code - build macros or write a script.", 4:"Settings - options, appearance, and configs."}
    for i, r in sbIconRects {
        if (mousex >= r.x && mousex <= r.x+r.w && mousey >= r.y && mousey <= r.y+r.h) {
            text := sideLabels.HasKey(r.group) ? sideLabels[r.group] : ""
            break
        }
    }
    if (text = "") {
        for i, r in tabrects {
            if (mousex >= r.x && mousex <= r.x+r.w && mousey >= r.y && mousey <= r.y+r.h) {
                text := GetTabTooltipDesc(r.absIdx)
                break
            }
        }
    }
    if (text = "") {
        for i, r in btnrects {
            if (mousex >= r.x && mousex <= r.x+r.w && mousey >= r.y && mousey <= r.y+r.h) {
                text := r.HasKey("tip") ? r.tip : GetTooltipDesc(r.id)
                if (text != "")
                    break
            }
        }
    }
    if (text = "") {
        for i, r in ddrects {
