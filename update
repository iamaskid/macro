DrawTooltipBox(G, W, H, text) {
    global mousex, mousey
    pad := 7
    size := 10
    tw := StrLen(text) * size * 0.6 + pad*2
    tw := (tw > 330) ? 330 : tw
    th := size + 6 + pad*2
    tp := AnimTween("tip:" . text, 140)
    tx := mousex + 14
    ty := mousey + 14 + (1 - tp) * 4
    tx := (tx + tw > W - 4) ? W - 4 - tw : tx
    ty := (ty + th > H - 4) ? H - 4 - th : ty
    pShadow := Gdip_BrushCreateSolid(ApplyAlpha(cSh2, tp))
    lfillroundrect(G, pShadow, tx+2, ty+3, tw, th, 5)
    Gdip_DeleteBrush(pShadow)
    pBg := Gdip_BrushCreateSolid(ApplyAlpha(cGlass, tp))
    lfillroundrect(G, pBg, tx, ty, tw, th, 5)
    Gdip_DeleteBrush(pBg)
    pBorder := Gdip_CreatePen(ApplyAlpha(cLn2, tp), 1)
    ldrawroundrect(G, pBorder, tx, ty, tw, th, 5)
    Gdip_DeletePen(pBorder)
    lstroketext(G, text, tx+pad, ty+pad, tw-pad*2, th-pad*2, ARGBToHex(ApplyAlpha(HexToARGB(cTx), tp)), size, "Left", "vCenter")
}

