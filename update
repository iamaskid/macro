ScrollAnimSnap() {
    global genScrollY, genTgt, scrAnim
    global editorScrollY, editorTgt, codeScrollY, codeScrTgt
    global consoleY, consoleTgt
    global scEditor, scCode, scConsole
    for k, t in genTgt
        genScrollY[k] := t
    editorScrollY := editorTgt
    codeScrollY := codeScrTgt
    consoleY := consoleTgt
    scEditor := editorScrollY
    scCode := codeScrollY
    scConsole := consoleY
    scrAnim := false
}

StartScrollAnim() {
    global scrAnim, editorScrollY, codeScrollY, consoleY
    global scEditor, scCode, scConsole, scTick, lite
    if (lite) {
        ScrollAnimSnap()
        RequestMenuRedraw()
        return
    }
    scEditor := editorScrollY, scCode := codeScrollY, scConsole := consoleY
    scTick := A_TickCount
    if (scrAnim)
        return
    scrAnim := true
    SetTimer, ScrollAnimTick, 16
}

ScrollAnimTick() {
    global genScrollY, genTgt, scrAnim
    global editorScrollY, editorTgt, scEditor
    global codeScrollY, codeScrTgt, scCode
    global consoleY, consoleTgt, scConsole, scTick, lite
    if (lite) {
        ScrollAnimSnap()
        SetTimer, ScrollAnimTick, Off
        RequestMenuRedraw()
        return
    }
    now := A_TickCount
    dt := now - scTick
    scTick := now
    dt := (dt < 1) ? 1 : dt
    dt := (dt > 60) ? 60 : dt
    frac := 1 - Exp(-dt / 42)
    moving := false
    for k, target in genTgt {
        cur := genScrollY.HasKey(k) ? genScrollY[k] : 0
        diff := target - cur
        if (Abs(diff) < 0.5) {
            genScrollY[k] := target
            continue
        }
        genScrollY[k] := cur + diff * frac
        moving := true
    }
    moving := (ScrollEase(editorScrollY, editorTgt, scEditor, frac)) ? true : moving
    moving := (ScrollEase(codeScrollY, codeScrTgt, scCode, frac)) ? true : moving
    moving := (ScrollEase(consoleY, consoleTgt, scConsole, frac)) ? true : moving
    RequestMenuRedraw()
    if (!moving) {
        scrAnim := false
        SetTimer, ScrollAnimTick, Off
    }
}

ScrollEase(ByRef cur, ByRef target, ByRef seen, frac := 0.34) {
    if (cur != seen) {
        target := cur
        seen := cur
        return false
    }
    diff := target - cur
    if (Abs(diff) < 0.5) {
        cur := target
        seen := cur
        return false
    }
    cur := cur + diff * frac
    seen := cur
    return true
}

VerParts(v) {
    out := []
    Loop, Parse, v, .
        out.Push(RegExReplace(A_LoopField, "[^0-9]", "") + 0)
    return out
}

VerNewer(a, b) {
    pa := VerParts(a), pb := VerParts(b)
    Loop, 4 {
        x := (A_Index <= pa.MaxIndex()) ? pa[A_Index] : 0
        y := (A_Index <= pb.MaxIndex()) ? pb[A_Index] : 0
        if (x > y)
            return true
        if (x < y)
            return false
    }
    return false
}

Update_Check(manual := false) {
    global autoUpd, updateUrl, updateBusy, brandName, appVersion, updateLastCheck, updateNotified, iniPath
    if (updateBusy) {
        if (manual)
            ShowToast(brandName, "Already checking")
        return
    }
    if (updateUrl = "") {
        if (manual)
            ShowToast(brandName, "Paste your version.txt link first")
        return
    }
    updateBusy := true
    updateLastCheck := A_TickCount
    tmp := A_Temp . "\unicorn_update_check.txt"
    FileDelete, %tmp%
    UrlDownloadToFile, %updateUrl%, %tmp%
    err := ErrorLevel
    if (err || !FileExist(tmp)) {
        FileDelete, %tmp%
        updateBusy := false
        ConsoleLog("Update check failed (" . err . ")")
        if (manual)
            ShowToast(brandName, "Update check failed - link or connection")
        return
    }
    FileRead, raw, %tmp%
    FileDelete, %tmp%
    updateBusy := false
    if (raw = "") {
        ConsoleLog("Update check - empty manifest")
        if (manual)
            ShowToast(brandName, "That link returned nothing")
        return
    }
    newVer := "", newUrl := ""
    Loop, Parse, raw, `n, `r
    {
        line := Trim(A_LoopField)
        if (line = "")
            continue
        p := InStr(line, "=")
        if (!p)
            continue
        k := Trim(SubStr(line, 1, p - 1)), v := Trim(SubStr(line, p + 1))
        if (k = "version")
            newVer := v
        else if (k = "url" || k = "download")
            newUrl := v
    }
    if (newVer = "") {
        ConsoleLog("Update check - no version line")
        if (manual)
            ShowToast(brandName, "No version found in that file")
        return
    }
    if (!VerNewer(newVer, appVersion)) {
        ConsoleLog("Update check - up to date (" . appVersion . ")")
        if (manual)
            ShowToast(brandName, "You're on the latest - " . appVersion)
        return
    }
    ConsoleLog("Update available " . newVer . " (this build " . appVersion . ")")
    if (manual) {
        if (newUrl != "")
            Run, %newUrl%
        ShowToast(brandName, "Update " . newVer . " available - opening download")
        updateNotified := newVer
        Storage_AutoSave()
        return
    }
    if (updateNotified = newVer)
        return
    updateNotified := newVer
    Storage_AutoSave()
    ShowToast(brandName, "Update " . newVer . " is out - Settings > Updates")
}

