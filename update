    Gdip_FillRectangle(G, pB, 0, 0, TW, totalH)
    Gdip_DeleteBrush(pB)

    pPen := Gdip_CreatePen(cBd, 1)
    Gdip_DrawRectangle(G, pPen, 0, 0, TW-1, totalH-1)
    Gdip_DeletePen(pPen)

    pGrad := Gdip_CreateLineBrush(acX, acY, acX, acY + acH, cA1, cA2, 1)
