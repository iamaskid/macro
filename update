    lstroketext(G, "unicorn", x + (w-12)/2 - 30, y+9, 60, 10, cTx2, 6)
    MockCard(G, x + w - 104, y+9, 70, 12, 1)
    lstroketext(G, "Search settings", x + w - 100, y+9, 62, 12, cFaint, 5, "Left")
    pLineH := Gdip_CreatePen(ApplyAlpha(cLn, 0.7), 1)
    Gdip_DrawLine(G, pLineH, x+12, y+24, x+w-12, y+24)
    Gdip_DeletePen(pLineH)

    sbW := 94
    pSide := Gdip_BrushCreateSolid(ApplyAlpha(cIns, 0.45))
    lfillroundrect(G, pSide, x+12, y+29, sbW, h-44, 5)
    Gdip_DeleteBrush(pSide)
    navs := ["Configure", "Main", "Editor & Code", "Settings"]
    Loop, 4 {
        ny := y + 35 + (A_Index - 1) * 19
