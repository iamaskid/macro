Search_Update() {
    global searchText, searchIndex, searchResults
    searchResults := []
    q := Trim(searchText)
    if (q = "")
        return
    for i, e in searchIndex {
        if (Search_Match(e.path . " " . e.kw, q))
            searchResults.Push(e)
        if (searchResults.MaxIndex() >= 7)
            break
    }
}

Search_Match(hay, needle) {
    if (InStr(hay, needle))
        return true
    for i, w in StrSplit(needle, " ") {
        if (w = "")
            continue
        if (!InStr(hay, w))
            return false
    }
    return true
}

Search_Open() {
    global searchFocus
    searchFocus := true
    Search_Update()
    DrawMenu()
}

Search_Clear() {
    global searchText, searchFocus, searchResults
    searchText := ""
    searchFocus := false
    searchResults := []
}

