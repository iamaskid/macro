SetupHoverCheck() {
    global setupHwnd, setupRects, setupHover, mousex, mousey
    if (!setupHwnd || !DllCall("IsWindowVisible", "Ptr", setupHwnd))
        return
    MouseGetPos, mx, my, mwin
    if (mwin != setupHwnd) {
        newHover := ""
        lx := -1, ly := -1
    } else {
        WinGetPos, wX, wY,,, ahk_id %setupHwnd%
        lx := mx - wX, ly := my - wY
        newHover := ""
        for i, r in setupRects {
            if (lx >= r.x && lx <= r.x+r.w && ly >= r.y && ly <= r.y+r.h) {
                newHover := r.id
                break
            }
        }
    }
    if (newHover != setupHover) {
        setupHover := newHover
        mousex := lx, mousey := ly
        DrawSetupDialog()
    }
}

SetupMouseClick(wParam, lParam, msg, hwnd) {
    global setupHwnd, setupRects, setupPick
    if (hwnd != setupHwnd)
        return
    lx := lParam & 0xFFFF, ly := (lParam >> 16) & 0xFFFF
    for i, r in setupRects {
        if (lx >= r.x && lx <= r.x+r.w && ly >= r.y && ly <= r.y+r.h) {
            setupPick := r.id
            return
        }
    }
}

DecodeBase64ToFile(b64, outPath) {
    if (b64 = "")
        return false
    try {
        xml := ComObjCreate("MSXML2.DOMDocument")
        node := xml.createElement("base64")
        node.dataType := "bin.base64"
        node.text := b64
        bin := node.nodeTypedValue

        stream := ComObjCreate("ADODB.Stream")
        stream.Type := 1
        stream.Open()
        stream.Write(bin)
        stream.SaveToFile(outPath, 2)
        stream.Close()
    } catch e {
        return false
    }
    return true
}

