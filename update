YY_PauseGate() {
    global kb_key, macPaused, reloadPause
    if (reloadPause) {
        Critical, Off
        while (reloadPause && GetKeyState(kb_key, "P"))
            Sleep, 15
        Critical, On
        if (!GetKeyState(kb_key, "P")) {
            macPaused := false
            return false
        }
    }
    if (YY_PauseMode(GetKeyState(kb_key, "P"), PauseHeld()) = "stop") {
        macPaused := false
        return false
    }
    if PauseHeld() {
        if (!macPaused)
            WeaponPrimary()
        macPaused := true
        Critical, Off
        Loop {
            Sleep, 10
            mode := YY_PauseMode(GetKeyState(kb_key, "P"), PauseHeld())
            if (mode = "stop") {
                macPaused := false
                Critical, On
                return false
            }
            if (mode = "go")
                break
        }
        macPaused := false
        Critical, On
    }
    return (YY_PauseMode(GetKeyState(kb_key, "P"), PauseHeld()) = "go")
}

