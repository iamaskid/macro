    Gdip_GetImageDimensions(bmp, iw, ih)
    if (!iw || !ih) {
        Gdip_DisposeImage(bmp)
        chImgCache[key] := 0
        return 0
    }
    v := {bmp:bmp, w:iw, h:ih}
    chImgN++
    if (chImgN > 24) {
