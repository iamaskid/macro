PP_RefreshProcessCache() {
    global ppCache, ppCacheT, ppOpen
    list := []
    seen := {}
    try {
        for proc in ComObjGet("winmgmts:").ExecQuery("SELECT Name FROM Win32_Process") {
            name := proc.Name
            if (name = "" || seen.HasKey(name))
                continue
            seen[name] := true
            list.Push(name)
        }
    }
    PP_SortArrayFast(list)
    ppCache := list
    ppCacheT := A_TickCount
    if (ppOpen)
        DrawMenu()
}

PP_SortArrayFast(ByRef arr) {
    if (!arr.MaxIndex())
        return
    joined := ""
    for i, v in arr
        joined .= v . "`n"
    Sort, joined
    arr := StrSplit(joined, "`n")
    while (arr.MaxIndex() && arr[arr.MaxIndex()] = "")
        arr.RemoveAt(arr.MaxIndex())
}

PP_GetProcessList(filter="") {
    global ppCache
    if (!ppCache.MaxIndex())
        PP_RefreshProcessCache()
    if (filter = "")
        return ppCache
    list := []
    for i, name in ppCache {
        if InStr(name, filter)
            list.Push(name)
    }
    return list
}

PP_Open(slotIdx=0) {
    global ppOpen, ppEditSlot, ppSearchText, ppFocus
    ppOpen := true
    RestartAnim("ppin")
    ppEditSlot := slotIdx
    ppSearchText := ""
    ppFocus := false
    PP_RefreshProcessCache()
    SetTimer, PP_RefreshProcessCache, 8000
    DrawMenu()
}

PP_HandleClick(id) {
    global ppOpen, ppFocus, ppEditSlot, targetGames, targetExe, brandName
    if (id = "ppclose") {
        ppOpen := false
        ppFocus := false
        SetTimer, PP_RefreshProcessCache, Off
    } else if (id = "ppsearch") {
        ppFocus := true
    } else if (InStr(id, "ppitem:") = 1) {
        exe := SubStr(id, 8)
        if (ppEditSlot = 1 || ppEditSlot = 2) {
            targetGames[ppEditSlot] := exe
            targetExe := exe
            Storage_AutoSave()
            ShowToast(brandName, "Slot " . ppEditSlot . " set: " . exe)
            ConsoleLog("Slot " . ppEditSlot . " set to " . exe)
        } else {
            OnTargetGameChosen(exe)
        }
        ppOpen := false
        ppFocus := false
        SetTimer, PP_RefreshProcessCache, Off
    }
    DrawMenu()
}

Target_ClearSlot(idx) {
    global targetGames, targetExe, brandName
    exe := targetGames[idx]
    if (exe = "")
        return
    targetGames[idx] := ""
    if (targetExe = exe) {
        other := (idx = 1) ? 2 : 1
        targetExe := targetGames[other]
    }
    Storage_AutoSave()
    ShowToast(brandName, "Target removed: " . exe)
    ConsoleLog("Cleared target slot " . idx . " (" . exe . ")")
    DrawMenu()
}

OnTargetGameChosen(exe) {
    global targetExe, targetGames
    if (targetGames[1] != exe) {
        targetGames[2] := targetGames[1]
        targetGames[1] := exe
    }
    targetExe := exe
    Storage_AutoSave()
    ShowToast(brandName, "Target set: " . exe)
    ConsoleLog("Target process set to " . exe)
}

