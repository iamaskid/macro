Lyrics_Height() {
    global lyOn, lyState, lyTexts
    p := AnimFrac("lyrpanel", lyOn ? 1 : 0, 0.2)
    if (!lyOn && p <= 0.02)
        return 0
    base := 34
    if (lyState = "ok" && lyTexts.MaxIndex() != "") {
        n := lyTexts.MaxIndex()
        if (n > Lyrics_MaxLines())
            n := Lyrics_MaxLines()
        base := n * 15 + 12
    }
    grow := AnimFrac("lyrgrow", base, 0.16)
    return Round(grow * p)
}

Lyrics_Toggle() {
    global lyOn, lyState, animVals
    animVals["lyrpanel"] := lyOn ? 1 : 0
    lyOn := !lyOn
    if (lyOn)
        Lyrics_Request()
    if (Ov_Visible())
        Ov_LayoutKeep()
    Media_Redraw()
}

Lyrics_EnsureHelper() {
    global lyHlpB64, lyHlpOk
    if (lyHlpOk && FileExist(Lyrics_HelperPath()))
        return true
    lyHlpOk := DecodeBase64ToFile(lyHlpB64, Lyrics_HelperPath())
    return lyHlpOk
}

Lyrics_Request() {
    global mTitle, mArtist, mDur, lyState, lyKey, lyTok
    global lyTimes, lyTexts
    if (mTitle = "") {
        lyState := "none"
        return
    }
    key := mTitle . "|" . mArtist
    if (key = lyKey && lyState = "ok")
        return
    global lyKind, lyIdx
    lyKey := key
    lyKind := "", lyIdx := 0
    if (!Lyrics_EnsureHelper()) {
        lyState := "none"
        return
    }
    global lyrPrev
    lyTok += 1
    lyTimes := [], lyTexts := []
    lyState := "loading"
    if (lyrPrev != "")
        FileDelete, %lyrPrev%
    FileDelete, % Lyrics_Path()
    FileDelete, % Lyrics_ReqPath()
    lyrPrev := Lyrics_Path()
    req := mTitle . "`n" . mArtist . "`n" . mDur
    FileAppend, %req%, % Lyrics_ReqPath()
    cmd := "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File """ . Lyrics_HelperPath() . """ """ . Lyrics_ReqPath() . """ """ . Lyrics_Path() . """"
    Run, %cmd%, , Hide
    SetTimer, LyricsTick, 400
}

LyricsTick:
    Lyrics_Poll()
return

Lyrics_Poll() {
    global lyState
    if (lyState != "loading") {
        SetTimer, LyricsTick, Off
        return
    }
    if (!FileExist(Lyrics_Path()))
        return
    Lyrics_Read()
    SetTimer, LyricsTick, Off
    Ov_LayoutKeep()
    Media_Redraw()
}

Lyrics_Timed() {
    global lyKind
    return (lyKind = "sync" || lyKind = "est")
}

Lyrics_Read() {
    global lyState, lyKind, lyTimes, lyTexts, mDur
    FileRead, raw, % Lyrics_Path()
    raw := Trim(raw, " `t`r`n")
    lines := StrSplit(raw, "`n", "`r")
    if (lines.MaxIndex() < 1 || SubStr(lines[1], 1, 3) != "ok|") {
        lyState := "none"
        return
    }
    head := StrSplit(lines[1], "|")
    lyKind := (head.MaxIndex() >= 2) ? head[2] : "plain"
    lyTimes := [], lyTexts := []
    Loop, % lines.MaxIndex() - 1 {
        i := A_Index + 1
        f := StrSplit(lines[i], "|", "", 2)
        if (f.MaxIndex() < 2)
            continue
        lyTimes.Push(f[1] + 0)
        lyTexts.Push(f[2])
    }
    n := lyTexts.MaxIndex()
    if (n = "") {
        lyState := "none"
        return
    }
    needTimes := true
    for i, t in lyTimes {
        if (t >= 0) {
            needTimes := false
            break
        }
    }
    if (needTimes) {
        step := (mDur > 20) ? (mDur / n) : 3.5
        Loop, %n%
            lyTimes[A_Index] := (A_Index - 1) * step
        lyKind := "est"
    }
    lyState := "ok"
}

Lyrics_ActiveLine() {
    global lyTimes, lyKind, mPos, mNow
    if (!Lyrics_Timed() || lyTimes.MaxIndex() = "")
        return 0
    pos := (mNow > 0) ? mNow : mPos
    idx := 0
    for i, t in lyTimes {
        if (t >= 0 && t <= pos + 0.12)
            idx := i
        else if (t > pos)
            break
    }
    return idx
}

DrawLyricsPanel(G, x, y, w, h) {
    global lyState, lyTexts, lyKind, lyScrF, lyActF
    global cTx, cTx2, cDim, cFaint, cA1, cA2
    if (lyState = "loading") {
        dots := Mod(A_TickCount // 320, 4)
        lstroketext(G, "looking up the lyrics" . SubStr("...", 1, dots), x, y + 6, w, 16, cDim, 10, "Left")
        return
    }
    if (lyState = "none" || lyState = "") {
        lstroketext(G, "no lyrics found for this one", x, y + 6, w, 16, cDim, 10, "Left")
        return
    }
    n := lyTexts.MaxIndex()
    if (n = "")
        return
    pushclip(G, x, y, w, h)
    rows := h // 15
    sync := Lyrics_Timed()
    scroll := sync ? lyScrF : 1.0
    actF   := sync ? lyActF : 0.0
    i0 := Floor(scroll)
    if (i0 < 1)
        i0 := 1
    yy := y + 5 - (scroll - Floor(scroll)) * 15
    last := i0 + rows + 1
    if (last > n)
        last := n
    i := i0
    while (i <= last) {
        if (i >= 1) {
            clr := cTx2
            if (sync) {
                e := 1 - Abs(i - actF)
                if (e < 0)
                    e := 0
                if (e > 1)
                    e := 1
                clr := mixhex(cDim, cTx, e)
                if (e > 0.2) {
                    acc := mixhex(cA1, "FFFFFFFF", 0.3)
                    clr := mixhex(clr, acc, (e - 0.2) / 0.8)
                }
            }
            lstroketext(G, lyTexts[i], x, yy, w, 15, clr, 10, "Left")
        }
        yy += 15
        i += 1
    }
    popclip(G)
}

Gdip_SetPenEndCap(pPen, cap) {
    DllCall("gdiplus\GdipSetPenStartCap", "UPtr", pPen, "Int", cap)
    DllCall("gdiplus\GdipSetPenEndCap", "UPtr", pPen, "Int", cap)
}
Gdip_SetPenLineJoin(pPen, join) {
    return DllCall("gdiplus\GdipSetPenLineJoin", "UPtr", pPen, "Int", join)
}

DrawMediaGlyph(G, kind, cx, cy, r, clrHex, bgHex := "") {
    clr := HexToARGB(clrHex)
    if (kind = "play") {
        pB := Gdip_BrushCreateSolid(clr)
        ax := cx - r*0.5, ay := cy - r*0.8
        bx := cx + r*0.65, by := cy
        ex := cx - r*0.5, ey := cy + r*0.8
        Gdip_FillPolygon(G, pB, ax . "," . ay . "|" . bx . "," . by . "|" . ex . "," . ey)
        pPen := Gdip_CreatePen(clr, r*0.17)
        Gdip_SetPenEndCap(pPen, 2)
        Gdip_SetPenLineJoin(pPen, 2)
        Gdip_DrawLine(G, pPen, ax, ay, bx, by)
        Gdip_DrawLine(G, pPen, bx, by, ex, ey)
        Gdip_DrawLine(G, pPen, ex, ey, ax, ay)
        Gdip_DeletePen(pPen)
        Gdip_DeleteBrush(pB)
        return
    }
    if (kind = "pause") {
        pB := Gdip_BrushCreateSolid(clr)
        lfillroundrect(G, pB, cx - r*0.74, cy - r*0.92, r*0.64, r*1.84, r*0.12)
        lfillroundrect(G, pB, cx + r*0.1, cy - r*0.92, r*0.64, r*1.84, r*0.12)
        Gdip_DeleteBrush(pB)
        return
    }
    if (kind = "next" || kind = "prev") {
        sgn := (kind = "next") ? 1 : -1
        ox := cx - sgn*r*0.48
        pB := Gdip_BrushCreateSolid(clr)
        ax := ox - sgn*r*0.26, ay := cy - r*0.6
        bx := ox + sgn*r*0.42, by := cy
        ex := ox - sgn*r*0.26, ey := cy + r*0.6
        Gdip_FillPolygon(G, pB, ax . "," . ay . "|" . bx . "," . by . "|" . ex . "," . ey)
        pPen := Gdip_CreatePen(clr, r*0.16)
        Gdip_SetPenEndCap(pPen, 2)
        Gdip_SetPenLineJoin(pPen, 2)
        Gdip_DrawLine(G, pPen, ax, ay, bx, by)
        Gdip_DrawLine(G, pPen, bx, by, ex, ey)
        Gdip_DrawLine(G, pPen, ex, ey, ax, ay)
        Gdip_DeletePen(pPen)
        bw := r * 0.44
        bx2 := (sgn > 0) ? (ox + r*0.78) : (ox - r*0.78 - bw)
        lfillroundrect(G, pB, bx2, cy - r*0.74, bw, r*1.48, bw*0.18)
        Gdip_DeleteBrush(pB)
        return
    }
    if (kind = "pop") {
        pPen := Gdip_CreatePen(clr, 1.5)
        pB := Gdip_BrushCreateSolid(clr)
        sx := r * 0.9
        Gdip_DrawLine(G, pPen, cx + sx*0.15, cy - sx*0.15, cx + sx, cy - sx)
        Gdip_DrawLine(G, pPen, cx + sx*0.38, cy - sx, cx + sx, cy - sx)
        Gdip_DrawLine(G, pPen, cx + sx, cy - sx*0.38, cx + sx, cy - sx)
        Gdip_DrawLine(G, pPen, cx - sx*0.15, cy + sx*0.15, cx - sx, cy + sx)
        Gdip_DrawLine(G, pPen, cx - sx*0.38, cy + sx, cx - sx, cy + sx)
        Gdip_DrawLine(G, pPen, cx - sx, cy + sx*0.38, cx - sx, cy + sx)
        Gdip_FillEllipse(G, pB, cx + sx - 0.95, cy - sx - 0.95, 1.9, 1.9)
        Gdip_FillEllipse(G, pB, cx - sx - 0.95, cy + sx - 0.95, 1.9, 1.9)
        Gdip_DeleteBrush(pB)
        Gdip_DeletePen(pPen)
        return
    }
    if (kind = "dock") {
        pPen := Gdip_CreatePen(clr, 1.5)
        pB := Gdip_BrushCreateSolid(clr)
        sx := r * 0.9
        Gdip_DrawLine(G, pPen, cx + sx*0.85, cy - sx*0.85, cx + sx*0.28, cy - sx*0.28)
        Gdip_DrawLine(G, pPen, cx + sx*0.28, cy - sx*0.58, cx + sx*0.28, cy - sx*0.28)
        Gdip_DrawLine(G, pPen, cx + sx*0.28, cy - sx*0.28, cx + sx*0.58, cy - sx*0.28)
        Gdip_DrawLine(G, pPen, cx - sx*0.85, cy + sx*0.85, cx - sx*0.28, cy + sx*0.28)
        Gdip_DrawLine(G, pPen, cx - sx*0.28, cy + sx*0.58, cx - sx*0.28, cy + sx*0.28)
        Gdip_DrawLine(G, pPen, cx - sx*0.28, cy + sx*0.28, cx - sx*0.58, cy + sx*0.28)
        Gdip_FillEllipse(G, pB, cx + sx*0.28 - 0.95, cy - sx*0.28 - 0.95, 1.9, 1.9)
        Gdip_FillEllipse(G, pB, cx - sx*0.28 - 0.95, cy + sx*0.28 - 0.95, 1.9, 1.9)
        Gdip_DeleteBrush(pB)
        Gdip_DeletePen(pPen)
        return
    }
    if (kind = "mic") {
        Gdip_TranslateWorldTransform(G, cx, cy)
        Gdip_RotateWorldTransform(G, 45)
        pB := Gdip_BrushCreateSolid(clr)
        lfillroundrect(G, pB, -r*0.28, -r*0.66, r*0.56, r*1.26, r*0.28)
        lfillroundrect(G, pB, -r*0.16, r*0.36, r*0.32, r*0.68, r*0.16)
        Gdip_FillEllipse(G, pB, -r*0.52, -r*1.08, r*1.04, r*1.04)
        if (bgHex != "") {
            pClip := Gdip_CreatePath(0)
            Gdip_AddPathEllipse(pClip, -r*0.52, -r*1.08, r*1.04, r*1.04)
            Gdip_SetClipPath(G, pClip, 0)
            pSlash := Gdip_BrushCreateSolid(HexToARGB(bgHex))
            Gdip_FillRectangle(G, pSlash, -r*0.15, -r*1.14, r*0.30, r*1.12)
            Gdip_DeleteBrush(pSlash)
            Gdip_ResetClip(G)
            Gdip_DeletePath(pClip)
        }
        Gdip_DeleteBrush(pB)
        Gdip_RotateWorldTransform(G, -45)
        Gdip_TranslateWorldTransform(G, -cx, -cy)
        return
    }
    if (kind = "close") {
        pPen := Gdip_CreatePen(clr, 1.5)
        pB := Gdip_BrushCreateSolid(clr)
        Gdip_DrawLine(G, pPen, cx - r*0.7, cy - r*0.7, cx + r*0.7, cy + r*0.7)
        Gdip_DrawLine(G, pPen, cx + r*0.7, cy - r*0.7, cx - r*0.7, cy + r*0.7)
        Loop, 4 {
            px := (A_Index = 1 || A_Index = 3) ? (cx - r*0.7) : (cx + r*0.7)
            py := (A_Index <= 2) ? (cy - r*0.7) : (cy + r*0.7)
            Gdip_FillEllipse(G, pB, px - 0.8, py - 0.8, 1.6, 1.6)
        }
        Gdip_DeleteBrush(pB)
        Gdip_DeletePen(pPen)
        return
    }
    pB := Gdip_BrushCreateSolid(clr)
    Gdip_FillEllipse(G, pB, cx - r*0.55, cy - r*0.2, r*0.8, r*0.8)
    Gdip_FillRectangle(G, pB, cx + r*0.15, cy - r*0.85, r*0.22, r*0.85)
    Gdip_DeleteBrush(pB)
}

Media_TimeText(sec) {
    sec := Round(sec)
    if (sec < 0)
        sec := 0
    return Floor(sec / 60) . ":" . SubStr("0" . Mod(sec, 60), -1)
}

DrawMediaBlock(G, x, y, w, h, rects, pfx) {
    global mCover, mTitle, mArtist, mStatus
    global cFld, cPn, cBd, cTx, cTx2, cDim, cBg
    global cFaint, cA2, mousex, mousey
    global lyOn, cTx, cA1
    playing := (mStatus = "Playing")
    ids := ["prev", "play", "next", "lyr", "pop"]
    if (pfx = "media") {
        cov := 74
        if (mCover) {
            pPath := rrect(x, y, cov, cov, 10)
            Gdip_SetClipPath(G, pPath, 1)
            Gdip_DrawImage(G, mCover, x, y, cov, cov)
            Gdip_ResetClip(G)
            pEdge := Gdip_CreatePen(cBg, 2)
            Gdip_DrawPath(G, pEdge, pPath)
            Gdip_DeletePen(pEdge)
        } else {
            pPh := Gdip_BrushCreateSolid(cFld)
            lfillroundrect(G, pPh, x, y, cov, cov, 10)
            Gdip_DeleteBrush(pPh)
            DrawMediaGlyph(G, "note", x + cov/2, y + cov/2, cov*0.26, cFaint)
        }
        tx := x + cov + 12
        tw := w - cov - 12
        title := (mTitle = "") ? "Nothing playing" : mTitle
        lstroketext(G, title, tx, y + 2, tw, 20, cTx, 12, "Left")
        lstroketext(G, mArtist, tx, y + 24, tw, 17, cDim, 10, "Left")
        lstroketext(G, playing ? "Playing" : (mStatus = "" ? "" : mStatus), tx, y + 43, tw, 15, cDim, 9, "Left")
        bw := 26
        bx := x + (w - (bw * ids.MaxIndex() + (ids.MaxIndex() - 1) * 5)) // 2
        by := y + cov + 10
    } else {
        cov := h
        if (mCover) {
            pPath := rrect(x, y, cov, cov, 8)
            Gdip_SetClipPath(G, pPath, 1)
            Gdip_DrawImage(G, mCover, x, y, cov, cov)
            Gdip_ResetClip(G)
            pEdge := Gdip_CreatePen(cBg, 2)
            Gdip_DrawPath(G, pEdge, pPath)
            Gdip_DeletePen(pEdge)
        } else {
            pPh := Gdip_BrushCreateSolid(cFld)
            lfillroundrect(G, pPh, x, y, cov, cov, 8)
            Gdip_DeleteBrush(pPh)
            DrawMediaGlyph(G, "note", x + cov/2, y + cov/2, cov*0.26, cFaint)
        }
        bw := 25
        bx := x + w - (bw * ids.MaxIndex() + (ids.MaxIndex() - 1) * 4 + 6)
        by := y + (h - bw) // 2
    }
    for i, kind in ids {
        rx := bx + (i - 1) * (bw + ((pfx = "media") ? 5 : 4))
        hover := (mousex >= rx && mousex <= rx + bw && mousey >= by && mousey <= by + bw)
        hv := AnimFrac("mediabtn:" . pfx . kind, hover ? 1 : 0, 0.3)
        if (hv > 0.01) {
            pB := Gdip_BrushCreateSolid(ApplyAlpha(cPn, hv))
            Gdip_FillEllipse(G, pB, rx, by, bw, bw)
            Gdip_DeleteBrush(pB)
        }
        pPen := Gdip_CreatePen(MixARGB(cBd, cA2, hv), 1)
        Gdip_DrawEllipse(G, pPen, rx, by, bw, bw)
        Gdip_DeletePen(pPen)
        glyph := kind
        clr := (hv > 0.5) ? cTx : cTx2
        if (kind = "lyr")
            glyph := "mic"
        if (kind = "play")
            glyph := playing ? "pause" : "play"
        else if (kind = "pop" && pfx = "media")
            glyph := "dock"
        else if (kind = "lyr" && lyOn)
            clr := cTx
        DrawMediaGlyph(G, glyph, rx + bw/2, by + bw/2, bw*0.28, clr, mixhex(cBg, cPn, hv))
        rects.Push({x:rx, y:by, w:bw, h:bw, id:pfx . "_" . kind})
    }

    if (pfx = "ov_media")
        rects.Push({x:x, y:y, w:bx - x - 3, h:h, id:"ov_media_pop"})

    if (pfx != "media") {
        tw := bx - x - cov - 18
        if (tw < 40)
            tw := 40
        title := (mTitle = "") ? "Nothing playing" : mTitle
        lstroketext(G, title, x + cov + 9, y + 1, tw, 17, cTx, 11, "Left")
        lstroketext(G, mArtist, x + cov + 9, y + 19, tw, 15, cDim, 9, "Left")
        lstroketext(G, playing ? "Playing" : (mStatus = "" ? "" : mStatus), x + cov + 9, y + 34, tw, 13, cDim, 9, "Left")
    }
}

Media_SetHeight(h) {
    global mediaH, mediahwnd, mediahdc, mediahbm, mediaobm, mediag, mediaW
    if (mediaH = h)
        return
    mediaH := h
    if (!mediahwnd)
        return
    Gui, media:Show, w%mediaW% h%mediaH% NA
    Gdip_DeleteGraphics(mediag)
    selectobject(mediahdc, mediaobm)
    deletedc(mediahdc)
    deleteobject(mediahbm)
    mediahbm := createdibsection(mediaW, mediaH)
    mediahdc := createcompatibledc()
    mediaobm := selectobject(mediahdc, mediahbm)
    mediag   := Gdip_GraphicsFromHDC(mediahdc)
    ApplyThemeGlobals()
    Gdip_SetSmoothingMode(mediag, 4)
    Gdip_SetTextRenderingHint(mediag, 4)
}

Media_EnsureWindow() {
    global mediahwnd, mediag, mediahdc, mediahbm, mediaobm, mediaW, mediaH
    global brandName, mediaWinX, mediaWinY
    if (mediahwnd)
        return
    Gui, media:New, +AlwaysOnTop -Caption +ToolWindow +E0x80000 +LastFound
    Gui, media:Show, x%mediaWinX% y%mediaWinY% w%mediaW% h%mediaH% NA, % brandName . " player"
    mediahwnd := WinExist()
    mediahbm := createdibsection(mediaW, mediaH)
    mediahdc := createcompatibledc()
    mediaobm := selectobject(mediahdc, mediahbm)
    mediag   := Gdip_GraphicsFromHDC(mediahdc)
    ApplyThemeGlobals()
    Gdip_SetSmoothingMode(mediag, 4)
    Gdip_SetTextRenderingHint(mediag, 4)
}

Media_OpenWindow() {
    global mediaWinOpen, mediahwnd, mediaW, mediaH, mediaWinX, mediaWinY, brandName, lyOn
    Media_LoadPos()
    Media_EnsureWindow()
    Media_SetHeight(lyOn ? 178 + Lyrics_Height() + 8 : 178)
    from := {x: mediaWinX - 30, y: mediaWinY + mediaH, w: 120, h: 50}
    if (Ov_Visible())
        Media_RowRect(from)
    mediaWinOpen := true
    Gui, media:Show, x%mediaWinX% y%mediaWinY% w%mediaW% h%mediaH% NA, % brandName . " player"
    Media_Ensure()
    Media_RefreshOverlay()
    Media_AnimTo(from, {x: mediaWinX, y: mediaWinY, w: mediaW, h: mediaH}, true)
    DrawMediaWindow()
}

Media_CloseWindow() {
    global mediaWinOpen, mediahwnd, mediaW, mediaH
    mediaWinOpen := false
    Media_RefreshOverlay()
    Media_MaybeStop()
    if (!mediahwnd)
        return
    from := {x: mediaWinX, y: mediaWinY, w: mediaW, h: mediaH}
    to := {x: mediaWinX - 30, y: mediaWinY + mediaH, w: 120, h: 50}
    if (Ov_Visible())
        Media_RowRect(to)
    Media_AnimTo(from, to, false)
    DrawMediaWindow()
}

Media_RefreshOverlay() {
    if (!Ov_Visible())
        return
    Ov_LayoutKeep()
    DrawOverlay()
}

DrawMediaWindow() {
    global mediag, mediahwnd, mediahdc, mediaW, mediaH, mediaBtnRects
    global mActive, mPos, mDur, ovOpa, lyOn, mNow
    global mousex, mousey, clipStk, mediaScrub, mediaScrubPos
    global animActive, mediaAnimOpen, mediaAnimX, mediaAnimY, mediaAnimW, mediaAnimH, mediaAnimE
    global cTx5, cTx2, cDim, cTx, cTrk, cLn2, cA1
    if (!mediag)
        return
    lyrH := lyOn ? Lyrics_Height() : 0
    Media_SetHeight(lyrH > 0 ? (178 + lyrH + 8) : 178)
    ApplyThemeGlobals()
    StartAnim()
    G := mediag
    Gdip_GraphicsClear(G)
    clipStk := []
    mediaBtnRects := []

    pBg := Gdip_BrushCreateSolid(ApplyAlpha(cBg, 0.97))
    lfillroundrect(G, pBg, 0, 0, mediaW, mediaH, 12)
    Gdip_DeleteBrush(pBg)

    hdrH := 26
    pHead := Gdip_CreateLineBrush(0, hdrH, 0, 0, cBg2, cBg, 1)
    pushclip(G, 0, 0, mediaW, hdrH + 10)
    lfillroundrect(G, pHead, 0, 0, mediaW, hdrH + 10, 10)
    popclip(G)
    Gdip_DeleteBrush(pHead)

    pGrip := Gdip_BrushCreateSolid(cTx5)
    Loop, 4 {
        Gdip_FillEllipse(G, pGrip, mediaW/2 - 15 + (A_Index - 1) * 8, 9, 2.5, 2.5)
        Gdip_FillEllipse(G, pGrip, mediaW/2 - 15 + (A_Index - 1) * 8, 14, 2.5, 2.5)
    }
    Gdip_DeleteBrush(pGrip)

    cx := mediaW - 20, cy := hdrH // 2 + 1
    cHov := (mousex >= cx - 8 && mousex <= cx + 8 && mousey >= cy - 8 && mousey <= cy + 8)
    cv := AnimFrac("mediaclose", cHov ? 1 : 0, 0.3)
    if (cv > 0.01) {
        pCb := Gdip_BrushCreateSolid(ApplyAlpha(cA1, 0.30 * cv))
        Gdip_FillEllipse(G, pCb, cx - 8, cy - 8, 16, 16)
        Gdip_DeleteBrush(pCb)
    }
    DrawMediaGlyph(G, "close", cx, cy, 5, mixhex(cTx5, cTx, cv))
    mediaBtnRects.Push({x:cx - 10, y:cy - 10, w:20, h:20, id:"media_close"})

    if (mActive) {
        DrawMediaBlock(G, 14, 30, mediaW - 28, 112, mediaBtnRects, "media")
        barY := 152
        shownPos := mediaScrub ? mediaScrubPos : ((mNow > 0) ? mNow : mPos)
        pct := (mDur > 0) ? (shownPos / mDur) : 0
        if (pct > 1)
            pct := 1
        if (pct < 0)
            pct := 0
        pTrack := Gdip_BrushCreateSolid(cTrk)
        lfillroundrect(G, pTrack, 12, barY, mediaW - 24, 3, 2)
        Gdip_DeleteBrush(pTrack)
        if (pct > 0.001) {
            pFill := Gdip_BrushCreateSolid(cA1)
            lfillroundrect(G, pFill, 12, barY, Round((mediaW - 24) * pct), 3, 2)
            Gdip_DeleteBrush(pFill)
        }
        overBar := (mousex >= 6 && mousex <= mediaW - 6 && mousey >= barY - 6 && mousey <= barY + 7)
        kv := AnimFrac("mediaknob", (mediaScrub || overBar) ? 1 : 0, 0.28)
        if (kv > 0.01) {
            kr := 2.2 + 2.3 * kv
            pKnob := Gdip_BrushCreateSolid(cA1)
            Gdip_FillEllipse(G, pKnob, 12 + (mediaW - 24) * pct - kr, barY + 1.5 - kr, kr * 2, kr * 2)
            Gdip_DeleteBrush(pKnob)
        }
        lstroketext(G, Media_TimeText(shownPos), 12, barY + 6, 60, 13, cDim, 9, "Left")
        lstroketext(G, Media_TimeText(mDur), 12, barY + 6, mediaW - 24, 13, cDim, 9, "Right")
        if (lyrH > 0)
            DrawLyricsPanel(G, 12, 178, mediaW - 24, lyrH)
        mediaBtnRects.Push({x:14, y:30, w:mediaW - 28, h:78, id:"media_drag"})
        mediaBtnRects.Push({x:6, y:barY - 6, w:mediaW - 12, h:13, id:"media_seek"})
    } else {
        mediaBtnRects.Push({x:12, y:28, w:mediaW - 24, h:mediaH - 36, id:"media_drag"})
        lstroketext(G, "Nothing playing", 0, 46, mediaW, 16, cDim, 9)
        lstroketext(G, "start a track and it shows up here", 0, 64, mediaW, 14, cTx5, 7)
    }

    pOutline := Gdip_CreatePen(cLn2, 1)
    ldrawroundrect(G, pOutline, 0, 0, mediaW - 1, mediaH - 1, 12)
    Gdip_DeletePen(pOutline)

    if (animActive) {
        wX := mediaAnimX, wY := mediaAnimY
        aW := mediaAnimW, aH := mediaAnimH
        if (aW < 1)
            aW := 1
        if (aH < 1)
            aH := 1
    } else {
        WinGetPos, wX, wY,,, ahk_id %mediahwnd%
        aW := mediaW, aH := mediaH
    }
    alpha := Round(255 * ovOpa / 100)
    if (alpha < 40)
        alpha := 40
    if (animActive && mediaAnimOpen)
        alpha := Round(alpha * (0.45 + 0.55 * mediaAnimE))
    updatelayeredwindow(mediahwnd, mediahdc, wX, wY, aW, aH, alpha)
}

Media_HandleClick(x, y) {
    global mediahwnd, mediaDragMode, mediaDragOffX, mediaDragOffY, mediaBtnRects
    global mediaWinX, mediaWinY, mediaScrub
    for i, r in mediaBtnRects {
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h) {
            if (r.id = "media_seek") {
                Media_ScrubTo(x)
                mediaScrub := true
                DllCall("SetCapture", "Ptr", mediahwnd)
                return
            }
            if (r.id = "media_drag") {
                MouseGetPos, msx, msy
                mediaDragMode := "window"
                mediaDragOffX := msx - mediaWinX
                mediaDragOffY := msy - mediaWinY
                DllCall("SetCapture", "Ptr", mediahwnd)
                return
            }
            Media_HandleButton(r.id)
            return
        }
    }
    if (y < 26) {
        MouseGetPos, msx, msy
        mediaDragMode := "window"
        mediaDragOffX := msx - mediaWinX
        mediaDragOffY := msy - mediaWinY
        DllCall("SetCapture", "Ptr", mediahwnd)
    }
}

Media_HandleButton(id) {
    if (id = "media_close" || id = "media_pop") {
        Media_CloseWindow()
        return
    }
    if (id = "media_lyr") {
        Lyrics_Toggle()
        return
    }
    if (id = "media_prev") {
        Media_Command("prev")
    } else if (id = "media_play") {
        Media_Command("toggle")
    } else if (id = "media_next") {
        Media_Command("next")
    }
}

Media_ScrubTo(x) {
    global mediaScrubPos, mDur, mediaW
    pct := (x - 12) / (mediaW - 24)
    if (pct > 1)
        pct := 1
    if (pct < 0)
        pct := 0
    mediaScrubPos := (mDur > 0) ? Round(pct * mDur) : 0
}

Media_HandleMove(x, y) {
    global mediaDragMode, mediaDragOffX, mediaDragOffY, mediaWinX, mediaWinY, mediahwnd
    global mediaScrub
    if (mediaScrub) {
        Media_ScrubTo(x)
        return
    }
    if (mediaDragMode = "")
        return
    MouseGetPos, msx, msy
    mediaWinX := msx - mediaDragOffX
    mediaWinY := msy - mediaDragOffY
    WinMove, ahk_id %mediahwnd%,, %mediaWinX%, %mediaWinY%
}

Media_HandleUp() {
    global mediaDragMode, mediaScrub, mediaScrubPos, seekUntil, mPos, mActive
    if (mediaScrub) {
        DllCall("ReleaseCapture")
        mediaScrub := false
        mPos := mediaScrubPos
        seekUntil := A_TickCount + 1200
        if (mActive)
            Media_Command("seek:" . mediaScrubPos)
        DrawMediaWindow()
        return
    }
    if (mediaDragMode = "")
        return
    DllCall("ReleaseCapture")
    mediaDragMode := ""
    Media_SavePos()
}

Media_SavePos() {
    global iniPath, mediaWinX, mediaWinY
    IniWrite, % mediaWinX . "," . mediaWinY, %iniPath%, Media, pos
}

Media_LoadPos() {
    global iniPath, mediaWinX, mediaWinY, mediaPosSet
    if (mediaPosSet)
        return
    mediaPosSet := true
    IniRead, raw, %iniPath%, Media, pos, %A_Space%
    if (raw = A_Space || raw = "")
        return
    xy := StrSplit(raw, ",")
    if (xy.MaxIndex() >= 2) {
        mediaWinX := xy[1] + 0
        mediaWinY := xy[2] + 0
    }
}

Ov_PrettyKey(k) {
    if (k = "")
        return "none"
    out := ""
    Loop, Parse, k
    {
        c := A_LoopField
        if (c = "+")
            out .= "Shift+"
        else if (c = "^")
            out .= "Ctrl+"
        else if (c = "!")
            out .= "Alt+"
        else if (c = "#")
            out .= "Win+"
        else
            out .= c
    }
    return out
}

