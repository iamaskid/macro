CreateConfig() {
    global configNames, cfgText, cfgIdx, brandName
    name := Trim(cfgText)
    if (name = "") {
        ShowToast(brandName, "Enter a config name first")
        return
    }
    for i, n in configNames {
        if (n = name) {
            cfgIdx := i
            SaveToConfig()
            cfgText := ""
            ShowToast(brandName, "Saved to config: " . name)
            ConsoleLog("Saved settings to config " . name)
            DrawMenu()
            return
        }
    }
    configNames.Push(name)
    SaveConfigList()
    cfgIdx := configNames.MaxIndex()
    SaveToConfig()
    cfgText := ""
    ShowToast(brandName, "Config created: " . name)
    ConsoleLog("Created config " . name)
    DrawMenu()
}

