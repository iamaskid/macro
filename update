RequestMenuRedraw() {
    global lastDraw, redrawPend
    if (!IsMenuVisible())
        return
    now := A_TickCount
    elapsed := now - lastDraw
    if (elapsed >= 16) {
        DrawMenu()
        lastDraw := A_TickCount
    } else if (!redrawPend) {
        redrawPend := true
        SetTimer, MenuRedrawCatchup, % -(16 - elapsed)
    }
}

MenuRedrawCatchup:
    global redrawPend, lastDraw
    redrawPend := false
    DrawMenu()
    lastDraw := A_TickCount
return

drawmenu() {
    global winw, winh, menuhwnd, isdragging, dpiScale, menuhdc, menug, clipStk
    global guiDragging, dragStyle
    Critical, On
    if (isdragging) {
