Check_Learn(idx) {
    global reloadSig, reloadRect, brandName, iniPath, chkSig, chkRect
    if (PauseHeld()) {
        ShowToast(brandName, "Buttons up first - then Learn the " . Check_Name(idx) . " prompt")
        return
    }
    if (IsMenuVisible()) {
        Gui, menu:Hide
        Sleep, 800
    }
    sig := "", dens := 0
    Loop, 8 {
        if (PauseHeld()) {
            ShowToast(brandName, "Learn cancelled - mouse buttons are down")
            return
        }
        ReloadRect_Set()
        dens := Reload_FindBest()
        sig := Reload_Mask()
        if (sig != "" && dens >= 4) {
            Sleep, 220
            if (Reload_Mask() = sig)
                break
        }
        sig := ""
        Sleep, 120
    }
    dens := Reload_Density(sig)
    if (sig = "" || dens < 4) {
        ShowToast(brandName, "No steady " . Check_Name(idx) . " prompt - keep it on screen and try again")
        return
    }
    chkSig[idx] := sig
    chkRect[idx] := reloadRect
    IniWrite, %sig%, %iniPath%, Settings, % "g_chkSig" . idx
    IniWrite, % (reloadRect.x . "|" . reloadRect.y . "|" . reloadRect.w . "|" . reloadRect.h), %iniPath%, Settings, % "g_chkRect" . idx
    if (idx = 1) {
        reloadSig := sig
        IniWrite, %sig%, %iniPath%, Settings, g_reloadSig5
        IniWrite, % (reloadRect.x . "|" . reloadRect.y . "|" . reloadRect.w . "|" . reloadRect.h), %iniPath%, Settings, g_reloadRect2
    }
    Reload_Apply()
    ShowToast(brandName, Check_Name(idx) . " check saved (" . dens . " cells)")
}

