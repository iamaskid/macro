rrect(x, y, w, h, r) {
    global rrMap, rrN
    if (!IsObject(rrMap)) {
        rrMap := {}
        rrN := 0
    }
    key := x . "," . y . "," . w . "," . h . "," . r
    if (rrMap.HasKey(key))
        return rrMap[key]
    rr := (r > w // 2) ? w // 2 : r
    rr := (rr > h // 2) ? h // 2 : rr
    d  := rr * 2
    p  := Gdip_CreatePath(0)
    if (rr <= 0) {
        Gdip_AddPathRectangle(p, x, y, w, h)
    } else {
        Gdip_AddPathArc(p, x + w - d, y, d, d, 270, 90)
        Gdip_AddPathArc(p, x + w - d, y + h - d, d, d, 0, 90)
        Gdip_AddPathArc(p, x, y + h - d, d, d, 90, 90)
        Gdip_AddPathArc(p, x, y, d, d, 180, 90)
        Gdip_ClosePathFigure(p)
    }
    if (rrN >= 96) {
        for k, pp in rrMap
            Gdip_DeletePath(pp)
        rrMap := {}
        rrN := 0
    }
    rrMap[key] := p
    rrN += 1
    return p
}

lfillroundrect(G, pBrush, x, y, w, h, r) {
    Gdip_FillPath(G, pBrush, rrect(x, y, w, h, r))
}

pushclip(G, x, y, w, h) {
    global clipStk
    if (clipStk.MaxIndex()) {
        p := clipStk[clipStk.MaxIndex()]
        ix := (x > p.x) ? x : p.x
        iy := (y > p.y) ? y : p.y
        rx := (x+w < p.x+p.w) ? x+w : p.x+p.w
        ry := (y+h < p.y+p.h) ? y+h : p.y+p.h
        iw := rx - ix
        ih := ry - iy
        iw := (iw < 0) ? 0 : iw
        ih := (ih < 0) ? 0 : ih
        x := ix, y := iy, w := iw, h := ih
    }
    clipStk.Push({x:x, y:y, w:w, h:h})
    Gdip_SetClipRect(G, x, y, w, h, 0)
}

outclip(x, y, w, h) {
    global clipStk
    n := clipStk.MaxIndex()
    if (!n)
        return false
    c := clipStk[n]
    return (x + w < c.x || x > c.x + c.w || y + h < c.y || y > c.y + c.h)
}

popclip(G) {
    global clipStk
    if (clipStk.MaxIndex())
        clipStk.RemoveAt(clipStk.MaxIndex())
    if (clipStk.MaxIndex()) {
        c := clipStk[clipStk.MaxIndex()]
        Gdip_SetClipRect(G, c.x, c.y, c.w, c.h, 0)
    } else {
        Gdip_ResetClip(G)
    }
}

ldrawroundrect(G, pPen, x, y, w, h, r) {
    Gdip_DrawPath(G, pPen, rrect(x, y, w, h, r))
}

DrawBackdropImage(G, W, H, bgFade) {
    global bgBmp, bgFrom, cBg
    try {
        PushClip(G, 0, 0, W, H)
        Gdip_DrawImage(G, bgBmp, 0, 0, W, H)
        pOverlay := Gdip_BrushCreateSolid(ApplyAlpha(cScrim, bgFade))
        lfillroundrect(G, pOverlay, 0, 0, W, H, 10)
        Gdip_DeleteBrush(pOverlay)
        PopClip(G)
    } catch e {
        popclip(G)
        err := IsObject(e) ? e.Message : e
        try
            Gdip_DisposeImage(bgBmp)
        bgBmp := 0
        bgFrom := ""
        ConsoleLog("background image dropped: " . err)
    }
}

lstroketext(G, txt, x, y, w, h, colorHex, size, align="Center", valign="vCenter", font="Segoe UI", sizeFixed=false) {
    global cOutline, lite
    if (outclip(x, y, w, h))
        return
    if (!RegExMatch(colorHex, "^[0-9A-Fa-f]{8}$"))
        colorHex := (colorHex > 0 && colorHex <= 0xFFFFFFFF) ? ARGBToHex(colorHex) : cTx
    if (((HexToARGB(colorHex) >> 24) & 0xFF) = 0)
        return

    x := Round(x), y := Round(y), w := Round(w), h := Round(h)

    size := (!sizeFixed) ? FitTextSize(txt, w, size) : size

    if (valign = "vCenter") {
        hFam  := TextFontFamily(font)
        hFont := hFam ? TextFont(hFam, size, 1) : 0
        if (hFam && hFont) {
            alignIdx := (align = "Left" || align = "Near") ? 0 : (align = "Right" || align = "Far") ? 2 : 1
            hFmt := TextFormat(0x4000, alignIdx)
            if (hFmt) {
                Gdip_SetTextRenderingHint(G, 4)
                pw := (w > 40) ? w : 40
                th := Round(TextHeight(G, "Ag", hFont, hFmt, x, y, pw, h))
                ty := y + (h - th) // 2
                pFill := Gdip_BrushCreateSolid("0x" . colorHex)
                if (cOutline && !lite) {
                    pStroke := Gdip_BrushCreateSolid("0x" . SubStr(colorHex, 1, 2) . "000000")
                    Loop, 4 {
                        ox := (A_Index = 1) ? -1 : (A_Index = 2) ? 1 : 0
                        oy := (A_Index = 3) ? -1 : (A_Index = 4) ? 1 : 0
                        CreateRectF(RC, x + ox, ty + oy, w, th)
                        Gdip_DrawString(G, txt, hFont, hFmt, pStroke, RC)
                    }
                    Gdip_DeleteBrush(pStroke)
                }
                CreateRectF(RC, x, ty, w, th)
                Gdip_DrawString(G, txt, hFont, hFmt, pFill, RC)
                Gdip_DeleteBrush(pFill)
                return
            }
        }
    }

    opt     := " w" w " h" h " s" size " Bold " align " " valign
    aHex    := SubStr(colorHex,1,2)
    strokeC := aHex . "000000"
    if (cOutline && !lite) {
        offsets := [[-1,0],[1,0],[0,-1],[0,1]]
        For i, off in offsets
            Gdip_TextToGraphics(G, txt, "x" (x+off[1]) " y" (y+off[2]) opt " c" strokeC " font" font, font)
    }
    Gdip_TextToGraphics(G, txt, "x" x " y" y opt " c" colorHex " font" font, font)
}

TextFontFamily(name) {
    static cache := {}
    if (!cache.HasKey(name)) {
        h := Gdip_FontFamilyCreate(name)
        h := (!h) ? Gdip_FontFamilyCreate("Arial") : h
        cache[name] := h
    }
    return cache[name]
}

TextFont(hFam, size, style) {
    static cache := {}
    key := hFam . ":" . size . ":" . style
    if (!cache.HasKey(key))
        cache[key] := Gdip_FontCreate(hFam, size, style)
    return cache[key]
}

TextFormat(fmtStyle, alignIdx=1) {
    static cache := {}
    key := fmtStyle . ":" . alignIdx
    if (!cache.HasKey(key)) {
        h := Gdip_StringFormatCreate(fmtStyle)
        if (h)
            Gdip_SetStringFormatAlign(h, alignIdx)
        cache[key] := h
    }
    return cache[key]
}

TextHeight(G, txt, hFont, hFmt, x, y, w, h) {
    static cache := {}, n := 0
    key := hFont . "|" . hFmt . "|" . txt . "|" . Round(w) . "|" . Round(h)
    if (cache.HasKey(key))
        return cache[key]
    CreateRectF(RC, x, y, w, h)
    th := StrSplit(Gdip_MeasureString(G, txt, hFont, hFmt, RC), "|")[4] + 0
    if (n >= 400) {
        cache := {}
        n := 0
    }
    cache[key] := th, n += 1
    return th
}

RunWidth(G, txt, size, font="Segoe UI") {
    if (txt = "")
        return 0
    hFam := TextFontFamily(font)
    hFont := hFam ? TextFont(hFam, size, 1) : 0
    hFmt := TextFormat(0x4000, 0)
    if (!(hFont && hFmt))
        return 0
    return txtw(G, txt, hFont, hFmt, 0, 0, 4000, size + 12)
}

FieldState(key) {
    static states := {}
    if (!states.HasKey(key))
        states[key] := {c: 1, a: 0, seen: ""}
    return states[key]
}

FieldCaret(txt, st) {
    len := StrLen(txt)
    if (st.seen != txt) {
        st.seen := txt
        st.c := len + 1
        st.a := 0
    }
    if (st.c < 1)
        st.c := 1
    if (st.c > len + 1)
        st.c := len + 1
    if (st.a < 1 || st.a > len + 1)
        st.a := 0
    return st.c
}

FieldSet(st, txt, c, a) {
    st.seen := txt
    st.c := c
    st.a := a
}

FieldSelection(st) {
    if (st.a && st.a != st.c)
        return {s: (st.a < st.c) ? st.a : st.c, e: (st.a < st.c) ? st.c : st.a}
    return 0
}

FieldWordChar(c) {
    return (c != "" && InStr("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", c) > 0)
}

FieldWordOffset(txt, pos, dir) {
    last := StrLen(txt) + 1
    p := pos
    if (dir < 0) {
        if (p <= 1)
            return 1
        p -= 1
        while (p > 1 && !FieldWordChar(SubStr(txt, p, 1)))
            p -= 1
        while (p > 1 && FieldWordChar(SubStr(txt, p-1, 1)))
            p -= 1
        return p
    }
    if (p >= last)
        return last
    while (p < last && !FieldWordChar(SubStr(txt, p, 1)))
        p += 1
    while (p < last && FieldWordChar(SubStr(txt, p, 1)))
        p += 1
    return p
}

FieldKey(ByRef txt, key, vk, shift, ctrl, maxLen := 0) {
    st := FieldState(key)
    c := FieldCaret(txt, st)
    a := st.a
    len := StrLen(txt)
    sel := FieldSelection(st)
    VK_BACK := 8, VK_DELETE := 46, VK_LEFT := 37, VK_RIGHT := 39
    VK_HOME := 36, VK_END := 35

    if (vk = VK_LEFT || vk = VK_RIGHT) {
        dir := (vk = VK_LEFT) ? -1 : 1
        if (!shift && sel) {
            FieldSet(st, txt, (dir < 0) ? sel.s : sel.e, 0)
            return false
        }
        p := ctrl ? FieldWordOffset(txt, c, dir) : (c + dir < 1) ? 1 : (c + dir > StrLen(txt) + 1) ? StrLen(txt) + 1 : c + dir
        FieldSet(st, txt, p, shift ? (a ? a : c) : 0)
        return false
    }
    if (vk = VK_HOME || vk = VK_END) {
        FieldSet(st, txt, (vk = VK_HOME) ? 1 : len + 1, shift ? (a ? a : c) : 0)
        return false
    }
    if (vk = VK_DELETE) {
        if (sel) {
            txt := SubStr(txt, 1, sel.s-1) . SubStr(txt, sel.e)
            FieldSet(st, txt, sel.s, 0)
            return true
        }
        if (c > len)
            return false
        txt := SubStr(txt, 1, c-1) . SubStr(txt, c+1)
        FieldSet(st, txt, c, 0)
        return true
    }
    if (vk = VK_BACK) {
        if (sel) {
            txt := SubStr(txt, 1, sel.s-1) . SubStr(txt, sel.e)
            FieldSet(st, txt, sel.s, 0)
            return true
        }
        if (c <= 1)
            return false
        txt := SubStr(txt, 1, c-2) . SubStr(txt, c)
        FieldSet(st, txt, c-1, 0)
        return true
    }
    if (!ctrl)
        return false
    if (vk = 65) {
        FieldSet(st, txt, len + 1, 1)
        return false
    }
    if (vk = 67) {
        Clipboard := sel ? SubStr(txt, sel.s, sel.e - sel.s) : txt
        return false
    }
    if (vk = 88) {
        if (sel) {
            Clipboard := SubStr(txt, sel.s, sel.e - sel.s)
            txt := SubStr(txt, 1, sel.s-1) . SubStr(txt, sel.e)
            FieldSet(st, txt, sel.s, 0)
            return true
        }
        Clipboard := txt
        txt := ""
        FieldSet(st, txt, 1, 0)
        return true
    }
    if (vk = 86)
        return FieldPaste(txt, key, maxLen)
    return false
}

FieldPaste(ByRef txt, key, maxLen := 0) {
    st := FieldState(key)
    c := FieldCaret(txt, st)
    sel := FieldSelection(st)
    ins := RegExReplace(Clipboard, "[\r\n]+", " ")
    if (sel) {
        txt := SubStr(txt, 1, sel.s-1) . SubStr(txt, sel.e)
        c := sel.s
        if (ins = "") {
            FieldSet(st, txt, c, 0)
            return true
        }
    }
    if (ins = "")
        return false
    ins := (maxLen && StrLen(txt) + StrLen(ins) > maxLen) ? SubStr(ins, 1, maxLen - StrLen(txt)) : ins
    if (ins = "")
        return false
    txt := SubStr(txt, 1, c-1) . ins . SubStr(txt, c)
    FieldSet(st, txt, c + StrLen(ins), 0)
    return true
}

FieldChar(ByRef txt, key, ch, maxLen := 0) {
    st := FieldState(key)
    c := FieldCaret(txt, st)
    sel := FieldSelection(st)
    if (sel) {
        txt := SubStr(txt, 1, sel.s-1) . SubStr(txt, sel.e)
        c := sel.s
    }
    if (maxLen && StrLen(txt) >= maxLen)
        return false
    txt := SubStr(txt, 1, c-1) . ch . SubStr(txt, c)
    FieldSet(st, txt, c + 1, 0)
    return true
}

txtw(G, txt, hFont, hFmt, x, y, w, h) {
    if (txt = "")
        return 0
    CreateRectF(RC, x, y, w, h)
    return StrSplit(Gdip_MeasureString(G, txt, hFont, hFmt, RC), "|")[3] + 0
}

DrawFieldText(G, txt, key, focused, x, y, w, h, colorHex, size, family="Segoe UI", align="Left") {
    global cA1
    st := FieldState(key)
    c := FieldCaret(txt, st)
    if (!focused) {
        if (txt != "")
            lstroketext(G, txt, x, y, w, h, colorHex, size, align)
        return
    }
    sz := FitTextSize(txt, w, size)
    hFam := TextFontFamily(family)
    hFont := hFam ? TextFont(hFam, sz, 0) : 0
    hFmt := TextFormat(0x4000, (align = "Left" || align = "Near") ? 0 : (align = "Right" || align = "Far") ? 2 : 1)
    if (!(hFont && hFmt)) {
        lstroketext(G, txt . "|", x, y, w, h, colorHex, size, align)
        return
    }
    th := Round(TextHeight(G, "Ag", hFont, hFmt, x, y, w, h))
    th := (th < 2) ? size + 4 : th
    ty := y + (h - th)//2
    sel := FieldSelection(st)
    if (sel) {
        px := txtw(G, SubStr(txt, 1, sel.s-1), hFont, hFmt, x, y, 4000, h)
        sw := txtw(G, SubStr(txt, sel.s, sel.e - sel.s), hFont, hFmt, x, y, 4000, h)
        if (sw > 1) {
            pSel := Gdip_BrushCreateSolid(ApplyAlpha(cA1, 0.35))
            lfillroundrect(G, pSel, Round(x + px), ty, Round(sw), th, 2)
            Gdip_DeleteBrush(pSel)
        }
    }
    if (txt != "")
        lstroketext(G, txt, x, y, w, h, colorHex, size, align)
    cx := txtw(G, SubStr(txt, 1, c-1), hFont, hFmt, x, y, 4000, h)
    pCur := Gdip_BrushCreateSolid(RegExMatch(colorHex, "^[0-9A-Fa-f]{8}$") ? "0x" . colorHex : "0xFFE8E8F2")
    Gdip_FillRectangle(G, pCur, Round(x + cx), ty, 1, th)
    Gdip_DeleteBrush(pCur)
}

TextScale() {
    global uiScale
    uiScale := (uiScale <= 0) ? 1.0 : uiScale
    return uiScale
}

FitTextSize(txt, w, size) {
    size := Round(size * TextScale())
    if (txt = "" || w <= 0)
        return size
    avail := w - 4
    if (avail <= 0)
        return size
    minSize := 8
    Loop {
        if (StrLen(txt) * size * 0.60 <= avail || size <= minSize)
            break
        size--
    }
    return size
}

DrawOutputText(G, txt, x, y, w, h, colorHex, errColorHex, size) {
    if (w <= 0 || h <= 0)
        return
    lineH := size + 6
    pushclip(G, x, y, w, h)
    lines := StrSplit(txt, "`n")
    maxLines := h // lineH
    maxLines := (maxLines < 1) ? 1 : maxLines
    startIdx := lines.MaxIndex() - maxLines + 1
    startIdx := (startIdx < 1) ? 1 : startIdx
    lineY := y
    Loop, % lines.MaxIndex() {
        if (A_Index < startIdx)
            continue
        ln := lines[A_Index]
        isErr := (SubStr(Trim(ln), 1, 1) = "!") || InStr(ln, "Error") || InStr(ln, "Unrecognized")
        lstroketext(G, ln, x, lineY, w, lineH, isErr ? errColorHex : colorHex, size, "Left", "vCenter")
        lineY += lineH
    }
    popclip(G)
}

DrawCodeText(G, txt, x, y, w, h, colorHex, size, align="Left") {
    if (!RegExMatch(colorHex, "^[0-9A-Fa-f]{8}$")) {
        opt := "x" x " y" y " w" w " h" h " s" size " " align " vCenter c" colorHex
        Gdip_TextToGraphics(G, txt, opt, "Consolas")
        return
    }
    hFam := TextFontFamily("Consolas")
    hFont := hFam ? TextFont(hFam, size, 0) : 0
    hFmt := TextFormat(0x4000, (align = "Left" || align = "Near") ? 0 : (align = "Right" || align = "Far") ? 2 : 1)
    pBrush := CodeTextBrush(colorHex)
    if (!(hFont && hFmt && pBrush)) {
        opt := "x" x " y" y " w" w " h" h " s" size " " align " vCenter c" colorHex
        Gdip_TextToGraphics(G, txt, opt, "Consolas")
        return
    }
    Gdip_SetTextRenderingHint(G, 4)
    th := Round(TextHeight(G, txt, hFont, hFmt, x, y, w, h))
    CreateRectF(RC, x, y + (h - th)//2, w, th)
    Gdip_DrawString(G, txt, hFont, hFmt, pBrush, RC)
}

CodeTextBrush(colorHex) {
    static cache := {}, n := 0
    if (cache.HasKey(colorHex))
        return cache[colorHex]
    if (n > 96) {
        for k, b in cache
            Gdip_DeleteBrush(b)
        cache := {}
        n := 0
    }
    b := Gdip_BrushCreateSolid("0x" . colorHex)
    cache[colorHex] := b
    n += 1
    return b
}

CodeLineTokens(line) {
    static cache := {}, n := 0
    if (cache.HasKey(line))
        return cache[line]
    toks := []
    pos := 1, len := StrLen(line)
    while (pos <= len) {
        rest := SubStr(line, pos)
        if (SubStr(rest, 1, 2) = "--") {
            toks.Push([rest, "comment"])
            break
        } else if (RegExMatch(rest, "^""[^""]*""?", tok)) {
            toks.Push([tok, "string"])
        } else if (RegExMatch(rest, "^\d+", tok)) {
            toks.Push([tok, "number"])
        } else if (RegExMatch(rest, "^[A-Za-z_][A-Za-z0-9_]*", tok)) {
            toks.Push([tok, "ident"])
        } else {
            tok := SubStr(rest, 1, 1)
            toks.Push([tok, "plain"])
        }
        pos += StrLen(tok)
    }
    if (n > 400) {
        cache := {}
        n := 0
    }
    cache[line] := toks
    n += 1
    return toks
}

GetMonoCharWidth(G, size) {
    static cache := {}
    if (cache.HasKey(size))
        return cache[size]
    sample := "MMMMMMMMMMMMMMMMMMMM"
    rc := Gdip_TextToGraphics(G, sample, "x0 y0 w4000 h200 s" size " Left cFFFFFFFF", "Consolas",,,1)
    parts := StrSplit(rc, "|")
    w := (parts.MaxIndex() >= 3) ? parts[3] / StrLen(sample) : size * 0.6
    cache[size] := w
    return w
}

CodeLineColToPos(codeText, lineIdx, col) {
    lines := StrSplit(codeText, "`n")
    lineIdx := (lineIdx < 1) ? 1 : lineIdx
    lineIdx := (lineIdx > lines.MaxIndex()) ? lines.MaxIndex() : lineIdx
    pos := 1
    Loop, % lineIdx - 1
        pos += StrLen(lines[A_Index]) + 1
    lineLen := StrLen(lines[lineIdx])
    col := (col < 0) ? 0 : col
    col := (col > lineLen) ? lineLen : col
    return pos + col
}

CodeKeywordList() {
    return ["PressKey","ReleaseKey","Sleep","Print","MoveMouseTo","MoveMouseRelative"
        ,"local","function","end","if","then","else","elseif"
        ,"for","while","do","return","true","false","nil"
        ,"and","or","not","break","repeat","until"]
}

PushCodeUndo(kind="") {
    global codeUndoStack, codeRedoStack, codeText, codeCursorPos, undoKind, undoTick
    now := A_TickCount
    if (kind = "" || kind != undoKind || now - undoTick > 900)
        codeUndoStack.Push({t:codeText, p:codeCursorPos})
    undoKind := kind, undoTick := now
    codeRedoStack := []
    if (codeUndoStack.MaxIndex() > 200)
        codeUndoStack.RemoveAt(1)
}

CodeUndo() {
    global codeUndoStack, codeRedoStack, codeText, codeCursorPos, codeSelAnchor, undoKind
    if (!codeUndoStack.MaxIndex())
        return
    codeRedoStack.Push({t:codeText, p:codeCursorPos})
    idx := codeUndoStack.MaxIndex()
    last := codeUndoStack[idx]
    codeUndoStack.RemoveAt(idx)
    codeText := last.t
    codeCursorPos := last.p
    codeSelAnchor := 0
    undoKind := ""
}

CodeRedo() {
    global codeUndoStack, codeRedoStack, codeText, codeCursorPos, codeSelAnchor, undoKind
    if (!codeRedoStack.MaxIndex())
        return
    codeUndoStack.Push({t:codeText, p:codeCursorPos})
    idx := codeRedoStack.MaxIndex()
    nxt := codeRedoStack[idx]
    codeRedoStack.RemoveAt(idx)
    codeText := nxt.t
    codeCursorPos := nxt.p
    codeSelAnchor := 0
    undoKind := ""
}

UpdateCodeAutocomplete() {
    global codeText, codeCursorPos, acList, acSel, acStart
    acList := []
    acSel := 1
    start := codeCursorPos
    while (start > 1 && RegExMatch(SubStr(codeText, start-1, 1), "[A-Za-z0-9_]"))
        start -= 1
    word := SubStr(codeText, start, codeCursorPos-start)
    acStart := start
    if (StrLen(word) < 1)
        return
    for i, kw in CodeKeywordList() {
        if (SubStr(kw, 1, StrLen(word)) = word && kw != word)
            acList.Push(kw)
        if (acList.MaxIndex() >= 6)
            break
    }
}

AcceptCodeAutocomplete() {
    global codeText, codeCursorPos, acList, acSel, acStart
    if (!acList.MaxIndex())
        return false
    chosen := acList[acSel]
    codeText := SubStr(codeText, 1, acStart-1) . chosen . SubStr(codeText, codeCursorPos)
    codeCursorPos := acStart + StrLen(chosen)
    acList := []
    return true
}

CodePosToLineCol(codeText, pos) {
    lines := StrSplit(codeText, "`n")
    remaining := pos - 1
    lineIdx := 1, col := 0
    for i, l in lines {
        llen := StrLen(l)
        if (remaining <= llen) {
            lineIdx := i, col := remaining
            break
        }
        remaining -= (llen + 1)
        lineIdx := i+1, col := 0
    }
    return {line:lineIdx, col:col}
}

FindMatchingBracket(codeText, pos) {
    pairs := {"(":")", "[":"]"}
    rpairs := {")":"(", "]":"["}
    before := SubStr(codeText, pos-1, 1)
    after := SubStr(codeText, pos, 1)
    if (pairs.HasKey(after)) {
        openCh := after, closeCh := pairs[after], dir := 1, searchFrom := pos+1
    } else if (rpairs.HasKey(before)) {
        closeCh := before, openCh := rpairs[before], dir := -1, searchFrom := pos-2
    } else {
        return 0
    }
    depth := 1
    i := searchFrom
    n := StrLen(codeText)
    while (i >= 1 && i <= n) {
        c := SubStr(codeText, i, 1)
        if (c = openCh)
            depth += (dir = 1) ? 1 : -1
        else if (c = closeCh)
            depth += (dir = 1) ? -1 : 1
        if (depth = 0)
            return i
        i += dir
    }
    return 0
}

HasCodeSelection() {
    global codeSelAnchor, codeCursorPos
    return codeSelAnchor && codeSelAnchor != codeCursorPos
}

CodeSelRange() {
    global codeSelAnchor, codeCursorPos
    a := codeSelAnchor, b := codeCursorPos
    return (a < b) ? {s:a, e:b} : {s:b, e:a}
}

DeleteCodeSelection() {
    global codeText, codeCursorPos, codeSelAnchor
    r := CodeSelRange()
    codeText := SubStr(codeText, 1, r.s-1) . SubStr(codeText, r.e)
    codeCursorPos := r.s
    codeSelAnchor := 0
}

CodeLineHeight() {
    return 17
}

CodeLineStart(pos) {
    global codeText
    return pos - CodePosToLineCol(codeText, pos).col
}

CodeLineEnd(pos) {
    global codeText
    lc := CodePosToLineCol(codeText, pos)
    return CodeLineStart(pos) + StrLen(StrSplit(codeText, "`n")[lc.line])
}

CodeSmartHome() {
    global codeText, codeCursorPos
    s := CodeLineStart(codeCursorPos)
    indent := 0
    indent := (RegExMatch(SubStr(codeText, s, CodeLineEnd(codeCursorPos) - s), "^[ `t]+", m)) ? StrLen(m) : indent
    return (codeCursorPos > s + indent) ? s + indent : s
}

IsCodeSpace(c) {
    return (c = " " || c = "`t" || c = "`n" || c = "`r")
}

CodeWordOffset(pos, dir) {
    global codeText
    n := StrLen(codeText)
    p := pos
    if (dir < 0) {
        while (p > 1 && IsCodeSpace(SubStr(codeText, p-1, 1)))
            p -= 1
        if (p > 1) {
            cls := IsCodeWord(SubStr(codeText, p-1, 1))
            while (p > 1 && !IsCodeSpace(SubStr(codeText, p-1, 1)) && IsCodeWord(SubStr(codeText, p-1, 1)) = cls)
                p -= 1
        }
    } else {
        while (p <= n && IsCodeSpace(SubStr(codeText, p, 1)))
            p += 1
        if (p <= n) {
            cls := IsCodeWord(SubStr(codeText, p, 1))
            while (p <= n && !IsCodeSpace(SubStr(codeText, p, 1)) && IsCodeWord(SubStr(codeText, p, 1)) = cls)
                p += 1
        }
    }
    return p
}

IsCodeWord(c) {
    return RegExMatch(c, "^[A-Za-z0-9_]$") ? 1 : 0
}

CodeCollapse(dir) {
    global codeSelAnchor, codeCursorPos
    if (!HasCodeSelection())
        return false
    r := CodeSelRange()
    codeCursorPos := (dir < 0) ? r.s : r.e
    codeSelAnchor := 0
    return true
}

CodeMoveCaret(to, shift) {
    global codeSelAnchor, codeCursorPos, codeCol
    if (shift) {
        codeSelAnchor := (!codeSelAnchor) ? codeCursorPos : codeSelAnchor
    } else {
        codeSelAnchor := 0
    }
    codeCursorPos := to
    codeCol := 0
}

CodeMoveVerticalKeepCol(dir) {
    global codeText, codeCursorPos, codeCol
    lines := StrSplit(codeText, "`n")
    lc := CodePosToLineCol(codeText, codeCursorPos)
    codeCol := (!codeCol) ? lc.col : codeCol
    tgt := lc.line + dir
    tgt := (tgt < 1) ? 1 : tgt
    tgt := (tgt > lines.MaxIndex()) ? lines.MaxIndex() : tgt
    col := codeCol
    col := (col > StrLen(lines[tgt])) ? StrLen(lines[tgt]) : col
    codeCursorPos := CodeLineColToPos(codeText, tgt, col)
}

CodeInsert(text, kind) {
    global codeText, codeCursorPos, codeSelAnchor, codeCol, codeEdit
    PushCodeUndo(kind)
    if (HasCodeSelection())
        DeleteCodeSelection()
    codeText := SubStr(codeText, 1, codeCursorPos-1) . text . SubStr(codeText, codeCursorPos)
    codeCursorPos += StrLen(text)
    codeSelAnchor := 0
    codeCol := 0
    codeEdit := true
}

CodeDeleteBackward() {
    global codeText, codeCursorPos, codeSelAnchor, codeCol, codeEdit
    if (HasCodeSelection()) {
        PushCodeUndo("back")
        DeleteCodeSelection()
        codeEdit := true
        return true
    }
    if (codeCursorPos <= 1)
        return false
    lc := CodePosToLineCol(codeText, codeCursorPos)
    n := 1
    if (lc.col > 0 && RegExMatch(SubStr(codeText, codeCursorPos - lc.col, lc.col), "^ +$")) {
        n := Mod(lc.col, 4)
        n := (n = 0) ? 4 : n
    }
    PushCodeUndo("back")
    codeText := SubStr(codeText, 1, codeCursorPos-1-n) . SubStr(codeText, codeCursorPos)
    codeCursorPos -= n
    codeSelAnchor := 0
    codeCol := 0
    codeEdit := true
    return true
}

CodeDeleteForward() {
    global codeText, codeCursorPos, codeSelAnchor, codeEdit
    if (HasCodeSelection()) {
        PushCodeUndo("del")
        DeleteCodeSelection()
        codeEdit := true
        return true
    }
    if (codeCursorPos > StrLen(codeText))
        return false
    PushCodeUndo("del")
    codeText := SubStr(codeText, 1, codeCursorPos-1) . SubStr(codeText, codeCursorPos+1)
    codeSelAnchor := 0
    codeEdit := true
    return true
}

CodeIndentPayload() {
    global codeText, codeCursorPos
    lc := CodePosToLineCol(codeText, codeCursorPos)
    lead := ""
    lead := (RegExMatch(StrSplit(codeText, "`n")[lc.line], "^[ `t]*", m)) ? m : lead
    before := SubStr(codeText, codeCursorPos-1, 1)
    if (before = "{" || before = "(" || before = "[")
        lead .= "    "
    return "`n" . lead
}

CodeIndentLines(outdent) {
    global codeText, codeCursorPos, codeSelAnchor, codeEdit
    hadSel := HasCodeSelection()
    if (hadSel) {
        r := CodeSelRange()
        from := CodeLineStart(r.s), to := CodeLineEnd(r.e)
    } else {
        from := CodeLineStart(codeCursorPos), to := CodeLineEnd(codeCursorPos)
    }
    block := SubStr(codeText, from, to - from + 1)
    newBlock := ""
    if (block = "") {
        newBlock := outdent ? "" : "    "
    } else {
        lines := StrSplit(block, "`n")
        Loop, % lines.MaxIndex() {
            l := lines[A_Index]
            if (outdent)
                l := RegExReplace(l, "^ {1,4}", "")
            else if (l != "")
                l := "    " . l
            newBlock .= (A_Index > 1 ? "`n" : "") . l
        }
    }
    if (newBlock = block)
        return
    PushCodeUndo(outdent ? "outdent" : "indent")
    codeText := SubStr(codeText, 1, from-1) . newBlock . SubStr(codeText, to+1)
    if (hadSel) {
        codeSelAnchor := from
        codeCursorPos := from + StrLen(newBlock)
    } else {
        codeCursorPos += StrLen(newBlock) - StrLen(block)
    }
    codeEdit := true
}

CodeEditChar(ch) {
    global codeText, codeCursorPos, codeSelAnchor, acList
    if (ch = "(" || ch = "[" || ch = "{") {
        closer := (ch = "(") ? ")" : (ch = "[") ? "]" : "}"
        if (HasCodeSelection()) {
            r := CodeSelRange()
            PushCodeUndo("wrap")
            codeText := SubStr(codeText, 1, r.s-1) . ch . SubStr(codeText, r.s, r.e-r.s) . closer . SubStr(codeText, r.e)
            codeSelAnchor := r.s + 1
            codeCursorPos := r.e + 1
            acList := []
            return
        }
        CodeInsert(ch . closer, "type")
        codeCursorPos -= 1
        acList := []
        return
    }
    if (ch = ")" || ch = "]" || ch = "}") {
        if (!HasCodeSelection() && SubStr(codeText, codeCursorPos, 1) = ch) {
            codeCursorPos += 1
            acList := []
            return
        }
        CodeInsert(ch, "type")
        return
    }
    CodeInsert(ch, "type")
}

CodeEditKey(vk, shift, ctrl) {
    global codeText, codeCursorPos, codeSelAnchor, codeScrollY, codeEdit
    VK_LEFT := 37, VK_UP := 38, VK_RIGHT := 39, VK_DOWN := 40
    VK_HOME := 36, VK_END := 35, VK_PGUP := 33, VK_PGDN := 34
    VK_BACK := 8, VK_TAB := 9, VK_RETURN := 13, VK_DELETE := 46
    codeEdit := false
    last := StrLen(codeText) + 1

    if (vk = VK_LEFT || vk = VK_RIGHT) {
        dir := (vk = VK_LEFT) ? -1 : 1
        if (!shift && CodeCollapse(dir))
            return true
        if (ctrl) {
            CodeMoveCaret(CodeWordOffset(codeCursorPos, dir), shift)
            return true
        }
        p := codeCursorPos + dir
        p := (p < 1) ? 1 : p
        p := (p > last) ? last : p
        CodeMoveCaret(p, shift)
        return true
    }
    if (vk = VK_UP || vk = VK_DOWN) {
        dir := (vk = VK_UP) ? -1 : 1
        if (ctrl) {
            codeScrollY := codeScrollY + dir * CodeLineHeight()
            codeScrollY := (codeScrollY < 0) ? 0 : codeScrollY
            return true
        }
        if (!shift && CodeCollapse(dir))
            return true
        codeSelAnchor := (shift && !codeSelAnchor) ? codeCursorPos : codeSelAnchor
        CodeMoveVerticalKeepCol(dir)
        return true
    }
    if (vk = VK_HOME || vk = VK_END) {
        if (ctrl)
            CodeMoveCaret((vk = VK_HOME) ? 1 : last, shift)
        else if (vk = VK_HOME)
            CodeMoveCaret(CodeSmartHome(), shift)
        else
            CodeMoveCaret(CodeLineEnd(codeCursorPos), shift)
        return true
    }
    if (vk = VK_PGUP || vk = VK_PGDN) {
        codeScrollY := codeScrollY + ((vk = VK_PGUP) ? -5 : 5) * CodeLineHeight()
        codeScrollY := (codeScrollY < 0) ? 0 : codeScrollY
        return true
    }
    if (vk = VK_BACK)
        return CodeDeleteBackward()
    if (vk = VK_DELETE)
        return CodeDeleteForward()
    if (vk = VK_RETURN) {
        CodeInsert(CodeIndentPayload(), "newline")
        return true
    }
    if (vk = VK_TAB) {
        CodeIndentLines(shift)
        return true
    }
    if (!ctrl)
        return false
    if (vk = 65) {
        codeSelAnchor := 1
        codeCursorPos := last
        return true
    }
    if (vk = 67) {
        if (HasCodeSelection()) {
            r := CodeSelRange()
            Clipboard := SubStr(codeText, r.s, r.e - r.s)
        } else {
            lc := CodePosToLineCol(codeText, codeCursorPos)
            Clipboard := StrSplit(codeText, "`n")[lc.line] . "`n"
        }
        return true
    }
    if (vk = 88) {
        PushCodeUndo("cut")
        if (HasCodeSelection()) {
            r := CodeSelRange()
            Clipboard := SubStr(codeText, r.s, r.e - r.s)
            DeleteCodeSelection()
        } else {
            lineStart := CodeLineStart(codeCursorPos), lineEnd := CodeLineEnd(codeCursorPos)
            Clipboard := SubStr(codeText, lineStart, lineEnd - lineStart) . "`n"
            if (lineEnd <= StrLen(codeText))
                codeText := SubStr(codeText, 1, lineStart-1) . SubStr(codeText, lineEnd+1)
            else
                codeText := SubStr(codeText, 1, lineStart-1)
            codeCursorPos := lineStart
            codeSelAnchor := 0
        }
        codeEdit := true
        return true
    }
    if (vk = 86) {
        CodeInsert(StrReplace(Clipboard, "`r`n", "`n"), "paste")
        return true
    }
    if (vk = 90) {
        if (shift)
            CodeRedo()
        else
            CodeUndo()
        return true
    }
    if (vk = 89) {
        CodeRedo()
        return true
    }
    return false
}

CodeScrollIntoView() {
    global codeText, codeCursorPos, codeScrollY, codeViewLines
    if (!codeViewLines)
        return
    lh := CodeLineHeight()
    line := CodePosToLineCol(codeText, codeCursorPos).line
    top := codeScrollY // lh + 1
    if (line < top)
        codeScrollY := (line - 1) * lh
    else if (line > top + codeViewLines - 1)
        codeScrollY := (line - codeViewLines) * lh
    codeScrollY := (codeScrollY < 0) ? 0 : codeScrollY
}

CodeXYToPos(x, y) {
    global winw, pny, pnh, gap, sidebarW, codeText, menug, codeScrollY
    cX := sidebarW+gap, cW := winw-sidebarW-gap*2, cY := pny+gap
    boxY := cY+22
    availH := pnh-gap*2-22-8
    boxH := Round(availH*0.62)
    codeSize := 11
    lines := StrSplit(codeText, "`n")
    totalLines := lines.MaxIndex()
    totalLines := (!totalLines) ? 1 : totalLines
    charW := GetMonoCharWidth(menug, codeSize)
    gutterDigits := StrLen(totalLines)
    gutterW := (gutterDigits < 2 ? 2 : gutterDigits) * charW + 14
    textX := cX + 10 + gutterW
    inside := (x >= textX && x <= cX+cW && y >= boxY && y <= boxY+boxH)
    innerY := boxY+8
    lineH := codeSize + 6
    clampedX := (x < textX) ? textX : x
    clickedLine := (y - innerY + codeScrollY) // lineH + 1
    clickedCol := Round((clampedX - textX) / charW)
    pos := CodeLineColToPos(codeText, clickedLine, clickedCol)
    return {pos:pos, inside:inside}
}

DrawCodeMultiline(G, txt, x, y, w, h, size, scrollY=0, highlightPositions=0, selRange=0) {
    static kwSet := {"PressKey":1,"ReleaseKey":1,"Sleep":1,"Print":1
        ,"MoveMouseTo":1,"MoveMouseRelative":1
        ,"local":1,"function":1,"end":1,"if":1,"then":1,"else":1,"elseif":1
        ,"for":1,"while":1,"do":1,"return":1,"true":1,"false":1,"nil":1
        ,"and":1,"or":1,"not":1,"break":1,"repeat":1,"until":1}
    clrKeyword := ARGBToHex(cA2)
    clrString  := cWarn
    clrNumber  := cInfo
    clrComment := cTx5
    clrDefault := cTx3
    clrGutter  := cFaint

    if (w <= 0 || h <= 0)
        return 0
    lineH := size + 6
    lines := StrSplit(txt, "`n")
    totalLines := lines.MaxIndex()
    charW := GetMonoCharWidth(G, size)
    gutterDigits := StrLen(totalLines)
    gutterW := (gutterDigits < 2 ? 2 : gutterDigits) * charW + 14

    pushclip(G, x, y, w, h)
    maxLines := h // lineH
    maxLines := (maxLines < 1) ? 1 : maxLines
    maxScrollLines := totalLines - maxLines
    maxScrollLines := (maxScrollLines < 0) ? 0 : maxScrollLines
    startIdx := (scrollY // lineH) + 1
    startIdx := (startIdx > maxScrollLines+1) ? maxScrollLines+1 : startIdx
    startIdx := (startIdx < 1) ? 1 : startIdx
    lineY := y
    codeX0 := x + gutterW
    highlightPositions := (!IsObject(highlightPositions)) ? [] : highlightPositions
    lineStartOffset := 1
    Loop, % totalLines {
        curLineLen := StrLen(lines[A_Index])
        if (A_Index < startIdx) {
            lineStartOffset += curLineLen + 1
            continue
        }
        if (lineY > y + h)
            break
        DrawCodeText(G, A_Index, x, lineY, gutterW-8, lineH, clrGutter, size, "Right")
        line := lines[A_Index]
        lineLen := StrLen(line)
        if (IsObject(selRange)) {
            lineEndOffset := lineStartOffset + lineLen
            selS := (selRange.s > lineStartOffset) ? selRange.s : lineStartOffset
            selE := (selRange.e < lineEndOffset+1) ? selRange.e : lineEndOffset+1
            if (selS < selE) {
                colS := selS - lineStartOffset
                colE := selE - lineStartOffset
                hx := codeX0 + colS*charW
                hw := (colE - colS) * charW
                hw := (hw < 2) ? 2 : hw
    pSel := Gdip_BrushCreateSolid(ApplyAlpha(cA1, 0.31))
                Gdip_FillRectangle(G, pSel, hx, lineY, hw, lineH-2)
                Gdip_DeleteBrush(pSel)
            }
        }
        for hpi, hp in highlightPositions {
            if (hp >= lineStartOffset && hp < lineStartOffset + lineLen) {
                col := hp - lineStartOffset
                hx := codeX0 + col*charW
    pHi := Gdip_BrushCreateSolid(ApplyAlpha(HexToARGB(cTx), 0.25))
                Gdip_FillRectangle(G, pHi, hx, lineY, charW, lineH-2)
                Gdip_DeleteBrush(pHi)
            }
        }
        lineX := codeX0
        for ti, tk in CodeLineTokens(line) {
            t := tk[1], kind := tk[2]
            if (kind = "comment") {
                DrawCodeText(G, t, lineX, lineY, w, lineH, clrComment, size, "Left")
                break
            }
            if (kind = "string")
                clr := clrString
            else if (kind = "number")
                clr := clrNumber
            else if (kind = "ident" && kwSet.HasKey(t))
                clr := clrKeyword
            else
                clr := clrDefault
            DrawCodeText(G, t, lineX, lineY, StrLen(t)*charW+4, lineH, clr, size, "Left")
            lineX += StrLen(t)*charW
        }
        lineY += lineH
        lineStartOffset += lineLen + 1
    }
    pGutterLine := Gdip_CreatePen(cLn, 1)
    Gdip_DrawLine(G, pGutterLine, x+gutterW-6, y, x+gutterW-6, y+h)
    Gdip_DeletePen(pGutterLine)
    popclip(G)
    return totalLines * lineH
}

