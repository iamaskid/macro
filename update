keydown(wParam, lParam, msg, hwnd) {
    global menuhwnd, chathwnd, kb_bindingNow, kb_key, menuKeyBind, menuKey, tutOpen
    if (tutOpen) {
        Tour_Key(wParam)
        return
    }
    global ovKeyBind, ovKey
    global searchFocus, searchText, searchResults
    global bsSynth, bsRepeat, bsHwnd
    if (hwnd != menuhwnd && hwnd != chathwnd)
        return

    global chatMenuOpen
    if (chatMenuOpen && wParam = 27) {
        chatMenuOpen := false
        DrawChatPanel()
        return
    }

    global slEditId, editTxt
    if (slEditId != "") {
        if (wParam = 13 || wParam = 9) {
            CommitSliderEdit()
            return
        }
        if (wParam = 27) {
            CancelSliderEdit()
            return
        }
        if (wParam = 8 || wParam = 46 || wParam = 37 || wParam = 39 || wParam = 36 || wParam = 35) {
            FieldKey(editTxt, "sldedit", wParam, GetKeyState("Shift"), GetKeyState("Ctrl"), 4)
            RequestMenuRedraw()
        }
        return
    }

    isRepeat := (lParam >> 30) & 1
    if (wParam = 8 && !bsSynth) {
        bsHwnd := hwnd
        if (isRepeat) {
            bsRepeat := true
            bsReal := A_TickCount
            bsPressT := A_TickCount
            bsLParam := lParam
            SetTimer, BackspaceFallback, Off
        } else {
            since := A_TickCount - bsPressT
            if (lParam = bsLParam && since < (bsDown ? 150 : 60))
                return
            bsDown := true
            bsPressT := A_TickCount
            bsLParam := lParam
            bsRepeat := false
            bsReal := A_TickCount
            SetTimer, BackspaceFallback, -600
        }
    }

    global codeFocused, codeText, codeCursorPos
    global codeUndoStack, codeRedoStack, acList, acSel, acStart
    global codeSelAnchor
    global stepPopupOpen, stepFocus, stepPopupType, stepKeyTxt, stepWaitTxt
    global bindPopupOpen, bindFocus, bindKeyTxt
    global chatFoc, chatInputText
    global ppOpen, ppFocus, ppSearchText
    global chatUserFoc, chatUser
    global cfgFoc, cfgText
    global bgUrlFoc

    VK_BACK := 8, VK_RETURN := 13, VK_ESCAPE := 27, VK_TAB := 9

    if (searchFocus) {
        if (FieldKey(searchText, "search", wParam, GetKeyState("Shift"), GetKeyState("Ctrl"), 40)) {
            Search_Update()
            RequestMenuRedraw()
        }
        if (wParam = VK_ESCAPE) {
            Search_Clear()
            DrawMenu()
            return
        }
        if (wParam = VK_RETURN) {
            if (searchResults.MaxIndex())
                Search_Jump(searchResults[1])
            return
        }
    }

    if (ppOpen && ppFocus) {
        if (wParam = VK_ESCAPE) {
            ppOpen := false
            ppFocus := false
            DrawMenu()
            return
        }
        if (FieldKey(ppSearchText, "ppsearch", wParam, GetKeyState("Shift"), GetKeyState("Ctrl")))
            RequestMenuRedraw()
        return
    }

    if (kb_bindingNow) {
        if (wParam = VK_ESCAPE) {
            kb_bindingNow := false
            SetTimer, BindCaptureMouseTick, Off
            DrawMenu()
            return
        }
        if (wParam = 8 || wParam = 9 || wParam = 13 || (wParam >= 37 && wParam <= 40)) {
            ShowToast(brandName, "That key can't be used - it's needed for typing/editing")
            return
        }
        keyName := GetKeyName(Format("vk{:x}", wParam))
        if (keyName != "") {
            kb_key := keyName
            kb_bindingNow := false
            SetTimer, BindCaptureMouseTick, Off
            ApplyKbHotkey()
            Storage_AutoSave()
            ShowToast(brandName, "Key bound: " . keyName)
            DrawMenu()
        }
        return
    }

    if (ovKeyBind) {
        if (wParam = VK_ESCAPE) {
            ovKeyBind := false
            DrawMenu()
            return
        }
        if (wParam = 8 || wParam = 9 || wParam = 13 || (wParam >= 37 && wParam <= 40)) {
            ShowToast(brandName, "That key can't be used - it's needed for typing/editing")
            return
        }
        keyName := GetKeyName(Format("vk{:x}", wParam))
        if (keyName != "") {
            mods := ""
            if (GetKeyState("Shift", "P"))
                mods .= "+"
            if (GetKeyState("Ctrl", "P"))
                mods .= "^"
            if (GetKeyState("Alt", "P"))
                mods .= "!"
            ovKey := mods . keyName
            ovKeyBind := false
            ApplyOverlayHotkey()
            Storage_AutoSave()
            ShowToast(brandName, "Overlay key bound: " . Ov_PrettyKey(ovKey))
            DrawMenu()
        }
        return
    }

    if (menuKeyBind) {
        if (wParam = VK_ESCAPE) {
            menuKeyBind := false
            DrawMenu()
            return
        }
        if (wParam = 8 || wParam = 9 || wParam = 13 || (wParam >= 37 && wParam <= 40)) {
            ShowToast(brandName, "That key can't be used - it's needed for typing/editing")
            return
        }
        keyName := GetKeyName(Format("vk{:x}", wParam))
        if (keyName != "") {
            menuKey := keyName
            menuKeyBind := false
            ApplyMenuKeyHotkey()
            Storage_AutoSave()
            ShowToast(brandName, "UI toggle key bound: " . keyName)
            DrawMenu()
        }
        return
    }

    if (stepPopupOpen && stepFocus) {
        if (stepPopupType = "key") {
            if (FieldKey(stepKeyTxt, "stepkey", wParam, GetKeyState("Shift"), GetKeyState("Ctrl")))
                RequestMenuRedraw()
        } else {
            if (FieldKey(stepWaitTxt, "stepwait", wParam, GetKeyState("Shift"), GetKeyState("Ctrl")))
                RequestMenuRedraw()
        }
        if (wParam = VK_RETURN)
            SaveStepPopup()
        else if (wParam = VK_ESCAPE)
            CancelStepPopup()
        return
    }

    if (bindPopupOpen && bindFocus) {
        if (wParam = VK_ESCAPE) {
            bindPopupOpen := false
            DrawMenu()
            return
        }
        if (FieldKey(bindKeyTxt, "bindkey", wParam, GetKeyState("Shift"), GetKeyState("Ctrl")))
            RequestMenuRedraw()
        return
    }

    if (chatUserFoc) {
        if (wParam = VK_RETURN || wParam = VK_ESCAPE) {
            chatUserFoc := false
            Storage_AutoSave()
            DrawMenu()
            return
        }
        if (FieldKey(chatUser, "chatuser", wParam, GetKeyState("Shift"), GetKeyState("Ctrl"), 24))
            RequestMenuRedraw()
        return
    }

    if (cfgFoc) {
        if (wParam = VK_RETURN || wParam = VK_ESCAPE) {
            cfgFoc := false
            DrawMenu()
            return
        }
        if (FieldKey(cfgText, "configname", wParam, GetKeyState("Shift"), GetKeyState("Ctrl"), 32))
            RequestMenuRedraw()
        return
    }

    if (bgUrlFoc) {
        global bgUrl, bgPath
        if (wParam = VK_RETURN || wParam = VK_ESCAPE) {
            bgUrlFoc := false
            if (wParam = VK_RETURN && bgUrl != "") {
                bgPath := ""
                Storage_AutoSave()
                LoadBackgroundImage()
            }
            DrawMenu()
            return
        }
        if (FieldKey(bgUrl, "bgurl", wParam, GetKeyState("Shift"), GetKeyState("Ctrl"), 300))
            RequestMenuRedraw()
        return
    }

    if (hwnd = chathwnd && chatFoc) {
        if (wParam = VK_RETURN) {
            if (chatInputText != "") {
                if (TrySendChat(chatInputText)) {
                    chatInputText := ""
                    FieldState("chatinput").c := 1
                    FieldState("chatinput").a := 0
                }
                DrawChatPanel()
            }
            return
        }
        if (FieldKey(chatInputText, "chatinput", wParam, GetKeyState("Shift"), GetKeyState("Ctrl")))
            DrawChatPanel()
        return
    }

    if (codeFocused) {
        VK_TAB := 9, VK_ESCAPE := 27, VK_UP := 38, VK_DOWN := 40
        if (acList.MaxIndex() && wParam = VK_UP) {
            acSel -= 1
            if (acSel < 1)
                acSel := acList.MaxIndex()
        } else if (acList.MaxIndex() && wParam = VK_DOWN) {
            acSel += 1
            if (acSel > acList.MaxIndex())
                acSel := 1
        } else if (acList.MaxIndex() && (wParam = VK_TAB || wParam = 13)) {
            AcceptCodeAutocomplete()
        } else if (wParam = VK_ESCAPE && acList.MaxIndex()) {
            acList := []
        } else if (wParam = VK_ESCAPE) {
            codeFocused := false
        } else if (CodeEditKey(wParam, GetKeyState("Shift"), GetKeyState("Ctrl"))) {
            if (codeEdit)
                UpdateCodeAutocomplete()
            else
                acList := []
            CodeScrollIntoView()
        } else {
            return
        }
        RequestMenuRedraw()
        return
    }
}

BackspaceFallback:
    global bsSynth, bsRepeat, bsHwnd, bsReal
    if (bsRepeat || !GetKeyState("Backspace", "P")) {
        SetTimer, BackspaceFallback, Off
        return
    }
    if (A_TickCount - bsReal < 250) {
        SetTimer, BackspaceFallback, -25
        return
    }
    bsReal := A_TickCount
    bsSynth := true
    try {
        keydown(8, 0, 0x100, bsHwnd)
    } catch e {
        ConsoleLog("backspace repeat failed: " . (IsObject(e) ? e.Message : e))
    }
    bsSynth := false
    SetTimer, BackspaceFallback, -30
return

