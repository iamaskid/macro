ParseUrl(url, ByRef host, ByRef path, ByRef secure) {
    secure := false
    rest := ""
    if (SubStr(url, 1, 8) = "https://") {
        secure := true
        rest := SubStr(url, 9)
    } else if (SubStr(url, 1, 7) = "http://") {
        secure := false
        rest := SubStr(url, 8)
    } else {
        return false
    }
    slashPos := InStr(rest, "/")
    if (slashPos) {
        host := SubStr(rest, 1, slashPos-1)
        path := SubStr(rest, slashPos)
    } else {
        host := rest
        path := "/"
    }
    if (host = "")
        return false
    return true
}

