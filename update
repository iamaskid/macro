    }
    ext := ".jpg"
    if (SubStr(data, 1, 4) = "iVBO")
        ext := ".png"
    else if (SubStr(data, 1, 5) = "R0lGO")
        ext := ".gif"
    else if (SubStr(data, 1, 4) = "UklG")
