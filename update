        lstroketext(G, "x", px+pw-20, py+5, 12, 12, cDim, 6, "Right")

        MockCard(G, px+10, py+21, pw-20, 17, pu)
        typedN := Floor(Seg(t, 2500, 3150) * 3)
        typed := SubStr("cod", 1, typedN)
        caret := (t > 2400 && t < 3300) ? "|" : ""
        lbl := (typed = "") ? "Search running processes..." : (typed . caret)
        lstroketext(G, lbl, px+16, py+21, pw-32, 17, (typed = "") ? cFaint : cTx, 6, "Left")

        rwsY := py + 42
        if (typedN >= 3) {
            lstroketext(G, "cod.exe", px+16, rwsY, pw-32, 14, cTx, 6, "Left")
            if (t > 3150) {
                pHl := Gdip_BrushCreateSolid(ApplyAlpha(cA1, 0.45))
                lfillroundrect(G, pHl, px+10, rwsY-1, pw-20, 16, 4)
                Gdip_DeleteBrush(pHl)
            }
        } else if (typedN = 1) {
            names := ["cod.exe", "Code.exe", "codex.exe"]
            Loop, 3
                lstroketext(G, names[A_Index], px+16, rwsY + (A_Index - 1) * 14, pw-32, 14, cDim, 6, "Left")
        } else {
            names := ["AggregatorHost.exe", "AppActions.exe", "ApplicationFrameHost.exe", "AutoHotkeyU64.exe"]
            Loop, 4
                lstroketext(G, names[A_Index], px+16, rwsY + (A_Index - 1) * 14, pw-32, 14, cDim, 6, "Left")
        }
    }

    cx0 := x + w - 44, cy0 := y + h - 22
    s1x := left + slotW / 2, s1y := y + 35
    s2x := px + 60, s2y := py + 30
    r2x := px + 50, r2y := rwsY + 6
    u1 := Ease(Seg(t, 300, 1200))
    u2 := Ease(Seg(t, 1950, 2400))
    u3 := Ease(Seg(t, 3300, 3850))
    cx := cx0 + (s1x - cx0) * u1, cy := cy0 + (s1y - cy0) * u1
    cx += (s2x - cx) * u2, cy += (s2y - cy) * u2
    cx += (r2x - cx) * u3, cy += (r2y - cy) * u3
    press := 0
    if (t > 2400 && t < 2650)
        press := Seg(t, 2400, 2520)
    if (t > 3900 && t < 4180)
        press := Seg(t, 3900, 4030)
    SceneDot(G, cx, cy, press)
}

