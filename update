HttpGet(url) {
    if (!ParseUrl(url, host, path, secure))
        return {ok:false, body:"", err:"Bad URL (" . url . ")"}
    hInet := DllCall("wininet\InternetOpenA", "astr", "UnicornAtlas/1.0", "uint", 0, "ptr", 0, "ptr", 0, "uint", 0, "ptr")
    if (!hInet)
        return {ok:false, body:"", err:"InternetOpen failed (" . A_LastError . ")"}
    HttpSetTimeouts(hInet, 2500)
    port := secure ? 443 : 80
    hConn := DllCall("wininet\InternetConnectA", "ptr", hInet, "astr", host, "ushort", port, "ptr", 0, "ptr", 0, "uint", 3, "uint", 0, "uint", 0, "ptr")
    if (!hConn) {
        e := A_LastError
        DllCall("wininet\InternetCloseHandle", "ptr", hInet)
        return {ok:false, body:"", err:"InternetConnect failed (" . e . ")"}
    }
    flags := secure ? 0x00800000 : 0
    hReq := DllCall("wininet\HttpOpenRequestA", "ptr", hConn, "astr", "GET", "astr", path, "ptr", 0, "ptr", 0, "ptr", 0, "uint", flags, "uint", 0, "ptr")
    if (!hReq) {
        e := A_LastError
        DllCall("wininet\InternetCloseHandle", "ptr", hConn)
        DllCall("wininet\InternetCloseHandle", "ptr", hInet)
        return {ok:false, body:"", err:"HttpOpenRequest failed (" . e . ")"}
    }
    ok := DllCall("wininet\HttpSendRequestA", "ptr", hReq, "ptr", 0, "uint", 0, "ptr", 0, "uint", 0)
    if (!ok) {
        e := A_LastError
        DllCall("wininet\InternetCloseHandle", "ptr", hReq)
        DllCall("wininet\InternetCloseHandle", "ptr", hConn)
        DllCall("wininet\InternetCloseHandle", "ptr", hInet)
        return {ok:false, body:"", err:"HttpSendRequest failed (" . e . ")"}
    }
    result := ""
    VarSetCapacity(buf, 8192, 0)
    Loop {
        rok := DllCall("wininet\InternetReadFile", "ptr", hReq, "ptr", &buf, "uint", 8192, "uint*", bytesRead)
        if (!rok || bytesRead = 0)
            break
        result .= StrGet(&buf, bytesRead, "UTF-8")
    }
    DllCall("wininet\InternetCloseHandle", "ptr", hReq)
    DllCall("wininet\InternetCloseHandle", "ptr", hConn)
    DllCall("wininet\InternetCloseHandle", "ptr", hInet)
    return {ok:true, body:result, err:""}
}

