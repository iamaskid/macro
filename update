ThemePalette() {
    global theme
    static lastKey := "", pal := 0
    if (lastKey = theme && IsObject(pal))
        return pal
    th := GetThemeColors(theme)
    extras := ThemeExtras(theme, th)
    for k, v in extras
        th[k] := v
    lastKey := theme, pal := th
    return pal
}

