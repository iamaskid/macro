            SetTimer, ScriptLoopTick, Off
            ShowToast(brandName, "Script stopped")
        }
        return
    }
    scriptStop := false
    scriptHold := true
    scriptOn := true
    SetTimer, ScriptLoopTick, 10
return

ScriptLoopTick:
    global scriptOn, scriptBusy, scriptStop, scriptHold, masterOn, menuhwnd, chathwnd, scriptKey
