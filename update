menumousewheel(wParam, lParam, msg, hwnd) {
    global menuhwnd, chathwnd, activetab, editorScrollY, consoleY, chatScrollY
    global consoleBoxX, consoleBoxY, consoleBoxW, consoleBoxH
    if (hwnd = chathwnd) {
        delta := (wParam >> 16) & 0xFFFF
        if (delta > 0x7FFF)
            delta -= 0x10000
        dir := (delta > 0) ? -1 : 1
        chatScrollY := (chatScrollY + dir*20 < 0) ? 0 : chatScrollY + dir*20
        DrawChatPanel()
        return
    }
    if (hwnd != menuhwnd)
        return
    delta := (wParam >> 16) & 0xFFFF
    if (delta > 0x7FFF)
        delta -= 0x10000
    dir := (delta > 0) ? -1 : 1
    global codeScrollY, genScrollY, genTgt
    global editorTgt, codeScrTgt, consoleTgt
    if (activetab = 3) {
        editorTgt := (editorTgt + dir*54 < 0) ? 0 : editorTgt + dir*54
        StartScrollAnim()
        return
    }
    if (activetab = 4) {
        codeScrTgt := (codeScrTgt + dir*3*CodeLineHeight() < 0) ? 0 : codeScrTgt + dir*3*CodeLineHeight()
        StartScrollAnim()
        return
    }
    if (activetab = 6 && ConsoleTakesWheel(dir)) {
        consoleTgt := (consoleTgt - dir*3 < 0) ? 0 : consoleTgt - dir*3
        StartScrollAnim()
        return
    }
    if (genTgt.HasKey(activetab)) {
        genTgt[activetab] := (genTgt[activetab] + dir*50 < 0) ? 0 : genTgt[activetab] + dir*50
        StartScrollAnim()
        return
    }
    RequestMenuRedraw()
}

RectHit(x, y, w, h, px, py) {
    return (w > 0 && h > 0 && px >= x && px <= x+w && py >= y && py <= y+h)
}

CursorInRect(x, y, w, h) {
    global menuhwnd
    if (!menuhwnd)
        return false
    MouseGetPos, mx, my
    WinGetPos, wx, wy,,, ahk_id %menuhwnd%
    return RectHit(x, y, w, h, mx - wx, my - wy)
}

ConsoleTakesWheel(dir) {
    global consoleY, maxVis
    global consoleBoxX, consoleBoxY, consoleBoxW, consoleBoxH
    if (!CursorInRect(consoleBoxX, consoleBoxY, consoleBoxW, consoleBoxH))
        return false
    return (dir < 0) ? (consoleY < maxVis) : (consoleY > 0)
}

XY_FromLParam(lParam) {
    x := lParam & 0xFFFF
    y := (lParam >> 16) & 0xFFFF
    if (x > 0x7FFF)
        x -= 0x10000
    if (y > 0x7FFF)
        y -= 0x10000
    return [x, y]
}

XY_FromLParamScaled(lParam) {
    global dpiScale
    p := XY_FromLParam(lParam)
    return [Round(p[1] / dpiScale), Round(p[2] / dpiScale)]
}

