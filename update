CheckMouseLeave() {
    global menuhwnd, overMenu, menuAutoHide, menuHideAt, menuHoverArmed, menuHideDelay
    global bgUrlFoc, chatUserFoc, cfgFoc, codeFocused, searchFocus, slEditId
    if (!menuhwnd)
        return
    MouseGetPos, mx, my, winUnderMouse
    isOver := (winUnderMouse = menuhwnd)
    if (isOver != overMenu) {
        overMenu := isOver
        RequestMenuRedraw()
    }
    if (isOver) {
        menuHoverArmed := true
        menuHideAt := 0
        return
    }
    typing := (bgUrlFoc || chatUserFoc || cfgFoc || codeFocused || searchFocus || slEditId != "")
    if (!menuAutoHide || !menuHoverArmed || typing || GetKeyState("LButton", "P") || !IsMenuVisible()) {
        menuHideAt := 0
        return
    }
    if (!menuHideAt) {
        menuHideAt := A_TickCount + menuHideDelay
    } else if (A_TickCount >= menuHideAt) {
        menuHideAt := 0
        menuHoverArmed := false
        HideMenuFade()
    }
}

HideMenuFade() {
    global menuhwnd, lite, fadeOutOn
    if (!menuhwnd)
        return
