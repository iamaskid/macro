ExportTo(dir) {
    global macroSteps, codeText, expPopupOpen, brandName
    if (dir = "") {
        ShowToast(brandName, "That folder was not found")
        return
    }
    FormatTime, stamp,, yyyyMMdd_HHmmss
    path := dir . "\unicorn_macro_" . stamp . ".unicornmacro"
    out := "[unicorn macro export]`nversion=1`n`n[steps]`n"
    Loop, % macroSteps.MaxIndex() {
        s := macroSteps[A_Index]
        if (s.type = "key")
            out .= "key|" . s.key . "|" . s.action . "`n"
        else
            out .= "wait|" . s.ms . "`n"
    }
    out .= "`n[code]`n" . codeText . "`n"
    FileAppend, %out%, %path%
    expPopupOpen := false
    ShowToast(brandName, "Exported to " . path)
    ConsoleLog("Exported macro to " . path)
    DrawMenu()
}

