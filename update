ThemeIsLight(bg) {
    lum := (0.2126 * ((bg >> 16) & 0xFF) + 0.7152 * ((bg >> 8) & 0xFF) + 0.0722 * (bg & 0xFF)) / 255
    return (lum > 0.55)
}

ChannelLum(v) {
    v := v / 255
    return (v <= 0.03928) ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4
}
RelLum(c) {
    return 0.2126 * ChannelLum((c >> 16) & 0xFF) + 0.7152 * ChannelLum((c >> 8) & 0xFF) + 0.0722 * ChannelLum(c & 0xFF)
}
ContrastRatio(a, b) {
    la := RelLum(a), lb := RelLum(b)
    if (la < lb)
        t := la, la := lb, lb := t
    return (la + 0.05) / (lb + 0.05)
}
EnsureContrast(fgHex, bgHex, minRatio := 4.5) {
    fg := HexToARGB(fgHex), bg := HexToARGB(bgHex)
    if (ContrastRatio(fg, bg) >= minRatio)
        return fgHex
    Loop, 10 {
        fg := MixARGB(fg, 0xFF000000, 0.12)
        if (ContrastRatio(fg, bg) >= minRatio)
            break
    }
    return ARGBToHex(fg)
}

ThemeScrim(bg) {
    if (ThemeIsLight(bg))
        return 0xB8000000 | (bg & 0x00FFFFFF)
    return 0x99000000 | (bg & 0x00FFFFFF)
}

