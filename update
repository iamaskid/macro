RunCodeScript(silent := false) {
    global codeText, codeOutput, scriptKey
    outLines := []
    sawBind := false
    Loop, Parse, codeText, `n, `r
    {
        line := Trim(A_LoopField)
        if (line = "" || SubStr(line,1,2) = "--")
            continue
        if (RegExMatch(line, "i)^Bind\(""([^""]+)"",\s*""(hold|toggle)""\)$", m)) {
            Script_SetBind(m1, m2)
            sawBind := true
            outLines.Push("> Bind(" . m1 . ", " . m2 . ")")
        } else if (RegExMatch(line, "i)^PressKey\(""(.+)""\)$", m)) {
            Send, {%m1% down}
            outLines.Push("> PressKey(" . m1 . ")")
        } else if (RegExMatch(line, "i)^ReleaseKey\(""(.+)""\)$", m)) {
            Send, {%m1% up}
            outLines.Push("> ReleaseKey(" . m1 . ")")
        } else if (RegExMatch(line, "i)^Sleep\((\d+)\)$", m)) {
            Sleep, % m1
            outLines.Push("> Sleep(" . m1 . ")")
        } else if (RegExMatch(line, "i)^MoveMouseTo\((-?\d+)\s*,\s*(-?\d+)\)$", m)) {
            MouseMove, % m1, % m2, 0
            outLines.Push("> MoveMouseTo(" . m1 . ", " . m2 . ")")
        } else if (RegExMatch(line, "i)^MoveMouseRelative\((-?\d+)\s*,\s*(-?\d+)\)$", m)) {
            MouseMove, % m1, % m2, 0, R
            outLines.Push("> MoveMouseRelative(" . m1 . ", " . m2 . ")")
        } else if (RegExMatch(line, "i)^Print\(""(.*)""\)$", m)) {
            outLines.Push(m1)
        } else {
            outLines.Push("! Error: unrecognized line: " . line)
        }
    }
    out := ""
    for i, l in outLines
        out .= (i=1 ? "" : "`n") . l
    codeOutput := (out = "") ? "welcome to unicorn" : out
    if (!silent) {
        if (!sawBind && scriptKey != "")
            Script_ClearBind()
        ConsoleLog("Ran code script (" . outLines.MaxIndex() . " line(s))")
    }
}

