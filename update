drawsegmented(G, x, y, w, h, items, selIdx, varName) {
    global ddrects, mousex, mousey
    n := items.MaxIndex()
    segW := (w - n + 1) // n
    pBg := Gdip_BrushCreateSolid(cPn)
    lfillroundrect(G, pBg, x, y, w, h, 5)
    Gdip_DeleteBrush(pBg)
    pAllPen := Gdip_CreatePen(cBd, 1)
    ldrawroundrect(G, pAllPen, x, y, w, h, 5)
    Gdip_DeletePen(pAllPen)
    if (selIdx >= 0) {
        slX := x + AnimFrac("segpos:" . varName, selIdx, 0.32) * (segW + 1)
    pSel := Gdip_CreateLineBrush(slX, y+h, slX, y, MixARGB(cBg, cA1, 0.40), cA1, 1)
        lfillroundrect(G, pSel, slX, y, segW, h, 4)
        Gdip_DeleteBrush(pSel)
    pSelPen := Gdip_CreatePen(cA2, 1)
        ldrawroundrect(G, pSelPen, slX, y, segW, h, 4)
        Gdip_DeletePen(pSelPen)
    }
    Loop, % n {
        i := A_Index
        sX := x + (i-1)*(segW+1)
        isSel := (selIdx = i-1)
        hover := (mousex >= sX && mousex <= sX+segW && mousey >= y && mousey <= y+h)
        hv := AnimFrac("seghov:" . varName . ":" . (i-1), hover ? 1 : 0, 0.34)
        if (!isSel && hv > 0.01) {
        pHov := Gdip_BrushCreateSolid(ApplyAlpha(cBeat, hv))
            lfillroundrect(G, pHov, sX, y, segW, h, 4)
            Gdip_DeleteBrush(pHov)
