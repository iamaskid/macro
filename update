    if (pu > 0.01 && t < 5100) {
        pw := totalW, ph := Round((h - 22) * (0.6 + 0.4 * pu))
        px := left, py := y + 12
        pSh := Gdip_BrushCreateSolid(ApplyAlpha(cSh2, 0.6 * pu))
        lfillroundrect(G, pSh, px+2, py+3, pw, ph, 6)
        Gdip_DeleteBrush(pSh)
        pBg2 := Gdip_BrushCreateSolid(ApplyAlpha(cBg, 0.99 * pu))
        lfillroundrect(G, pBg2, px, py, pw, ph, 6)
        Gdip_DeleteBrush(pBg2)
        pBd2 := Gdip_CreatePen(ApplyAlpha(cLn, 0.9), 1)
