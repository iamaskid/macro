DrawScrollbarThumb(G, trackX, trackY, trackH, contentH, viewH, scrollY) {
    global cBd
    if (scrollY <= 0 || contentH <= viewH)
        return
    maxScroll := contentH - viewH
    thumbH := viewH * viewH / contentH
    thumbH := (thumbH < 34) ? 34 : thumbH
    thumbH := (thumbH > trackH) ? trackH : thumbH
    ratio := scrollY / maxScroll
    ratio := (ratio > 1) ? 1 : ratio
    thumbY := trackY + ratio * (trackH - thumbH)
    tw := 5
    tx := trackX - (tw-3)
    pThumb := Gdip_BrushCreateSolid(cBd)
    lfillroundrect(G, pThumb, tx, thumbY, tw, thumbH, tw//2)
    Gdip_DeleteBrush(pThumb)
    pGripPen := Gdip_CreatePen(cGrip, 1)
    cx := tx + tw/2
    if (thumbH >= 40) {
        topY := thumbY + 8
        Gdip_DrawLine(G, pGripPen, cx-1.6, topY+2.4, cx, topY)
        Gdip_DrawLine(G, pGripPen, cx, topY, cx+1.6, topY+2.4)
        botY := thumbY + thumbH - 8
        Gdip_DrawLine(G, pGripPen, cx-1.6, botY-2.4, cx, botY)
        Gdip_DrawLine(G, pGripPen, cx, botY, cx+1.6, botY-2.4)
    }
    Gdip_DeletePen(pGripPen)
    pGripDot := Gdip_BrushCreateSolid(cGrip)
    Gdip_FillEllipse(G, pGripDot, cx-1, thumbY+thumbH/2-1, 2, 2)
    Gdip_DeleteBrush(pGripDot)
}

FilterRectsToViewport(ByRef arr, vTop, vH) {
    out := []
    for i, r in arr {
        if (r.y + r.h >= vTop && r.y <= vTop + vH)
            out.Push(r)
    }
    arr := out
}

DrawScrollableTab(G, tabIdx, funcName, pX, pY, pW, pH) {
    global genScrollY, genTgt, btnrects, chkrects, sldrects, ddrects, txtrects
    sY := genScrollY.HasKey(tabIdx) ? genScrollY[tabIdx] : 0
    pushclip(G, pX, pY, pW, pH)
    bottomCY := %funcName%(G, pX, pY - sY, pW, 4000)
    popclip(G)
    contentBottom := bottomCY + sY
    maxScroll := contentBottom - (pY + pH)
    maxScroll := (maxScroll < 0) ? 0 : maxScroll
    sY := (sY > maxScroll) ? maxScroll : sY
    sY := (sY < 0) ? 0 : sY
    genScrollY[tabIdx] := sY
    if (genTgt.HasKey(tabIdx)) {
        if (genTgt[tabIdx] > maxScroll)
            genTgt[tabIdx] := maxScroll
        if (genTgt[tabIdx] < 0)
            genTgt[tabIdx] := 0
    }
    FilterRectsToViewport(btnrects, pY, pH)
    FilterRectsToViewport(chkrects, pY, pH)
    FilterRectsToViewport(sldrects, pY, pH)
    FilterRectsToViewport(sldValRects, pY, pH)
    FilterRectsToViewport(txtrects, pY, pH)
    FilterRectsToViewport(ddrects, pY, pH)
    DrawScrollbarThumb(G, pX+pW-6, pY, pH, contentBottom-pY, pH, sY)
}

DrawSidebarIconGlyph(G, iconId, x, y, size, clr) {
    cx := x + size/2, cy := y + size/2
    pPen := Gdip_CreatePen(clr, 1.6)
    if (iconId = "target") {
        r := 7
        Gdip_DrawEllipse(G, pPen, cx-r, cy-r, r*2, r*2)
        Gdip_DrawLine(G, pPen, cx-r-4, cy, cx-r+2, cy)
        Gdip_DrawLine(G, pPen, cx+r-2, cy, cx+r+4, cy)
        Gdip_DrawLine(G, pPen, cx, cy-r-4, cx, cy-r+2)
        Gdip_DrawLine(G, pPen, cx, cy+r-2, cx, cy+r+4)
        pDot := Gdip_BrushCreateSolid(clr)
        Gdip_FillEllipse(G, pDot, cx-1.5, cy-1.5, 3, 3)
        Gdip_DeleteBrush(pDot)
    } else if (iconId = "home") {
        Gdip_DrawLine(G, pPen, cx-8, cy-1, cx, cy-8)
        Gdip_DrawLine(G, pPen, cx, cy-8, cx+8, cy-1)
        Gdip_DrawLine(G, pPen, cx-6, cy-1, cx-6, cy+8)
        Gdip_DrawLine(G, pPen, cx+6, cy-1, cx+6, cy+8)
        Gdip_DrawLine(G, pPen, cx-6, cy+8, cx+6, cy+8)
        pDoorBrush := Gdip_BrushCreateSolid(clr)
        Gdip_FillRectangle(G, pDoorBrush, cx-2, cy+2, 4, 6)
        Gdip_DeleteBrush(pDoorBrush)
    } else if (iconId = "list") {
        lineW := 14
        ly := cy - 7
        Loop, 3 {
            Gdip_DrawLine(G, pPen, cx-lineW/2, ly, cx+lineW/2, ly)
            ly += 7
        }
    } else if (iconId = "gear") {
        r := 6

        Gdip_DrawEllipse(G, pPen, cx-r, cy-r, r*2, r*2)
        pDot := Gdip_BrushCreateSolid(clr)
        Gdip_FillEllipse(G, pDot, cx-1.5, cy-1.5, 3, 3)
        Gdip_DeleteBrush(pDot)
        Loop, 6 {
            ang := (A_Index-1) * 60
            rad := ang * 0.0174533
            x1 := cx + Cos(rad)*(r+1)
            y1 := cy + Sin(rad)*(r+1)
            x2 := cx + Cos(rad)*(r+4)
            y2 := cy + Sin(rad)*(r+4)
            Gdip_DrawLine(G, pPen, x1, y1, x2, y2)
        }
    }
    Gdip_DeletePen(pPen)
}

DrawSidebarChevron(G, x, y, w, h, clr, openFrac) {
    cx := x + w/2, cy := y + h/2
    deg := 180 * openFrac
    pPen := Gdip_CreatePen(clr, 1.6)
    a := RotPt(cx - 2.5, cy - 4.5, cx, cy, deg)
    b := RotPt(cx + 2.5, cy, cx, cy, deg)
    c := RotPt(cx - 2.5, cy + 4.5, cx, cy, deg)
    Gdip_DrawLine(G, pPen, a[1], a[2], b[1], b[2])
    Gdip_DrawLine(G, pPen, b[1], b[2], c[1], c[2])
    Gdip_DeletePen(pPen)
}

DrawChevronTurn(G, cx, cy, dx, dy, clr, deg, penW := 1.5) {
    pPen := Gdip_CreatePen(clr, penW)
    a := RotPt(cx - dx, cy - dy, cx, cy, deg)
    b := RotPt(cx, cy + dy, cx, cy, deg)
    c := RotPt(cx + dx, cy - dy, cx, cy, deg)
    Gdip_DrawLine(G, pPen, a[1], a[2], b[1], b[2])
    Gdip_DrawLine(G, pPen, b[1], b[2], c[1], c[2])
    Gdip_DeletePen(pPen)
}

HoverSignature(x, y) {
    global btnrects, chkrects, sldrects, ddrects, txtrects, tabrects, sbIconRects
    hit := ""
    for i, r in btnrects
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h)
            hit .= "b" . r.id . ";"
    for i, r in chkrects
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h)
            hit .= "c" . r.id . ";"
    for i, r in sldrects
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h)
            hit .= "s" . r.id . ";"
    for i, r in ddrects
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h)
            hit .= "d" . (r.id != "" ? r.id : i) . ";"
    for i, r in txtrects
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h)
            hit .= "t" . r.id . ";"
    for i, r in sbIconRects
