LinkClean(url) {
    u := Trim(RegExReplace(url, "\s+", ""))
    p := RegExMatch(u, "i)https?://", m, 2)
    u := (p) ? SubStr(u, 1, p - 1) : u
    u := (SubStr(u, 1, 4) = "www.") ? "https://" . u : u
    return u
}

LinkDisplay(url) {
    return LinkClean(url)
}

LinkFit(G, txt, size, maxW) {
    if (maxW < 12 || txt = "")
        return txt
    if (RunWidth(G, txt, size) <= maxW)
        return txt
    s := txt
    while (StrLen(s) > 1 && RunWidth(G, s . Chr(0x2026), size) > maxW)
        s := SubStr(s, 1, StrLen(s) - 1)
    return s . Chr(0x2026)
}

TrySendChat(text) {
    global chatSendTimes, chatCD
    if (text = "")
        return false
    now := A_TickCount
    if (chatCD && now < chatCD) {
        remain := Ceil((chatCD - now) / 1000)
        ShowToast(brandName, "Slow down - wait " . remain . "s")
        return false
    }
    Loop {
        if (chatSendTimes.MaxIndex() = 0)
            break
        if (now - chatSendTimes[1] > 10000)
            chatSendTimes.RemoveAt(1)
        else
            break
    }
    chatSendTimes.Push(now)
    if (chatSendTimes.MaxIndex() > 5) {
        chatCD := now + 10000
        ShowToast(brandName, "You're sending messages too fast - cooldown 10s")
        return false
    }
    SendChatMessage(text)
    return true
}

SendChatMessage(text) {
    global chUrl, localId, chatUser, castGame, gameNow
    uname := (chatUser != "") ? chatUser : localId
    if (castGame)
        uname .= " - " . (gameNow != "" ? gameNow : "No game")
    FormatTime, timeStamp,, h:mm tt
    FormatTime, dateStamp,, MMM d, yyyy
    body := "{""user"": """ . uname . """, ""uid"": """ . localId . """, ""message"": """ . JsonEscape(text) . """, ""time"": """ . timeStamp . """, ""date"": """ . dateStamp . """}"
    r := HttpPostJson(chUrl, body)
    if (!r.ok)
        ConsoleLog("Chat send failed: " . r.err)
}

FetchChatMessages() {
    global chUrl, chCap, chathwnd
    global chatSeenKeys, chatPollBusy, chatMessages, chOn, chatPrimed, macroOn, isdragging
    if (chatPollBusy || macroOn || isdragging)
        return
    chatPollBusy := true
    r := HttpGet(chUrl . "?orderBy=%22%24key%22&limitToLast=50")
    if (!r.ok) {
        if (A_TickCount - chLastLog > 60000) {
            chLastLog := A_TickCount
            ConsoleLog("Chat fetch failed: " . r.err)
        }
        chatPollBusy := false
        return
    }
    body := r.body
    global chDenied, chLastLog
    if (InStr(body, "Permission denied")) {
        if (!chDenied) {
            chDenied := true
            ConsoleLog("Chat: Firebase denied access - set your Realtime Database rules")
            ShowToast(brandName, "Chat blocked by Firebase rules")
        }
        chatPollBusy := false
        return
    }
    if (body != "null" && body != "") {
        added := false
        starts := []
        pos := 1
        while (pos := RegExMatch(body, """([A-Za-z0-9_\-]+)""\s*:\s*\{", mm, pos)) {
            starts.Push({key:mm1, at:pos, bodyStart:pos + StrLen(mm)})
            pos += StrLen(mm)
        }
        for i, s in starts {
            end := (i < starts.MaxIndex()) ? starts[i+1].at : StrLen(body) + 1
            entry := SubStr(body, s.bodyStart, end - s.bodyStart)
            u := JsonField(entry, "user")
            m := JsonField(entry, "message")
            t := JsonField(entry, "time")
            d := JsonField(entry, "date")
            uid := JsonField(entry, "uid")
            img := JsonField(entry, "img")
            if (u = "" && m = "" && img = "")
                continue
            if (!ChatStampOk(s.key, d, t))
                continue
            if (!chatSeenKeys.HasKey(s.key)) {
                chatSeenKeys[s.key] := true
                chatMessages.Push({key:s.key, who:u, msg:m, time:t, date:d, uid:uid, img:img})
                added := true
            }
        }
        chatPrimed := true
        Loop {
            if (chatMessages.MaxIndex() <= chCap)
                break
            chatMessages.RemoveAt(1)
        }
        if (added && chOn && chathwnd && DllCall("IsWindowVisible", "Ptr", chathwnd)) {
            global chatScrollY
            chatScrollY := 999999
            DrawChatPanel()
        }
        if (A_TickCount - chReaTick > 5000) {
            chReaTick := A_TickCount
            FetchChatReactions()
        }
    } else {
        chatPrimed := true
    }
    chatPollBusy := false
}

ChatKeyTime(key) {
    static chars := "-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz"
    if (StrLen(key) < 8)
        return 0
    ms := 0
    Loop, 8 {
        p := InStr(chars, SubStr(key, A_Index, 1), true) - 1
        if (p < 0)
            return 0
        ms := ms * 64 + p
    }
    if (ms < 100000000000)
        return 0
    return ms
}

ChatMonthNum(m) {
    static names := ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
    if (StrLen(m) < 3)
        return 0
    u := SubStr(m, 1, 1)
    StringUpper, u, u
    rest := SubStr(m, 2, 2)
    StringUpper, rest, rest
    u .= rest
    for i, n in names {
        if (n = u)
            return i
    }
    return 0
}

ChatPad2(n) {
    n += 0
    return (n < 10) ? ("0" . n) : (n . "")
}

ChatStampOk(key, dateStr, timeStr) {
    ms := ChatKeyTime(key)
    if (ms) {
        secs := A_NowUTC
        EnvSub, secs, 19700101000000, Seconds
        age := (secs * 1000) - ms
        age := (age < 0) ? -age : age
        return (age < 86400000)
    }
    if (!RegExMatch(dateStr, "^(\w{3,})\s+(\d{1,2}),\s*(\d{4})", md))
        return true
    mon := ChatMonthNum(md1)
    day := md2 + 0, yr := md3 + 0
    if (!mon || !day || yr < 2000)
        return true
    hh := 0, mm := 0
    if (RegExMatch(timeStr, "^(\d{1,2}):(\d{2})\s*([AaPp])M", mt)) {
        hh := mt1 + 0, mm := mt2 + 0
        if (mt3 = "P" || mt3 = "p") {
            if (hh < 12)
                hh += 12
        } else if (hh = 12)
            hh := 0
    }
    stamp := yr . ChatPad2(mon) . ChatPad2(day) . ChatPad2(hh) . ChatPad2(mm) . "00"
    diff := A_Now
    EnvSub, diff, %stamp%, Seconds
    if (diff < -86400)
        return true
    return (diff < 86400)
}

