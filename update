FetchChatReactions() {
    global chReaUrl, chReact, chReaSig, macroOn, chOn, chathwnd
    if (macroOn || !chOn)
        return
    r := HttpGet(chReaUrl . "?orderBy=%22%24key%22&limitToLast=200")
    if (!r.ok)
        return
    body := r.body
    if (body = "null" || body = "" || InStr(body, "Permission denied"))
        return
    counts := {}
    sig := ""
    starts := []
    pos := 1
    while (pos := RegExMatch(body, """([A-Za-z0-9_\-]+)""\s*:\s*\{", mm, pos)) {
        starts.Push({key:mm1, at:pos, bodyStart:pos + StrLen(mm)})
        pos += StrLen(mm)
    }
    for i, s in starts {
        end := (i < starts.MaxIndex()) ? starts[i+1].at : StrLen(body) + 1
        entry := SubStr(body, s.bodyStart, end - s.bodyStart)
        c := {}
        p2 := 1
        while (p2 := RegExMatch(entry, """(\d)""\s*:\s*(\d+)", rm, p2)) {
            c[rm1 + 0] := rm2 + 0
            sig .= s.key . ":" . rm1 . "=" . rm2 . ";"
            p2 += StrLen(rm)
        }
        counts[s.key] := c
    }
    chReact := counts
    if (sig != chReaSig) {
        chReaSig := sig
        if (chathwnd && DllCall("IsWindowVisible", "Ptr", chathwnd))
            DrawChatPanel()
    }
}

