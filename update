ChatLinksIn(txt) {
    out := []
    pos := 1
    while (pos := RegExMatch(txt, "i)((?:https?://|www\.)[^\s<>""']+)", m, pos)) {
        u := RegExReplace(m1, "[.,;:!?)]+$", "")
        if (StrLen(u) > 4) {
            url := (SubStr(u, 1, 4) = "www.") ? ("https://" . u) : u
            out.Push({text:u, url:url, start:pos, len:StrLen(u)})
        }
        pos += StrLen(m1)
    }
    return out
}

DrawChatMessageText(G, txt, x, y, w, h, colorHex, size, msgIdx) {
    global chatLinkRects, cA2
    if (w <= 0 || h <= 0)
        return
    lineH := size + 6
    pushclip(G, x, y, w, h)
    lines := StrSplit(txt, "`n")
    maxLines := h // lineH
    maxLines := (maxLines < 1) ? 1 : maxLines
    startIdx := lines.MaxIndex() - maxLines + 1
    startIdx := (startIdx < 1) ? 1 : startIdx
    lineY := y
    Loop, % lines.MaxIndex() {
        ln := lines[A_Index]
        if (A_Index >= startIdx) {
            links := ChatLinksIn(ln)
            if (!links.MaxIndex()) {
                lstroketext(G, ln, x, lineY, w, lineH, colorHex, size, "Left", "vCenter")
            } else {
                fs := FitTextSize(ln, w, size)
                cur := x
                pos := 1
                for li, L in links {
                    if (L.start > pos) {
                        seg := SubStr(ln, pos, L.start - pos)
                        lstroketext(G, seg, cur, lineY, w, lineH, colorHex, fs, "Left", "vCenter", "Segoe UI", true)
                        cur += RunWidth(G, seg, fs)
                    }
                    lstroketext(G, L.text, cur, lineY, w, lineH, cA2, fs, "Left", "vCenter", "Segoe UI", true)
                    lw := RunWidth(G, L.text, fs)
                    chatLinkRects.Push({x:cur, y:lineY, w:lw, h:lineH, url:L.url, msg:msgIdx})
                    cur += lw
                    pos := L.start + L.len
                }
                if (pos <= StrLen(ln))
                    lstroketext(G, SubStr(ln, pos), cur, lineY, w, lineH, colorHex, fs, "Left", "vCenter", "Segoe UI", true)
            }
        }
        lineY += lineH
    }
    popclip(G)
}

