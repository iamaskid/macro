    RestartAnim("winfadeout")
    SetTimer, FadeOutTick, 15
    DrawMenu()
}

FadeOutTick:
    global menuhwnd, fadeOutOn
    if (!fadeOutOn) {
        SetTimer, FadeOutTick, Off
        return
    }
    DrawMenu()
    if (AnimTween("winfadeout", 150) >= 1) {
        fadeOutOn := false
        SetTimer, FadeOutTick, Off
        Gui, menu:Hide
        RestartAnim("winfadeout")
        RestartAnim("winfade")
    }
return

