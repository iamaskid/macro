SelfStats_Read() {
    global selfCpu, selfMem, selfCpuT, selfCpuTime
    h := DllCall("GetCurrentProcess", "Ptr")
    cb := (A_PtrSize = 8) ? 72 : 40
    VarSetCapacity(pmc, cb, 0)
    NumPut(cb, pmc, 0, "UInt")
    if (DllCall("psapi\GetProcessMemoryInfo", "Ptr", h, "Ptr", &pmc, "UInt", cb))
        selfMem := Round(NumGet(pmc, (A_PtrSize = 8) ? 16 : 12, "Ptr") / 1048576, 1)
    VarSetCapacity(ct, 8, 0), VarSetCapacity(xt, 8, 0)
    VarSetCapacity(kt, 8, 0), VarSetCapacity(ut, 8, 0)
    if (DllCall("GetProcessTimes", "Ptr", h, "Ptr", &ct, "Ptr", &xt, "Ptr", &kt, "Ptr", &ut)) {
        used := NumGet(kt, 0, "Int64") + NumGet(ut, 0, "Int64")
        now := A_TickCount
        if (selfCpuTime && selfCpuT) {
            dt := (now - selfCpuT) * 10000
            if (dt > 0) {
                c := (used - selfCpuTime) / dt * 100 / Ov_CpuCount()
                c := (c < 0) ? 0 : c
                selfCpu := Round(c, 1)
            }
        }
        selfCpuTime := used, selfCpuT := now
    }
    return true
}

