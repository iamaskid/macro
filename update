DrawTour(G, W, H) {
    global tutStep, tutTotal, tutRects, tutSceneAt, tutSceneMs, tutAskOpen
    global cA1, cA2, cBg, cTx, cTx2, cDim, cFaint, cLn2, cPn, cPn2, cSh2

    tutRects := []
    if (tutAskOpen) {
        DrawTourAsk(G, W, H)
        return
    }
    d := Tour_Data(tutStep)
    bp := AnimTween("tut" . tutStep, 240)
    t := Mod(A_TickCount - tutSceneAt, tutSceneMs)

    pDim := Gdip_BrushCreateSolid(ApplyAlpha(0xFF000000, 0.62 * bp))
    lfillroundrect(G, pDim, 0, 0, W, H, 10)
    Gdip_DeleteBrush(pDim)

    spot := Tour_SpotRect(d.spot, W, H)
    if (spot.w > 4 && bp > 0.3) {
        pSp := Gdip_CreatePen(ApplyAlpha(cA2, 0.55 * bp), 1)
        ldrawroundrect(G, pSp, spot.x, spot.y, spot.w, spot.h, 10)
        Gdip_DeletePen(pSp)
    }

    panelW := 470
    sceneH := 132
    bodyN := d.body.MaxIndex()
    headerH := 66
    panelH := headerH + sceneH + 12 + bodyN * 17 + 34
    panelX := 34
    panelY := H - panelH - 40 - Round((1 - bp) * 14)
    if (spot.w > 4) {
        overlap := !(panelX + panelW < spot.x || spot.x + spot.w < panelX || panelY + panelH < spot.y || spot.y + spot.h < panelY)
        if (overlap && spot.w * spot.h < W * H * 0.40)
            panelX := W - panelW - 34
    }

    pBgB := Gdip_CreateLineBrushFromRect(panelX, panelY, panelW, panelH, MixARGB(cPn, cA1, 0.12), MixARGB(cPn2, cBg, 0.30), 1, 1)
    lfillroundrect(G, pBgB, panelX, panelY, panelW, panelH, 10)
    Gdip_DeleteBrush(pBgB)
    pShadow := Gdip_BrushCreateSolid(ApplyAlpha(cSh2, 0.6))
    lfillroundrect(G, pShadow, panelX+3, panelY+5, panelW, panelH, 10)
    Gdip_DeleteBrush(pShadow)
    pBgB2 := Gdip_CreateLineBrushFromRect(panelX, panelY, panelW, panelH, MixARGB(cPn, cA1, 0.12), MixARGB(cPn2, cBg, 0.30), 1, 1)
    lfillroundrect(G, pBgB2, panelX, panelY, panelW, panelH, 10)
    Gdip_DeleteBrush(pBgB2)
    pBd := Gdip_CreatePen(ApplyAlpha(cLn2, 1), 1)
    ldrawroundrect(G, pBd, panelX, panelY, panelW, panelH, 10)
    Gdip_DeletePen(pBd)

    dotX := panelX + 18
    Loop, %tutTotal% {
        i := A_Index
        isOn := (i = tutStep), isPast := (i < tutStep)
        dw := isOn ? 14 : 5
        pDotB := Gdip_BrushCreateSolid(ApplyAlpha(isOn ? cA2 : (isPast ? cDim : cFaint), isOn ? (0.35 + 0.65 * bp) : (isPast ? 0.9 : 0.45)))
        lfillroundrect(G, pDotB, dotX, panelY + 15, dw, 5, 2.5)
        Gdip_DeleteBrush(pDotB)
        dotX += dw + 7
    }
    lstroketext(G, tutStep . " / " . tutTotal, panelX + panelW - 88, panelY + 9, 70, 16, cFaint, 8, "Right")

    lstroketext(G, d.kick, panelX + 18, panelY + 28, panelW - 120, 14, cA2, 7, "Left")
    lstroketext(G, d.title, panelX + 18, panelY + 43, panelW - 36, 20, cTx, 11, "Left")

    sx := panelX + 16, sy := panelY + headerH, sw := panelW - 32, sh := sceneH
    pushclip(G, sx, sy, sw, sh)
    TourScene(G, sx, sy, sw, sh, t, tutStep)
    popclip(G)

    ty := panelY + headerH + sceneH + 10
    for i, ln in d.body {
        pBul := Gdip_BrushCreateSolid(ApplyAlpha(cA2, 0.85))
        lfillroundrect(G, pBul, panelX + 20, ty + 6, 3, 3, 1.5)
        Gdip_DeleteBrush(pBul)
        lstroketext(G, ln, panelX + 30, ty, panelW - 50, 15, (i = 1) ? cTx2 : cDim, 8, "Left")
        ty += 17
    }

    btnY := panelY + panelH - 32
    btnW := 76
    bx := panelX + panelW - 16 - btnW
    drawbutton(G, bx, btnY, btnW, 24, (tutStep >= tutTotal) ? "Finish" : "Next", "tut_next")
    tutRects.Push({id:"next", x:bx, y:btnY, w:btnW, h:24})
    if (tutStep > 1) {
        drawbutton(G, bx - btnW - 8, btnY, btnW, 24, "Back", "tut_back")
        tutRects.Push({id:"back", x:bx - btnW - 8, y:btnY, w:btnW, h:24})
    }
    lstroketext(G, "Skip the guide", panelX + 18, btnY, 110, 24, cDim, 8, "Left")
    tutRects.Push({id:"skip", x:panelX + 14, y:btnY, w:116, h:24})
}

Tour_HandleClick(x, y) {
    global tutRects, tutAskOpen
    for i, r in tutRects {
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h && r.id = "yes") {
            tutAskOpen := false
            Tour_Go(7)
            return
        }
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h && r.id = "no") {
            Tour_Close()
            return
        }
        if (x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h) {
            if (r.id = "next")
                Tour_Next()
            else if (r.id = "back")
                Tour_Back()
            else if (r.id = "skip")
                Tour_Close()
            return
        }
    }
}

