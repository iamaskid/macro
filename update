SaveStepPopup() {
    global stepIdx, stepPopupType, stepKeyTxt, stepWaitTxt, stepAct
    global macroSteps, stepPopupOpen

    if (stepPopupType = "key") {
        if (stepKeyTxt = "") {
            ShowToast(brandName, "Enter a key name")
            return
        }
        newStep := {type:"key", key:stepKeyTxt, action: (stepAct = 1) ? "up" : "down"}
    } else {
        ms := stepWaitTxt + 0
        if (ms <= 0) {
            ShowToast(brandName, "Enter a wait in ms")
            return
        }
        newStep := {type:"wait", ms:ms}
    }

    if (stepIdx = 0)
        macroSteps.Push(newStep)
    else
        macroSteps[stepIdx] := newStep

    stepPopupOpen := false
    Storage_AutoSave()
    ConsoleLog("Step saved")
