ImportMacro() {
    global macroSteps, codeText, codeCursorPos
    FileSelectFile, inPath, 3,, Choose a macro file to import, unicorn macro (*.unicornmacro
    if (inPath = "")
        return
    FileRead, raw, %inPath%
    newSteps := [], newCode := "", section := ""
    Loop, Parse, raw, `n, `r
    {
        line := A_LoopField
        if (line = "[steps]") {
            section := "steps"
            continue
        } else if (line = "[code]") {
            section := "code"
            continue
        } else if (SubStr(line,1,1) = "[") {
            section := ""
            continue
        }
        if (section = "steps" && line != "") {
            parts := StrSplit(line, "|")
            if (parts[1] = "key")
                newSteps.Push({type:"key", key:parts[2], action:parts[3]})
            else if (parts[1] = "wait")
                newSteps.Push({type:"wait", ms:parts[2]+0})
        } else if (section = "code") {
            newCode .= (newCode = "" ? "" : "`n") . line
        }
    }
    macroSteps := newSteps
    if (newCode != "") {
        codeText := newCode
        codeCursorPos := StrLen(codeText) + 1
    }
    ShowToast(brandName, "Imported " . newSteps.MaxIndex() . " step(s)")
    ConsoleLog("Imported macro from " . inPath)
    Storage_AutoSave()
    DrawMenu()
}

