YY_ToggleIntervalFor(game, fallbackDelay) {
    global mw19Kali, behavScr
    if (game = "ModernWarfare.exe" && mw19Kali)
        return YY_KaliDelay() + YY_SwapDelay(game)
    if (game = "")
        return (fallbackDelay > 0 ? fallbackDelay : 10)
    d := YY_SwapDelay(game)
    d := behavScr ? Round(d * 0.7) : Round(d * 2.2)
    return (d < 12) ? 12 : d
}

KbToggleTick:
    global macroOn, actInput, masterOn, macroSteps, kb_key, kb_delay, macUse, usageAll
    global yyToggleGame, yyToggleStep, mw19Kali, tglOn, tglNext, reloadPause
    global macPaused, brandName, actInput
    if (!tglOn) {
        if (macroOn && actInput = "kb") {
            macroOn     := false
            macPaused := false
            actInput := ""
        }
        KbPacer(false)
        return
    }
    if (!masterOn || !IsTargetFocused()) {
        tglOn    := false
        KbPacer(false)
        macroOn     := false
        macPaused := false
        actInput := ""
        YY_SendReset()
        mw19Kali      := false
        ShowToast(brandName, "Macro disabled")
        ConsoleLog("Macro OFF (lost focus)")
        Storage_AutoSave()
        return
    }

    curGame := GetActiveGameExe()
    if (curGame != yyToggleGame) {
        yyToggleGame := curGame
        yyToggleStep := 0
        tglNext := 0
    }

    if (yyToggleGame = "")
        return

    if (reloadPause) {
        Critical, Off
        return
    }

    if (tglNext && A_TickCount < tglNext)
        return
    tglNext := A_TickCount + YY_ToggleIntervalFor(yyToggleGame, kb_delay)

    Critical, On

    if PauseHeld() {
        if (!macPaused)
            WeaponPrimary()
        macPaused := true
        Critical, Off
        return
    }
    if (macPaused) {
        macPaused := false
        yyToggleStep := 0
    }

    if (yyToggleGame = "ModernWarfare.exe" && mw19Kali) {
        YY_SendDown()
        macUse++
        usageAll++
        Critical, Off
        return
    }

    if YY_IsSecondary() {
        if (Mod(yyToggleStep, 2) = 0)
            YY_SendDown()
        else
            YY_SendUp()
    } else {
        if (Mod(yyToggleStep, 2) = 0)
            YY_SendUp()
        else
            YY_SendDown()
    }
    yyToggleStep++
    macUse++
    usageAll++
    Critical, Off
return

