Media_WriteHelper() {
    global mHelperB64
    return DecodeBase64ToFile(mHelperB64, Media_HelperPath())
}

Media_KillStray() {
    me := DllCall("GetCurrentProcessId")
    try {
        for proc in ComObjGet("winmgmts:").ExecQuery("SELECT ProcessId, CommandLine FROM Win32_Process WHERE Name='powershell.exe'") {
            if (proc.ProcessId = me)
                continue
            cl := proc.CommandLine
            if (cl != "" && InStr(cl, Media_HelperPath()))
                Process, Close, % proc.ProcessId
        }
    }
}

Media_Ensure() {
    global mediaPid, mRunning
    SetTimer, MediaTick, 320
    if (mRunning && mediaPid) {
        Process, Exist, %mediaPid%
        if (ErrorLevel)
            return
    }
    Media_KillStray()
    if (!Media_WriteHelper())
        return
    cmd := "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File """ . Media_HelperPath() . """"
    Run, %cmd%, , Hide UseErrorLevel, mediaPid
    if (ErrorLevel)
        mediaPid := 0
    mRunning := true
}

Media_Stop() {
    global mRunning, mediaPid, mActive
    if (!mRunning)
        return
    mRunning := false
    SetTimer, MediaTick, Off
    if (mediaPid && mediaPid != DllCall("GetCurrentProcessId"))
        Process, Close, %mediaPid%
    mediaPid := 0
    mActive := false
}

Media_MaybeStop() {
    global mediaWinOpen
    if (Ov_Visible() || mediaWinOpen)
        return
    Media_Stop()
}

Media_Command(cmd) {
    global mActive, mStatus, lyFastL
    Media_Ensure()
    tmp := Media_CmdPath() . ".tmp"
    FileDelete, %tmp%
    FileAppend, %cmd%, %tmp%
    FileDelete, % Media_CmdPath()
    FileMove, %tmp%, % Media_CmdPath(), 1
    if (cmd = "toggle" && mActive) {
        mStatus := (mStatus = "Playing") ? "Paused" : "Playing"
        Media_Redraw()
    }
    lyFastL := 5
    SetTimer, MediaFastTick, 220
}

MediaFastTick:
    Media_Read()
    lyFastL -= 1
    if (lyFastL <= 0)
        SetTimer, MediaFastTick, Off
return

MediaTick:
    Media_Read()
    Media_Watchdog()
return

Media_Read() {
    global mRunning, mActive, mTitle, mArtist, mStatus
    global mPos, mDur, mGen, mCover, mCoverGen
    global mediaWinOpen, mediaScrub, seekUntil, lyOn
    global mPosF, mAnchor
    if (!mRunning)
        return
    FileRead, raw, % Media_StatusPath()
    raw := Trim(raw, " `t`r`n")
    if (raw = "")
        return
    parts := StrSplit(raw, "|")
    changed := false
    if (raw != "none" && (parts[1] != "ok" || parts.MaxIndex() < 6))
        return
    if (parts[1] != "ok" || parts.MaxIndex() < 6) {
        if (mActive) {
            mActive := false
            changed := true
        }
        if (mCover) {
            Gdip_DisposeImage(mCover)
            mCover := 0
            mCoverGen := -1
            changed := true
        }
    } else {
        if (!mActive || mTitle != parts[2] || mArtist != parts[3] || mStatus != parts[4] || mPos != parts[5])
            changed := true
        mActive := true
        newTrack := (!mActive || mTitle != parts[2])
        if (parts.MaxIndex() >= 7 && parts[7] + 0 != mGen)
            newTrack := true
        mTitle  := parts[2]
        mArtist := parts[3]
        mStatus := parts[4]
        if (!mediaScrub && A_TickCount >= seekUntil) {
            rep := parts[5] + 0
            mPos := rep
            prev := Media_NowPos()
            if (parts[4] = "Playing" && !newTrack && rep < prev && (prev - rep) < 5)
                mPosF := prev
            else
                mPosF := rep
            mAnchor := A_TickCount
        }
        mDur    := parts[6] + 0
        mGen    := (parts.MaxIndex() >= 7) ? parts[7] + 0 : 1
        if (lyOn && newTrack)
            Lyrics_Request()
    }
    if (mActive && mCoverGen != mGen && FileExist(Media_CoverPath())) {
        if (mCover) {
            Gdip_DisposeImage(mCover)
            mCover := 0
        }
        mCover := Gdip_CreateBitmapFromFile(Media_CoverPath())
        if (mCover) {
            mCoverGen := mGen
            changed := true
        }
    }
    if (!changed)
        return
    Media_Redraw()
}

Media_Redraw() {
    global mediaWinOpen
    StartAnim()
    if (mediaWinOpen)
        DrawMediaWindow()
    else if (Ov_Visible()) {
        Ov_LayoutKeep()
        DrawOverlay()
    }
}

Media_NowPos() {
    global mPosF, mAnchor, mStatus, mDur
    p := mPosF
    if (mStatus = "Playing")
        p += (A_TickCount - mAnchor) / 1000
    if (p < 0)
        p := 0
    if (mDur > 0 && p > mDur)
        p := mDur
    return p
}

Media_Smooth() {
    global mActive, mStatus, mDur, mNow, animFrame
    global mediaWinOpen, animActive, lyState
    if (!mActive)
        return
    if (!(mediaWinOpen || animActive || Ov_Visible()))
        return
    mNow := Media_NowPos()
    if (mStatus = "Playing" || animActive || lyState = "loading")
        animFrame := true
    Media_LyricsSmooth()
    Media_AnimStep()
}

Media_LyricsSmooth() {
    global lyState, lyTexts, lyKind, lyScrF, lyActF, lyScrInit
    global animFrame
    if (lyState != "ok" || lyTexts.MaxIndex() = "") {
        lyScrF := 1, lyActF := 0, lyScrInit := false
        return
    }
    act := Lyrics_ActiveLine()
    n := lyTexts.MaxIndex()
    rows := (Lyrics_Height() - 12) // 15
    if (rows < 1)
        rows := 1
    target := 1
    if (Lyrics_Timed() && n > rows) {
        target := act - Floor(rows / 2) + 1
        if (target < 1)
            target := 1
        if (target > n - rows + 1)
            target := n - rows + 1
    }
    if (!lyScrInit) {
        lyScrF := target, lyActF := act, lyScrInit := true
        return
    }
    lyScrF += (target - lyScrF) * 0.18
    lyActF += (act - lyActF) * 0.22
    if (Abs(target - lyScrF) < 0.004)
        lyScrF := target
    else
        animFrame := true
    if (Abs(act - lyActF) < 0.004)
        lyActF := act
    else
        animFrame := true
}

Media_RowRect(ByRef out) {
    global overlayhwnd, overlayW, overlayH, lyPanelH
    WinGetPos, ovX, ovY,,, ahk_id %overlayhwnd%
    out.x := ovX + 12
    out.y := ovY + overlayH - 58 - lyPanelH
    out.w := overlayW - 24
    out.h := 50
}

Media_AnimTo(from, to, opening) {
    global animActive, mediaAnimOpen, animStart, mediaAnimFrom, mediaAnimTo
    global lite, mediahwnd
    if (lite) {
        animActive := false
        mediaAnimOpen := opening
        if (!opening && mediahwnd)
            Gui, media:Hide
        return
    }
    mediaAnimFrom := {x:from.x, y:from.y, w:from.w, h:from.h}
    mediaAnimTo   := {x:to.x,   y:to.y,   w:to.w,   h:to.h}
    mediaAnimOpen := opening
    animStart := A_TickCount
    animActive := true
    StartAnim()
}

Media_AnimStep() {
    global animActive, mediaAnimOpen, animStart, mediaAnimFrom, mediaAnimTo
    global mediaAnimX, mediaAnimY, mediaAnimW, mediaAnimH, mediaAnimE, mediahwnd
    global animFrame
    if (!animActive)
        return
    t := (A_TickCount - animStart) / 240
    if (t >= 1) {
        t := 1
        animActive := false
        if (!mediaAnimOpen && mediahwnd)
            Gui, media:Hide
    } else {
        animFrame := true
    }
    e := EaseOutCubic(t)
    mediaAnimE := e
    mediaAnimX := Round(mediaAnimFrom.x + (mediaAnimTo.x - mediaAnimFrom.x) * e)
    mediaAnimY := Round(mediaAnimFrom.y + (mediaAnimTo.y - mediaAnimFrom.y) * e)
    mediaAnimW := Round(mediaAnimFrom.w + (mediaAnimTo.w - mediaAnimFrom.w) * e)
    mediaAnimH := Round(mediaAnimFrom.h + (mediaAnimTo.h - mediaAnimFrom.h) * e)
    if (mediaAnimW < 40)
        mediaAnimW := 40
    if (mediaAnimH < 40)
        mediaAnimH := 40
}

Media_Watchdog() {
    global mRunning, mediaPid, mStale
    if (!mRunning)
        return
    FileGetTime, mt, % Media_StatusPath(), M
    if (mt = "")
        mt := "19700101000000"
    EnvSub, mt, %A_Now%, Seconds
    if (mt < 0)
        mt := -mt
    if (mt < 4) {
        mStale := 0
        return
    }
    mStale += 1
    if (mStale < 3)
        return
    mStale := 0
    mediaPid := 0
    Media_Ensure()
}

