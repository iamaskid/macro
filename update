            Sleep, wdelay
            if (!GetKeyState("XButton2", "P") || GetKeyState("RButton", "P"))
                break

            Send, {2 Down}
            Sleep, 30
            Send, {2 Up}
            Sleep, wdelay
        }
    }

    Send, {1 Down}
    Sleep, 20
    Send, {1 Up}
    kali := false
return

