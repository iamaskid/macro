    px := (px + linkW > monRight - 8) ? monRight - linkW - 8 : px
    py := (py + linkH > monBottom - 8) ? monBottom - linkH - 8 : py
    px := (px < monLeft + 8) ? monLeft + 8 : px
    py := (py < monTop + 8) ? monTop + 8 : py
    return {x:px, y:py}
}

