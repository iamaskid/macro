DrawConsoleLog(G, x, y, w, h) {
    global consoleLines, consoleRcs, consoleY, maxVis
    consoleRcs := []
    if (w <= 0 || h <= 0)
        return

    size := 7
    lineH := size + 6
    normalColor := cOk
    errColor := cErr

    rows := []
    for idx, e in consoleLines {
        cnt := e.times.MaxIndex()
        latestTs := e.times[cnt]
        color := e.isErr ? errColor : normalColor
        if (cnt > 1) {
            arrow := e.expanded ? Chr(9662) : Chr(9656)
            headerText := "[" . latestTs . "] " . e.msg . "  (x" . cnt . ") " . arrow
            rows.Push({entryIdx:idx, text:headerText, color:color, clickable:true})
            if (e.expanded) {
                Loop, % cnt {
                    rows.Push({entryIdx:idx, text:"        " . e.times[A_Index], color:color, clickable:false})
                }
            }
        } else {
            headerText := "[" . latestTs . "] " . e.msg
            rows.Push({entryIdx:idx, text:headerText, color:color, clickable:false})
        }
    }

    pushclip(G, x, y, w, h)
    maxLines := h // lineH
    maxLines := (maxLines < 1) ? 1 : maxLines
    totalRows := rows.MaxIndex()
    totalRows := (totalRows = "") ? 0 : totalRows
    maxScrollRows := totalRows - maxLines
    maxScrollRows := (maxScrollRows < 0) ? 0 : maxScrollRows
    consoleY := (consoleY > maxScrollRows) ? maxScrollRows : consoleY
    consoleY := (consoleY < 0) ? 0 : consoleY
    maxVis := maxScrollRows
    startIdx := totalRows - maxLines + 1 - consoleY
    startIdx := (startIdx < 1) ? 1 : startIdx
    lineY := y
    Loop, % totalRows {
        if (A_Index < startIdx)
            continue
        r := rows[A_Index]
        lstroketext(G, r.text, x, lineY, w, lineH, r.color, size, "Left", "vCenter")
        if (r.clickable)
            consoleRcs.Push({x:x, y:lineY, w:w, h:lineH, entryIdx:r.entryIdx})
        lineY += lineH
    }
    popclip(G)
    DrawScrollbarThumb(G, x+w-4, y, h, totalRows*lineH, h, consoleY*lineH)
}

ConsoleLog(msg) {
    global consoleLines, activetab
    FormatTime, ts,, HH:mm:ss
    isErr := InStr(msg, "fail") || InStr(msg, "Fail") || InStr(msg, "error") || InStr(msg, "Error")
    lastIdx := consoleLines.MaxIndex()
    if (lastIdx && consoleLines[lastIdx].msg = msg) {
        consoleLines[lastIdx].times.Push(ts)
    } else {
        consoleLines.Push({msg:msg, isErr:isErr, times:[ts], expanded:false})
    }
    if (consoleLines.MaxIndex() > 200)
        consoleLines.RemoveAt(1)
    if (activetab = 6)
        RequestMenuRedraw()
}

