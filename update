SliderFreezeTrack(r) {
    global dpiScale, menuhwnd, slTrackX, slTrackW
    WinGetPos, sldWX, sldWY,,, ahk_id %menuhwnd%
    if (sldWX = "")
        sldWX := 0
    slTrackX := sldWX + r.x * dpiScale
    slTrackW := r.w * dpiScale
}

SliderCurrentValue(id) {
    global kb_delay, kaliMs, guiOpa, dpiScale
    if (id = "kb_delay")
        return kb_delay
    if (id = "g_kaliDelay")
        return kaliMs
    if (id = "gui_opacity")
        return guiOpa
    if (id = "ui_scale")
        return Round(dpiScale * 100)
    return 0
}

ApplySliderValue(id, v) {
    global kb_delay, kaliMs, guiOpa, dpiScale
    if (id = "kb_delay")
        kb_delay := v
    else if (id = "g_kaliDelay")
        kaliMs := v
    else if (id = "gui_opacity")
        guiOpa := v
    else if (id = "ui_scale") {
        newScale := v / 100
        if (Abs(newScale - dpiScale) >= 0.01) {
            dpiScale := newScale
            ApplyWindowGeometry()
        }
    }
    Storage_AutoSave()
}

BeginSliderEdit(r) {
    global slEditId, editTxt, slEditMin, slEditMax
    slEditId := r.id
    slEditMin := r.minV
    slEditMax := r.maxV
    editTxt := SliderCurrentValue(r.id) . ""
    st := FieldState("sldedit")
    FieldSet(st, editTxt, StrLen(editTxt) + 1, 1)
    DrawMenu()
}

CommitSliderEdit() {
    global slEditId, editTxt, slEditMin, slEditMax
    id := slEditId
    if (id = "")
        return
    txt := Trim(editTxt)
    slEditId := ""
    if (txt != "") {
        v := txt + 0
        if (v < slEditMin)
            v := slEditMin
        if (v > slEditMax)
            v := slEditMax
        ApplySliderValue(id, Round(v))
    }
    DrawMenu()
}

CancelSliderEdit() {
    global slEditId
    slEditId := ""
    DrawMenu()
}

UpdateSliderFromMouse(r, x) {
    global kb_delay, kaliMs, dpiScale, guiOpa, slTrackX, slTrackW
    pct := (x - r.x) / r.w
    if (slTrackW > 0) {
        MouseGetPos, sldMX
        pct := (sldMX - slTrackX) / slTrackW
    }
    if (pct < 0)
        pct := 0
    if (pct > 1)
        pct := 1
    if (r.id = "kb_delay") {
        kb_delay := Round(10 + pct*290)
        Storage_AutoSave()
    } else if (r.id = "g_kaliDelay") {
        kaliMs := Round(40 + pct*360)
        Storage_AutoSave()
    } else if (r.id = "ui_scale") {
        minV := r.HasKey("minV") ? r.minV : 80
        maxV := r.HasKey("maxV") ? r.maxV : 150
        pctVal := Round(minV + pct*(maxV-minV))
        newScale := pctVal/100
        if (Abs(newScale - dpiScale) >= 0.01) {
            dpiScale := newScale
            ApplyWindowGeometry()
            Storage_AutoSave()
        }
    } else if (r.id = "gui_opacity") {
        minV := r.HasKey("minV") ? r.minV : 30
        maxV := r.HasKey("maxV") ? r.maxV : 100
        guiOpa := Round(minV + pct*(maxV-minV))
        Storage_AutoSave()
    }
    DrawMenu()
}

HandleDropdownClick(r) {
    global ddopen, kb_mode, stepAct, behavScr, behaviorMode, cfgIdx, secEnd, iniPath
    global perfMode, notifPos
    if (r.tag = "header") {
        ddopen := (ddopen = r.id) ? "" : r.id
        DrawMenu()
        return
    }
    if (r.tag = "segment") {
        if (r.id = "kb_mode") {
            kb_mode := r.idx
            Storage_AutoSave()
            ApplyKbHotkey()
        } else if (r.id = "behavior_scroll") {
            behavScr := (r.idx = 1)
            Storage_AutoSave()
        } else if (r.id = "behavior_mode") {
            behaviorMode := r.idx
            Storage_AutoSave()
        }
        DrawMenu()
        return
    }
    if (r.tag = "chklearn") {
        global ddopen
        ddopen := ""
        Check_Learn(r.idx + 1)
        DrawMenu()
        return
    }
    if (r.tag = "check") {
        global reloadWatch, chkShoot, chkAim, iniPath, brandName
        ci := r.idx + 1
        if (ci = 1) {
            reloadWatch := !reloadWatch
            IniWrite, % (reloadWatch ? 1 : 0), %iniPath%, Settings, g_reloadWatch
            Reload_Apply()
            if (reloadWatch && reloadSig = "")
                ShowToast(brandName, "Reload check on - press Learn with the prompt up")
            else
                ShowToast(brandName, reloadWatch ? "Reload check on" : "Reload check off")
        } else if (ci = 2) {
            chkShoot := !chkShoot
            IniWrite, % (chkShoot ? 1 : 0), %iniPath%, Settings, g_chkShoot
        } else {
            chkAim := !chkAim
            IniWrite, % (chkAim ? 1 : 0), %iniPath%, Settings, g_chkAim
        }
        DrawMenu()
        return
    }
    if (r.tag = "option") {
        if (r.id = "step_action")
            stepAct := r.idx
        else if (r.id = "config_select")
            cfgIdx := r.idx
        else if (r.id = "send_mode") {
            sendMode := r.idx
            ApplySendMode()
            Storage_AutoSave()
            ShowToast(brandName, "Input method: " . GetSendModeLabel())
        } else if (r.id = "perf_mode") {
            ApplyPerfMode(r.idx)
            Storage_AutoSave()
        } else if (r.id = "notif_pos") {
            notifPos := r.idx
            Storage_AutoSave()
            ShowToast(brandName, "This is where notifications will appear")
        } else if (r.id = "theme_select") {
            global theme
            theme := GetThemeKeyForIndex(r.idx)
            Storage_AutoSave()
        } else if (r.id = "gui_dragstyle") {
            global dragStyle
            dragStyle := r.idx
            Storage_AutoSave()
        } else if (r.id = "sec_end") {
            secEnd := r.idx
            IniWrite, %secEnd%, %iniPath%, Settings, g_secEnd
            Storage_AutoSave()
        }
        ddopen := ""
        DrawMenu()
        return
    }
}

