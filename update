RenderTutorialStep() {
    global tutIdx, tutSteps, tutWMP

    Gui, tut:Default
    step := tutSteps[tutIdx]

    if (step.kind = "intro") {
        GuiControl, tut:, tutTitle, Looks like your first time running.`nDo you want a tutorial?
        GuiControl, tut:Show, tutTitle
        GuiControl, tut:Hide, tutBody
        GuiControl, tut:Hide, tutWMP
        GuiControl, tut:Show, tutSkip
        GuiControl, tut:Show, tutNext
        GuiControl, tut:Hide, tutBack
        GuiControl, tut:Hide, tutFinalize
        if (IsObject(tutWMP))
            try tutWMP.controls.stop()
        ResizeTutGui(380, 180)
    } else if (step.kind = "content") {
        GuiControl, tut:Hide, tutTitle
        lbl := (step.num != "") ? (step.num . " " . step.text) : step.text
        GuiControl, tut:, tutBody, %lbl%
        GuiControl, tut:Show, tutBody

        b64 := GetTutVideoB64(step.vid)
        if (b64 != "") {
            tmp := A_Temp . "\" . step.vid . ".mp4"
            if (!FileExist(tmp))
                DecodeBase64ToFile(b64, tmp)
            try {
                tutWMP.URL := tmp
                tutWMP.uiMode := "none"
                tutWMP.stretchToFit := true
                tutWMP.settings.setMode("loop", true)
                tutWMP.controls.play()
            }
            GuiControl, tut:Show, tutWMP
        } else {
            if (IsObject(tutWMP))
                try tutWMP.controls.stop()
            GuiControl, tut:Hide, tutWMP
        }

        GuiControl, tut:Hide, tutSkip
        GuiControl, tut:Show, tutNext
        GuiControl, tut:Show, tutBack
        GuiControl, tut:Hide, tutFinalize
        ResizeTutGui(380, 380)
    } else if (step.kind = "final") {
        GuiControl, tut:Hide, tutTitle
        GuiControl, tut:, tutBody, You're finished! Welcome to unykorns macro.
        GuiControl, tut:Show, tutBody
        if (IsObject(tutWMP))
            try tutWMP.controls.stop()
        GuiControl, tut:Hide, tutWMP
        GuiControl, tut:Hide, tutSkip
        GuiControl, tut:Hide, tutNext
        GuiControl, tut:Show, tutBack
        GuiControl, tut:Show, tutFinalize
        ResizeTutGui(380, 180)
    }
}

