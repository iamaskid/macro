            Gdip_DeleteBrush(pN)
            pNb := Gdip_CreatePen(ApplyAlpha(cA2, 0.8), 1)
            ldrawroundrect(G, pNb, x+16, ny, sbW-8, 15, 4)
            Gdip_DeletePen(pNb)
        }
        pNd := Gdip_BrushCreateSolid(ApplyAlpha(on ? cA2 : cDim, 0.85))
        Gdip_FillEllipse(G, pNd, x+22, ny+5, 5, 5)
        Gdip_DeleteBrush(pNd)
        lstroketext(G, navs[A_Index], x+32, ny, sbW-40, 15, on ? cTx : cDim, 6, "Left")
    }

    cxx := x + 12 + sbW + 8, cww := (x + w - 12) - cxx
    MockCard(G, cxx, y+32, cww, 13, 1, cA1, cA2)
    lstroketext(G, "Configure", cxx, y+32, cww, 13, cTx, 6)
    MockCard(G, cxx, y+50, cww, h-66, 1)
    lstroketext(G, "TARGET GAME", cxx+8, y+56, 120, 10, cFaint, 5, "Left")
