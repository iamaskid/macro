ShowToast(title, message) {
    global activeToasts, toastHeight, toastWidth, toastSpacing, maxToasts, notif, notifPos, lite
    if (!notif)
        return

    SysGet, MonitorWorkArea, MonitorWorkArea
    ClearLingeringToasts()

    if (activeToasts.MaxIndex() && activeToasts.MaxIndex() >= maxToasts) {
        oldest := activeToasts[1]
        if (oldest.phase != "out") {
            oldest.phase      := "out"
            oldest.phaseStart := A_TickCount
        }
    }

    Random, randSuffix, 1000, 9999
    toastID   := A_TickCount . "_" . randSuffix
    toastName := "VT" . toastID
    TW   := toastWidth
    TH   := toastHeight
    barH := 3
    totalH := TH + barH

    Gui, %toastName%:New, +AlwaysOnTop -Caption +ToolWindow +LastFound
    toastHwnd := WinExist()
    Gui, %toastName%:Color, 111113
    Gui, %toastName%:Margin, 0, 0

    toastX := (notifPos = 1 || notifPos = 3) ? (MonitorWorkAreaLeft + 16) : (MonitorWorkAreaRight - TW - 16)
    if (notifPos >= 2) {
        toastY := MonitorWorkAreaBottom - 16 - totalH
        for i, t in activeToasts {
            toastY := (t.phase != "out") ? t.y - totalH - toastSpacing : toastY
        }
    } else {
        toastY := MonitorWorkAreaTop + 16
        for i, t in activeToasts {
            toastY := (t.phase != "out") ? t.y + totalH + toastSpacing : toastY
        }
    }

    toastInfo := {id: toastID, y: toastY, name: toastName, hwnd: toastHwnd
        , title: title, message: message, w: TW, totalH: totalH
        , phase: lite ? "hold" : "in", phaseStart: A_TickCount, fadeMs: 150, holdMs: 2400
        , hbmp: 0, hdc: 0, obm: 0, g: 0, barW: TW}
    activeToasts.Push(toastInfo)

    Toast_Setup(toastInfo)
    DrawToastFrame(toastInfo)
    Gui, %toastName%:Show, x%toastX% y%toastY% w%TW% h%totalH% NoActivate
    hRgn := DllCall("CreateRoundRectRgn", "Int", 0, "Int", 0, "Int", TW+1, "Int", totalH+1, "Int", 10, "Int", 10)
    DllCall("SetWindowRgn", "Ptr", toastHwnd, "Ptr", hRgn, "Int", True)
    WinSet, Transparent, % lite ? 210 : 0, ahk_id %toastHwnd%
    Toast_Present(toastInfo)

    SetTimer, ToastAnimTick, % lite ? 120 : 33
}

ToastAnimTick:
    global activeToasts, lite
    now := A_TickCount
    newList := []
    for i, t in activeToasts {
        if (!WinExist("ahk_id " . t.hwnd))
            continue
        elapsed := now - t.phaseStart
        thwnd := t.hwnd
        if (t.phase = "in") {
            frac := elapsed / t.fadeMs
            if (frac >= 1.0) {
                frac := 1.0
                t.phase      := "hold"
                t.phaseStart := now
            }
            WinSet, Transparent, % Round(210 * frac), ahk_id %thwnd%
        } else if (t.phase = "hold") {
            frac := elapsed / t.holdMs
            if (frac >= 1.0) {
                frac := 1.0
                t.phase      := "out"
                t.phaseStart := now
            }
            barW := lite ? t.w : Round(t.w * (1.0 - frac))
            if (barW != t.barW) {
                t.barW := barW
                DrawToastBar(t)
            }
        } else {
            frac := elapsed / t.fadeMs
            if (frac >= 1.0) {
                Toast_Free(t)
                Gui, % t.name . ":Destroy"
                continue
            }
            WinSet, Transparent, % Round(210 * (1.0 - frac)), ahk_id %thwnd%
        }
        newList.Push(t)
    }
    if (newList.MaxIndex() != activeToasts.MaxIndex())
        RearrangeToasts()
    activeToasts := newList
    if (!activeToasts.MaxIndex())
        SetTimer, ToastAnimTick, Off

Toast_Setup(t) {
    t.hbmp := createdibsection(t.w, t.totalH)
    t.hdc  := createcompatibledc()
    t.obm  := selectobject(t.hdc, t.hbmp)
    t.g    := Gdip_GraphicsFromHDC(t.hdc)
    Gdip_SetSmoothingMode(t.g, 4)
}

Toast_Free(t) {
    if (!t.g)
        return
    Gdip_DeleteGraphics(t.g)
    selectobject(t.hdc, t.obm)
    deletedc(t.hdc)
    deleteobject(t.hbmp)
    t.g := 0
}

Toast_Present(t) {
    hdc := DllCall("GetDC", "Ptr", t.hwnd, "Ptr")
    DllCall("BitBlt", "Ptr", hdc, "Int", 0, "Int", 0, "Int", t.w, "Int", t.totalH, "Ptr", t.hdc, "Int", 0, "Int", 0, "UInt", 0xCC0020)
    DllCall("ReleaseDC", "Ptr", t.hwnd, "Ptr", hdc)
}

Toast_Bar(G, TW, totalH, barW) {
    global cBg, cA1, cA2, cLn
    pad := 5
    pbH := 3
    pbY := totalH - pad - pbH
    pbMaxW := TW - (pad * 2)
    scaledBarW := (barW >= TW) ? pbMaxW : Round(pbMaxW * barW / TW)
    scaledBarW := (scaledBarW < 0) ? 0 : scaledBarW
    pClr := Gdip_BrushCreateSolid(cBg)
    Gdip_FillRectangle(G, pClr, pad - 1, pbY - 1, pbMaxW + 2, pbH + 2)
    Gdip_DeleteBrush(pClr)
    pPen := Gdip_CreatePen(cLn, 1)
    Gdip_DrawRectangle(G, pPen, pad, pbY, pbMaxW - 1, pbH - 1)
    Gdip_DeletePen(pPen)
    if (scaledBarW > 0) {
        glowW := (scaledBarW < 60) ? scaledBarW : 60
        pGrad := Gdip_CreateLineBrush(pad + scaledBarW - glowW, pbY, pad + scaledBarW, pbY, cA1, cA2, 1)
        lfillroundrect(G, pGrad, pad, pbY, scaledBarW, pbH, 1)
        Gdip_DeleteBrush(pGrad)
    }
}

DrawToastFrame(t) {
    global cBg, cBd, cA1, cA2
    ApplyThemeGlobals()
    G := t.g
    TW := t.w, totalH := t.totalH
    pad := 5
    acW := 4
    acH := totalH - (pad * 2) - 6
    acX := pad
    acY := pad

