Reload_MaskRect(rx, ry, rw, rh) {
    hbm := Gdip_BitmapFromScreen(rx . "|" . ry . "|" . rw . "|" . rh)
    if (!hbm)
        return ""
    cols := 13, rows := 4
    cw := rw / cols, ch := rh / rows
    offs := [[0,0],[-6,0],[6,0],[0,-3],[0,3],[-6,-3],[6,-3],[-6,3],[6,3]]
    mask := ""
    Loop, %rows% {
        cyy := Round((A_Index - 0.5) * ch)
        Loop, %cols% {
            cxx := Round((A_Index - 0.5) * cw)
            hit := 0
            for k, o in offs {
                argb := Gdip_GetPixel(hbm, cxx + o[1], cyy + o[2])
                rr := (argb >> 16) & 0xFF, gg := (argb >> 8) & 0xFF, bb := argb & 0xFF
                lum := rr * 0.299 + gg * 0.587 + bb * 0.114
                mx := (rr > gg) ? ((rr > bb) ? rr : bb) : ((gg > bb) ? gg : bb)
                mn := (rr < gg) ? ((rr < bb) ? rr : bb) : ((gg < bb) ? gg : bb)
                if (lum >= 195 && (mx - mn) <= 45) {
                    hit := 1
                    break
                }
            }
            mask .= hit
        }
    }
    Gdip_DisposeImage(hbm)
    return mask
}

Reload_Mask() {
    global reloadRect
    if (!IsObject(reloadRect))
        ReloadRect_Set()
    return Reload_MaskRect(reloadRect.x, reloadRect.y, reloadRect.w, reloadRect.h)
}

Reload_Density(m) {
    n := 0
    Loop, % StrLen(m) {
        if (SubStr(m, A_Index, 1) = "1")
            n++
    }
    return n
}

Reload_FindBest() {
    global reloadRect
    if (!IsObject(reloadRect))
        ReloadRect_Set()
    base := reloadRect
    bestX := base.x, bestY := base.y, bestN := -1
    Loop, 5 {
        ox := (A_Index - 3) * 30
        Loop, 19 {
            oy := (A_Index - 10) * 10
            n := Reload_Density(Reload_MaskRect(base.x + ox, base.y + oy, base.w, base.h))
            if (n > bestN)
                bestN := n, bestX := base.x + ox, bestY := base.y + oy
        }
    }
    reloadRect := {x: bestX, y: bestY, w: base.w, h: base.h}
    return bestN
}

Reload_Verdict(cur, ref) {
    if (StrLen(cur) != StrLen(ref) || StrLen(ref) < 2)
        return false
    if (Reload_Density(ref) < 2)
        return false
    miss := 0, extra := 0
    Loop, % StrLen(ref) {
        a := SubStr(ref, A_Index, 1)
        b := SubStr(cur, A_Index, 1)
        if (a = "1" && b = "0")
            miss++
        else if (a = "0" && b = "1")
            extra++
    }
    return (miss <= 3 && extra <= 3) ? true : false
}

Check_Name(idx) {
