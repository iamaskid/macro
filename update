HandleChatClick(lParam) {
    global chatw, chath, chatFoc, chatInputText, chatMessages, chathwnd, localId
    global chatLinkRects
    global chatMenuOpen, chatMenuRects, chatMenuMsg, chatChipRects, chatGripRect, chatResizing
    p := XY_FromLParam(lParam)
    x := p[1], y := p[2]

    if (chatMenuOpen) {
        for i, r in chatMenuRects {
            if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
                target := chatMenuMsg
                chatMenuOpen := false
                key := ChatKeyAt(target)
                if (key = "") {
                    DrawChatPanel()
                    return
                }
                if (r.id = "react")
                    ToggleChatReaction(key, r.idx)
                else if (r.id = "copy_text")
                    ChatCopyText(target)
                else if (r.id = "save_image")
                    ChatSaveImage(target)
                else if (r.id = "report")
                    ChatReport(target)
                DrawChatPanel()
                return
            }
        }
        chatMenuOpen := false
        DrawChatPanel()
        return
    }

    for i, r in chatLinkRects {
        if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
            Link_Ask(r.url)
            return
        }
    }

    for i, r in chatChipRects {
        if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
            ToggleChatReaction(ChatKeyAt(r.msg), r.idx)
            return
        }
    }

    gr := chatGripRect
    if (gr.w && x >= gr.x && x <= gr.x+gr.w && y >= gr.y && y <= gr.y+gr.h) {
        chatResizing := true
        DllCall("SetCapture", "Ptr", chathwnd)
        return
    }

    inpY := chath-40
    if (x >= 10 && x <= chatw-104 && y >= inpY && y <= inpY+26) {
        chatFoc := true
        DrawChatPanel()
        return
    }
    if (x >= chatw-88 && x <= chatw-54 && y >= inpY && y <= inpY+26) {
        chatFoc := false
        ChatPickImage()
        return
    }
    if (x >= chatw-50 && x <= chatw-10 && y >= inpY && y <= inpY+26) {
        if (chatInputText != "") {
            if (TrySendChat(chatInputText))
                chatInputText := ""
            DrawChatPanel()
        }
        return
    }
    if (y < 38) {
        PostMessage, 0xA1, 2,,, ahk_id %chathwnd%
        return
    }
    for i, r in chatMsgRects {
        if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
            if (chatCensor && ChatIsOffensive(ChatMsgText(r.idx)) && !ChatIsRevealed(r.idx)) {
                chatRevealed.Push(r.idx)
                DrawChatPanel()
                return
            }
        }
    }
    chatFoc := false
    DrawChatPanel()
}

