}

Ov_FindPid(name) {
    Process, Exist, %name%
    return ErrorLevel
}

Ov_CpuCount() {
    global ovCores
    if (ovCores)
        return ovCores
    EnvGet, n, NUMBER_OF_PROCESSORS
    ovCores := (n + 0 > 0) ? (n + 0) : 1
    return ovCores
}

Ov_GameIcon(exe, pid) {
    global ovIcon, ovIconKey, ovIconPath
    key := pid . "|" . exe
    if (key = ovIconKey)
        return ovIcon
    if (ovIcon) {
        try
            Gdip_DisposeImage(ovIcon)
        ovIcon := 0
    }
    ovIconKey := key
    if (pid < 1) {
        ovIconPath := ""
        return 0
    }
    path := ""
    try {
        wmi := Ov_Wmi()
        for p in wmi.ExecQuery("SELECT ExecutablePath FROM Win32_Process WHERE ProcessId=" . pid) {
            path := p.ExecutablePath
            break
        }
    } catch e {
        path := ""
    }
    if (path = "")
        path := exe
    ovIconPath := path
    bmp := 0
    if (path != "") {
        try
            bmp := Gdip_CreateBitmapFromFile(path, 1, 48)
        if (bmp < 1)
            bmp := 0
    }
    ovIcon := bmp
    return bmp
}

Ov_TargetProcess() {
    global targetExe, gameNow
    if (targetExe != "")
        return targetExe
    if (gameNow != "")
        return gameNow
    return ""
}

Ov_TargetLabel() {
    global gameNow
    p := Ov_TargetProcess()
    if (p = "")
        return "No game detected"
    if (p = gameNow) {
        lbl := GetSupportedGameLabel(p)
        if (lbl != "")
            return lbl
    }
    return p
}

Ov_FmtDur(secs) {
    if (secs < 0)
        secs := 0
    d := secs // 86400
    h := Mod(secs // 3600, 24)
    m := Mod(secs // 60, 60)
    s := Mod(secs, 60)
    if (d > 0)
        return d . "d " . h . "h " . m . "m"
    if (h > 0)
        return h . "h " . m . "m " . s . "s"
    return m . "m " . s . "s"
}

Ov_ParseDmtf(stamp) {
    if (StrLen(stamp) < 14)
        return ""
    return SubStr(stamp, 1, 14)
}

Ov_Wmi() {
    global ovWmi
    if (!IsObject(ovWmi))
        ovWmi := ComObjGet("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2")
    return ovWmi
}

Ov_RefreshInfo(force := false) {
    global ovInfo, ovInfoTick, ovInfoBusy, perfMode, ovGpuVal, ovGpuTick, macroOn, macPaused
    global ovCpuPid, ovCpuTime, ovCpuTick, ovFallback
    interval := (perfMode = 0) ? 1000 : ((perfMode = 1) ? 1800 : 3000)
    if (!force && (A_TickCount - ovInfoTick) < interval)
        return ovInfo
    if (ovInfoBusy)
        return ovInfo
    ovInfoBusy := true

    proc := Ov_TargetProcess()
    info := {name: Ov_TargetLabel(), exe: proc, connected:false, cpu:0, gpu:-1
           , memMB:0, up:"--", pid:0, cores:Ov_CpuCount()}

    if (proc != "") {
        pid := Ov_FindPid(proc)
        if (pid) {
            info.pid := pid
            h := DllCall("OpenProcess", "UInt", 0x0410, "Int", 0, "Ptr", pid, "Ptr")
            if (!h)
                h := DllCall("OpenProcess", "UInt", 0x1000, "Int", 0, "Ptr", pid, "Ptr")
            if (h) {
                cb := (A_PtrSize = 8) ? 72 : 40
                VarSetCapacity(pmc, cb, 0)
                NumPut(cb, pmc, 0, "UInt")
                if (DllCall("psapi\GetProcessMemoryInfo", "Ptr", h, "Ptr", &pmc, "UInt", cb))
                    info.memMB := Round(NumGet(pmc, (A_PtrSize = 8) ? 16 : 12, "Ptr") / 1048576)

                VarSetCapacity(ct, 8, 0), VarSetCapacity(xt, 8, 0)
                VarSetCapacity(kt, 8, 0), VarSetCapacity(ut, 8, 0)
                if (DllCall("GetProcessTimes", "Ptr", h, "Ptr", &ct, "Ptr", &xt, "Ptr", &kt, "Ptr", &ut)) {
                    used := NumGet(kt, 0, "Int64") + NumGet(ut, 0, "Int64")
                    now := A_TickCount
                    if (ovCpuPid = pid && ovCpuTick) {
                        dt := (now - ovCpuTick) * 10000
                        if (dt > 0) {
                            c := Round((used - ovCpuTime) / dt * 100 / info.cores)
                            info.cpu := (c < 0) ? 0 : ((c > 100) ? 100 : c)
                        }
                    }
                    ovCpuPid := pid, ovCpuTime := used, ovCpuTick := now

                    since1601 := A_NowUTC
                    EnvSub, since1601, 16010101000000, Seconds
                    up := Round(since1601 - (NumGet(ct, 0, "Int64") / 10000000))
                    if (up > 0)
                        info.up := Ov_FmtDur(up)
                }
                DllCall("CloseHandle", "Ptr", h)
            } else if (!ovFallback || (A_TickCount - ovFallback) > 3000) {
                ovFallback := A_TickCount
                Ov_ReadCounters(info, pid)
            }

            if ((!ovGpuTick || (A_TickCount - ovGpuTick) > 20000) && (!macroOn || macPaused)) {
                ovGpuTick := A_TickCount
                try {
                    wmi := Ov_Wmi()
                    needle := "pid_" . pid . "_"
                    total := 0, seen := false
                    for gg in wmi.ExecQuery("SELECT Name,UtilizationPercentage FROM Win32_PerfFormattedData_GPUPerformanceCounters_GPUEngine") {
                        if (InStr(gg.Name, needle)) {
                            total += gg.UtilizationPercentage
                            seen := true
                        }
                    }
                    ovGpuVal := seen ? ((total > 100) ? 100 : Round(total)) : -1
                } catch e {
                    ovGpuVal := -1
                }
            }
            info.gpu := ovGpuVal
            info.connected := true
        }
    }

    ovInfo := info
    ovInfoTick := A_TickCount
    ovInfoBusy := false
    return info
}

Ov_ReadCounters(info, pid) {
    try {
        wmi := Ov_Wmi()
        for p in wmi.ExecQuery("SELECT WorkingSetSize,CreationDate FROM Win32_Process WHERE ProcessId=" . pid) {
            info.memMB := Round(p.WorkingSetSize / 1048576)
            created := Ov_ParseDmtf(p.CreationDate)
            if (created != "") {
                nowLocal := A_Now
                EnvSub, nowLocal, %created%, Seconds
                if (nowLocal > 0)
                    info.up := Ov_FmtDur(nowLocal + 0)
            }
            break
        }
        nm := info.exe
        for c in wmi.ExecQuery("SELECT Name,PercentProcessorTime FROM Win32_PerfFormattedData_PerfProc_Process") {
            n := c.Name
            hp := InStr(n, "#")
            if (hp)
                n := SubStr(n, 1, hp - 1)
            if (n = nm) {
                v := Round(c.PercentProcessorTime / info.cores)
                info.cpu := (v > 100) ? 100 : v
                break
            }
        }
    } catch e {
    }
}

Ov_InfoTick:
    global ovInfoBusy, macroOn, macPaused
    if (!Ov_Visible()) {
        SetTimer, Ov_InfoTick, Off
        return
    }
    if (ovInfoBusy)
        return
    if (macroOn && !macPaused)
        return
    Ov_RefreshInfo(true)
    DrawOverlay()
return

Ov_Visible() {
    global overlayhwnd
    if (!overlayhwnd)
        return false
    return DllCall("IsWindowVisible", "Ptr", overlayhwnd) ? true : false
}

Ov_EnsureWindow() {
    global overlayhwnd, overlayW, overlayH, overlayhdc, overlayhbm, overlayobm, overlayg
    global overlayCurW, overlayCurH, brandName
    if (overlayhwnd)
        return
    Gui, ovl:New, +AlwaysOnTop -Caption +ToolWindow +E0x80000 +LastFound
    Gui, ovl:Show, x80 y80 w%overlayW% h%overlayH% NA, % brandName . " overlay"
    overlayhwnd := WinExist()
    overlayCurW := overlayW, overlayCurH := overlayH
    overlayhbm := createdibsection(overlayW, overlayH)
    overlayhdc := createcompatibledc()
    overlayobm := selectobject(overlayhdc, overlayhbm)
    overlayg   := Gdip_GraphicsFromHDC(overlayhdc)
    ApplyThemeGlobals()
    Gdip_SetSmoothingMode(overlayg, 4)
    Gdip_SetTextRenderingHint(overlayg, 4)
}

Ov_MoveResizeWindow(w, h) {
    global overlayhwnd, overlayhdc, overlayhbm, overlayobm, overlayg, overlayCurW, overlayCurH
    Gui, ovl:Show, w%w% h%h% NA
    Gdip_DeleteGraphics(overlayg)
    selectobject(overlayhdc, overlayobm)
    deletedc(overlayhdc)
    deleteobject(overlayhbm)
    overlayhbm := createdibsection(w, h)
    overlayhdc := createcompatibledc()
    overlayobm := selectobject(overlayhdc, overlayhbm)
    overlayg   := Gdip_GraphicsFromHDC(overlayhdc)
    ApplyThemeGlobals()
    Gdip_SetSmoothingMode(overlayg, 4)
    Gdip_SetTextRenderingHint(overlayg, 4)
    overlayCurW := w, overlayCurH := h
}

Ov_Show() {
    global ovEnabled, overlayW, overlayH, overlayCurW, overlayCurH, lite
    if (!ovEnabled)
        return
    Ov_EnsureWindow()
    Media_Ensure()
    Ov_Layout()
    if (overlayCurW != overlayW || overlayCurH != overlayH)
        Ov_MoveResizeWindow(overlayW, overlayH)
    Ov_RefreshInfo(true)
    Gui, ovl:Show, NA
    global ovPosX, ovPosY
    if (ovPosX >= 0 && ovPosY >= 0)
        WinMove, ahk_id %overlayhwnd%,, %ovPosX%, %ovPosY%
    SetTimer, Ov_InfoTick, % lite ? 2500 : 1000
    DrawOverlay()
}

Ov_Hide() {
    global overlayhwnd, ovPosX, ovPosY
    if (!overlayhwnd)
        return
    SetTimer, Ov_InfoTick, Off
    WinGetPos, _x, _y,,, ahk_id %overlayhwnd%
    ovPosX := _x, ovPosY := _y
    Gui, ovl:Hide
}

OvToggleOverlay:
    Ov_ToggleOverlay()
return

Ov_ToggleOverlay() {
    global ovPinned, ovHoverShown, menuhwnd
    ovPinned := !ovPinned
    if (ovPinned) {
        ovHoverShown := false
        Ov_Show()
    } else {
        ovHoverShown := false
        Ov_Hide()
    }
    if (menuhwnd)
        DrawMenu()
}

ApplyOverlayHotkey() {
    global ovKey, lastOvKey
    if (lastOvKey != "" && lastOvKey != ovKey)
        Hotkey, % "~" . lastOvKey, OvToggleOverlay, Off
    if (ovKey = "") {
        lastOvKey := ""
        return
    }
    Hotkey, % "~" . ovKey, OvToggleOverlay, On
    lastOvKey := ovKey
}

OvHoverTick:
    global pillhwnd, wmOn, ovEnabled, ovHover
    global ovHoverShown, ovPinned, overlayhwnd
    if (!ovEnabled || !ovHover || !pillhwnd) {
        if (ovHoverShown) {
            ovHoverShown := false
            if (!ovPinned)
                Ov_Hide()
        }
        return
    }
    if (ovPinned || !wmOn) {
        if (ovHoverShown)
            ovHoverShown := false
        return
    }
    MouseGetPos,,, under
    over := (under = pillhwnd)
    if (over && !ovHoverShown && DllCall("IsWindowVisible", "Ptr", pillhwnd)) {
        ovHoverShown := true
        Ov_EnsureWindow()
        WinGetPos, pX, pY, pW, pH, ahk_id %pillhwnd%
        WinMove, ahk_id %overlayhwnd%,, %pX%, % (pY + pH + 8)
        Ov_Show()
    } else if (!over && ovHoverShown) {
        ovHoverShown := false
        Ov_Hide()
    }
return

Ov_Layout() {
    global ovExpanded, ovBoxes, overlayW, overlayH, mActive, mediaWinOpen
    global lyPanelH
    extra := (mActive && !mediaWinOpen) ? 62 : 0
    lyr := (mActive && !mediaWinOpen) ? Lyrics_Height() : 0
    lyPanelH := lyr
    if (ovBoxes) {
        overlayW := 330
        overlayH := 176 + extra + lyr
        return
    }
    overlayW := 322
    overlayH := (ovExpanded ? 186 : 78) + extra + lyr
}

DrawOverlay() {
    global mActive, mediaWinOpen
    global overlayg, overlayhwnd, overlayhdc, overlayW, overlayH, clipStk, ovInfo
    global ovExpanded, ovBoxes, ovBoxRects, ovBtnRects
    global ovMenuOpen, ovOpa, mousex, mousey, ovKey
    global cBg, cBg2, cA1, cA2, cBd
    global cTx, cDim, cFaint, theme
    global overlayCurW, overlayCurH, ovDrawing
    if (!overlayg)
        return
    if (overlayCurW != overlayW || overlayCurH != overlayH)
        Ov_MoveResizeWindow(overlayW, overlayH)
    Critical, On
    ovDrawing := true
    try {
    StartAnim()
    if (!IsObject(ovInfo))
        ovInfo := Ov_EmptyInfo()

    G := overlayg
    Gdip_GraphicsClear(G)
    clipStk := []
    ovBtnRects := []
    ovBoxRects := []

    th := GetThemeColors(theme)
    cBg := th.bg, cBg2 := th.bgAlt
    cA1 := th.accent1, cA2 := th.accent2
    cBd := th.border, cTx := th.text
    cDim := th.textDim, cFaint := th.textFaint

    ovW := overlayW, ovH := overlayH
    info := ovInfo

    pBg := Gdip_BrushCreateSolid(cBg)
    lfillroundrect(G, pBg, 0, 0, ovW, ovH, 12)
    Gdip_DeleteBrush(pBg)

    hdrH := 30
    hb := hdrH + 12
    pPanelClip := rrect(0, 0, ovW, ovH, 12)
    Gdip_SetClipPath(G, pPanelClip, 0)
    pHead := Gdip_CreateLineBrush(0, 0, 0, hb, cBg2, cBg, 1)
    Gdip_FillRectangle(G, pHead, 0, 0, ovW, hb)
    Gdip_DeleteBrush(pHead)
    Gdip_ResetClip(G)

    txtX := 26
    ico := info.pid ? Ov_GameIcon(info.exe, info.pid) : 0
    if (ico > 0) {
        icoS := 16
        icoX := 11, icoY := (hdrH - icoS) // 2
        pIcoClip := rrect(icoX, icoY, icoS, icoS, 3)
        Gdip_SetClipPath(G, pIcoClip, 0)
        Gdip_DrawImage(G, ico, icoX, icoY, icoS, icoS)
        Gdip_ResetClip(G)
        txtX := icoX + icoS + 7
    } else {
        pDot := Gdip_BrushCreateSolid(info.connected ? HexToARGB(cOk) : HexToARGB(cFaint))
        Gdip_FillEllipse(G, pDot, 12, hdrH//2 - 4, 8, 8)
        Gdip_DeleteBrush(pDot)
    }

    lstroketext(G, info.name, txtX, 0, ovW - txtX - 66, hdrH, cTx3, 9, "Left")

    mbW := 22, mbH := 18, mbX := ovW - mbW - 8, mbY := (hdrH - mbH) // 2
    mbHov := (mousex >= mbX && mousex <= mbX+mbW && mousey >= mbY && mousey <= mbY+mbH)
    mbv := AnimFrac("ovmenubtn", mbHov ? 1 : 0, 0.34)
    pMb := Gdip_BrushCreateSolid(MixARGB(cBeat, cSel, mbv))
    lfillroundrect(G, pMb, mbX, mbY, mbW, mbH, 5)
    Gdip_DeleteBrush(pMb)
    pMbPen := Gdip_CreatePen(MixARGB(cBd, cA2, mbv), 1)
    ldrawroundrect(G, pMbPen, mbX, mbY, mbW, mbH, 5)
    Gdip_DeletePen(pMbPen)
    pLn := Gdip_CreatePen(HexToARGB(cTx2), 1)
    Loop, 3
        Gdip_DrawLine(G, pLn, mbX + 6, mbY + 5 + (A_Index - 1) * 4, mbX + mbW - 6, mbY + 5 + (A_Index - 1) * 4)
    Gdip_DeletePen(pLn)
    ovBtnRects.Push({x:mbX, y:mbY, w:mbW, h:mbH, id:"ov_menu"})

    global lastOvExp, lastOvMenu
    if (ovExpanded != lastOvExp) {
        lastOvExp := ovExpanded
        RestartAnim("ovexpand")
    }
    if (ovMenuOpen != lastOvMenu) {
        lastOvMenu := ovMenuOpen
        if (ovMenuOpen)
            RestartAnim("ovmenu")
    }

    if (ovBoxes)
        DrawOverlayBoxes(G, ovW)
    else
        DrawOverlayBody(G, ovW, hdrH, info)

    if (ovMenuOpen)
        DrawOverlayMenu(G, ovW)

    if (mActive && !mediaWinOpen) {
        global lyPanelH
        lyrH := lyPanelH
        DrawMediaBlock(G, 12, ovH - 58 - lyrH, ovW - 24, 50, ovBtnRects, "ov_media")
        if (lyrH > 0)
            DrawLyricsPanel(G, 12, ovH - lyrH + 2, ovW - 24, lyrH - 6)
    }

    pOutline := Gdip_CreatePen(cLn2, 1)
    ldrawroundrect(G, pOutline, 0, 0, ovW - 1, ovH - 1, 12)
    Gdip_DeletePen(pOutline)

    WinGetPos, wX, wY,,, ahk_id %overlayhwnd%
    alpha := Round(255 * ovOpa / 100)
    if (alpha < 40)
        alpha := 40
    updatelayeredwindow(overlayhwnd, overlayhdc, wX, wY, ovW, ovH, alpha)
    } catch e {
        clipStk := []
        try
            Gdip_GraphicsClear(overlayg)
        ConsoleLog("drawoverlay error: " . (IsObject(e) ? e.Message : e))
    }
    ovDrawing := false
    Critical, Off
}

DrawOverlayBody(G, ovW, hdrH, info) {
    global ovExpanded, cBd, cA1, cA2, ovKey
    y := hdrH + 5
    sClr := info.connected ? cOk : cFaint
    lstroketext(G, info.connected ? "Connected" : "Not connected", 12, y, 130, 15, sClr, 8, "Left")
    lstroketext(G, ovExpanded ? "click to collapse" : "click for details", 12, y, ovW - 24, 15, cFaint, 7, "Right")
    y += 18

    if (!ovExpanded) {
        lstroketext(G, "CPU " . info.cpu . "%    MEM " . info.memMB . "MB    UP " . info.up, 12, y, ovW - 24, 14, cDim, 8, "Left")
        return
    }

    ep := AnimTween("ovexpand", 200)
    rows := [{lbl:"CPU",    val:info.cpu,                          txt:info.cpu . "%",                        max:100}
           , {lbl:"GPU",    val:(info.gpu < 0 ? 0 : info.gpu),     txt:(info.gpu < 0 ? "n/a" : info.gpu . "%"), max:100}
           , {lbl:"MEMORY", val:info.memMB,                        txt:info.memMB . " MB",                     max:2048}
           , {lbl:"UPTIME", val:-1,                                txt:info.up,                                max:-1}]

    for i, r in rows {
        lstroketext(G, r.lbl, 12, y, 70, 14, ARGBToHex(ApplyAlpha(HexToARGB(cTx5), ep)), 7, "Left")
        lstroketext(G, r.txt, 12, y, ovW - 24, 14, ARGBToHex(ApplyAlpha(HexToARGB(cTx3), ep)), 8, "Right")
        y += 15
        if (r.max > 0) {
            barW := ovW - 24
    pTrack := Gdip_BrushCreateSolid(ApplyAlpha(cTrk, ep))
            lfillroundrect(G, pTrack, 12, y, barW, 4, 2)
            Gdip_DeleteBrush(pTrack)
            frac := r.val / r.max
            if (frac > 1)
                frac := 1
            fillW := Round(barW * frac * ep)
            if (fillW > 0) {
                pFill := Gdip_CreateLineBrush(12, y, 12 + fillW, y, ApplyAlpha(cA1, ep), ApplyAlpha(cA2, ep), 1)
                lfillroundrect(G, pFill, 12, y, fillW, 4, 2)
                Gdip_DeleteBrush(pFill)
            }
            y += 9
        }
    }

    pDiv := Gdip_CreatePen(ApplyAlpha(cBd, ep), 1)
    Gdip_DrawLine(G, pDiv, 12, y + 1, ovW - 12, y + 1)
    Gdip_DeletePen(pDiv)
    lstroketext(G, Ov_PrettyKey(ovKey) . " toggles - right-click for menu", 12, y + 4, ovW - 24, 14, ARGBToHex(ApplyAlpha(HexToARGB(cFaint), ep)), 7, "Left")
}

DrawOverlayBoxes(G, ovW) {
    global ovBoxRects, ovBoxPos, mousex, mousey, cBg2, cBd
    global cA1, cA2
    boxW := (ovW - 30) // 2
    boxH := 60
    defs := ["CPU","GPU","MEMORY","UPTIME"]
    Loop, 4 {
        i := A_Index
        if (!ovBoxPos.HasKey(i))
            ovBoxPos[i] := {x: 10 + Mod(i-1, 2) * (boxW + 10), y: 36 + ((i-1)//2) * (boxH + 8)}
        pos := ovBoxPos[i]
        bx := pos.x, by := pos.y
        hov := (mousex >= bx && mousex <= bx+boxW && mousey >= by && mousey <= by+boxH)
        bv := AnimFrac("ovboxhov:" . i, hov ? 1 : 0, 0.34)
        pBg := Gdip_BrushCreateSolid(MixARGB(cBg2, ApplyAlpha(cA1, 0.22), bv))
        lfillroundrect(G, pBg, bx, by, boxW, boxH, 8)
        Gdip_DeleteBrush(pBg)
        pPen := Gdip_CreatePen(MixARGB(cBd, cA2, bv), 1)
        ldrawroundrect(G, pPen, bx, by, boxW, boxH, 8)
        Gdip_DeletePen(pPen)
        lstroketext(G, defs[i], bx + 8, by + 4, boxW - 16, 13, cTx5, 7, "Left")
        lstroketext(G, Ov_MetricText(defs[i]), bx + 8, by + 19, boxW - 16, 22, cTx2, 12, "Left")
        ovBoxRects.Push({x:bx, y:by, w:boxW, h:boxH, id:"ov_box" . i})
    }
}

Ov_MetricText(lbl) {
    global ovInfo
    if (lbl = "CPU")
        return ovInfo.cpu . "%"
    if (lbl = "GPU")
        return (ovInfo.gpu < 0) ? "n/a" : (ovInfo.gpu . "%")
    if (lbl = "MEMORY")
        return ovInfo.memMB . " MB"
    return ovInfo.up
}

DrawOverlayMenu(G, ovW) {
    global ovBtnRects, mousex, mousey, ovBoxes, ovPinned
    global cPn, cPn2, cBg, cA1, cLn2
    items := [{id:"ov_toggle_pin",   lbl: ovPinned ? "Hide overlay" : "Keep open"}
            , {id:"ov_toggle_boxes", lbl: ovBoxes ? "Single panel" : "Pop out boxes"}
            , {id:"ov_unload",       lbl:"Unload"}]
    mW := 146, rowH := 22
    mH := 3 * rowH + 8
    mX := ovW - mW - 6, mY := 32
    mp := AnimTween("ovmenu", 170)
    if (mp < 0.999)
        PushClip(G, mX - 6, mY - 6, mW + 12, Round((mH + 8) * mp))
    pBg := Gdip_CreateLineBrushFromRect(mX, mY, mW, mH, ApplyAlpha(MixARGB(cPn, cA1, 0.10), mp), ApplyAlpha(MixARGB(cPn2, cBg, 0.30), mp), 1, 1)
    lfillroundrect(G, pBg, mX, mY, mW, mH, 6)
    Gdip_DeleteBrush(pBg)
    pPen := Gdip_CreatePen(ApplyAlpha(cLn2, mp), 1)
    ldrawroundrect(G, pPen, mX, mY, mW, mH, 6)
    Gdip_DeletePen(pPen)
    for i, it in items {
        ry := mY + 4 + (i-1) * rowH
        hov := (mousex >= mX && mousex <= mX+mW && mousey >= ry && mousey <= ry+rowH)
        rv := AnimFrac("ovrow:" . it.id, hov ? 1 : 0, 0.36)
        if (rv > 0.01) {
        pRow := Gdip_BrushCreateSolid(ApplyAlpha(cBeat, rv))
            lfillroundrect(G, pRow, mX+2, ry, mW-4, rowH, 4)
            Gdip_DeleteBrush(pRow)
        }
        clr := (it.id = "ov_unload") ? cErr : cTx3
        lstroketext(G, it.lbl, mX+10, ry, mW-16, rowH, clr, 8, "Left")
        ovBtnRects.Push({x:mX, y:ry, w:mW, h:rowH, id:it.id})
    }
    if (mp < 0.999)
        PopClip(G)
}

Ov_HandleClick(x, y) {
    global ovMenuOpen, ovExpanded, ovBtnRects, ovBoxRects
    global overlayhwnd, ovDragMode, ovDragIdx, ovDragOffX, ovDragOffY, ovBoxPos

    for pass in [1, 2] {
        for i, r in ovBtnRects {
            top := (SubStr(r.id, 1, 9) = "ov_media_" || r.id = "ov_menu")
            if ((pass = 1) != top)
                continue
            if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
                Ov_HandleButton(r.id)
                return
            }
        }
    }
    if (ovMenuOpen) {
        ovMenuOpen := false
        DrawOverlay()
        return
    }
    for i, r in ovBoxRects {
        if (x >= r.x && x <= r.x+r.w && y >= r.y && y <= r.y+r.h) {
            if (y <= r.y + 18) {
                ovDragMode := "box"
                ovDragIdx  := i
                ovDragOffX := x - r.x
                ovDragOffY := y - r.y
                DllCall("SetCapture", "Ptr", overlayhwnd)
            }
            return
        }
    }
    if (y <= 30) {
        MouseGetPos, msx, msy
        WinGetPos, wx, wy,,, ahk_id %overlayhwnd%
        ovDragMode := "window"
        ovDragOffX := msx - wx
        ovDragOffY := msy - wy
        DllCall("SetCapture", "Ptr", overlayhwnd)
        return
    }
    ovExpanded := !ovExpanded
    Ov_LayoutKeep()
    DrawOverlay()
}

Ov_LayoutKeep() {
    global ovExpanded, ovBoxes, overlayW, overlayH, overlayCurW, overlayCurH
    Ov_Layout()
    if (overlayCurW != overlayW || overlayCurH != overlayH)
        Ov_MoveResizeWindow(overlayW, overlayH)
}

Ov_HandleButton(id) {
    global ovMenuOpen, ovBoxes, ovPinned
    if (id = "ov_menu") {
        ovMenuOpen := !ovMenuOpen
    } else if (id = "ov_toggle_pin") {
        ovPinned := !ovPinned
        ovMenuOpen := false
    } else if (id = "ov_toggle_boxes") {
        ovBoxes := !ovBoxes
        ovMenuOpen := false
        Ov_LoadBoxPos()
        Ov_LayoutKeep()
        Storage_AutoSave()
    } else if (id = "ov_unload") {
        UnloadApp()
        return
    } else if (id = "ov_media_prev") {
        Media_Command("prev")
    } else if (id = "ov_media_play") {
        Media_Command("toggle")
    } else if (id = "ov_media_next") {
        Media_Command("next")
    } else if (id = "ov_media_lyr") {
        Lyrics_Toggle()
        return
    } else if (id = "ov_media_pop") {
        Media_OpenWindow()
        return
    }
    DrawOverlay()
}

Ov_HandleMove(x, y) {
    global ovDragMode, ovDragIdx, ovDragOffX, ovDragOffY, ovBoxPos, overlayhwnd
    global dragStyle
    if (ovDragMode = "")
        return
    if (ovDragMode = "window") {
        MouseGetPos, msx, msy
        nx := msx - ovDragOffX
        ny := msy - ovDragOffY
        if (dragStyle = 2) {
            nx := Round(nx / 10) * 10
            ny := Round(ny / 10) * 10
        }
        WinMove, ahk_id %overlayhwnd%,, %nx%, %ny%
        return
    }
    pos := ovBoxPos[ovDragIdx]
    bx := x - ovDragOffX
    by := y - ovDragOffY
    if (dragStyle = 2) {
        bx := Round(bx / 10) * 10
        by := Round(by / 10) * 10
    }
    if (bx < 0)
        bx := 0
    if (by < 30)
        by := 30
    pos.x := bx, pos.y := by
    ovBoxPos[ovDragIdx] := pos
}

Ov_HandleUp() {
    global ovDragMode, ovDragIdx
    if (ovDragMode = "")
        return false
    if (ovDragMode = "box")
        Ov_SaveBoxPos()
    Storage_AutoSave()
    DllCall("ReleaseCapture")
    ovDragMode := ""
    ovDragIdx  := 0
    return true
}

Ov_SaveBoxPos() {
    global ovBoxPos, iniPath
    raw := ""
    Loop, 4 {
        if (ovBoxPos.HasKey(A_Index)) {
            p := ovBoxPos[A_Index]
            raw .= (A_Index > 1 ? "|" : "") . Round(p.x) . "," . Round(p.y)
        } else {
            raw .= (A_Index > 1 ? "|" : "") . "0,0"
        }
    }
    IniWrite, %raw%, %iniPath%, Overlay, boxpos
}

Ov_LoadBoxPos() {
    global ovBoxPos, iniPath, ovBoxes
    ovBoxPos := {}
    if (!ovBoxes)
        return
    IniRead, raw, %iniPath%, Overlay, boxpos, %A_Space%
    if (raw = A_Space || raw = "")
        return
    parts := StrSplit(raw, "|")
    for i, part in parts {
        if (i > 4)
            break
        xy := StrSplit(part, ",")
        if (xy.MaxIndex() >= 2)
            ovBoxPos[i] := {x: xy[1] + 0, y: xy[2] + 0}
    }
}

UnloadApp() {
    global ptoken, pillhwnd, menuhwnd, chathwnd, brandName
    SetTimer, OvHoverTick, Off
    SetTimer, Ov_InfoTick, Off
    SetTimer, CheckMouseLeave, Off
    SetTimer, DetectActiveGameTick, Off
    SetTimer, PresenceTick, Off
    SetTimer, FetchChatMessages, Off
    PresenceClear()
    ConsoleLog("Unloading " . brandName . "...")
    try {
        Gui, media:Destroy
        Gui, ovl:Destroy
        Gui, chat:Destroy
        Gui, menu:Destroy
        Gui, pill:Destroy
    } catch e {
    }
    Media_Stop()
    Media_KillStray()
    Gdip_Shutdown(ptoken)
    ExitApp
}

Tut_MaybeShow() {
    global iniPath, tutOpen, tutDoneRead
    if (tutDoneRead || tutOpen)
        return
    tutDoneRead := true
    IniRead, td, %iniPath%, Settings, g_tutDone, 0
    if (td = 1)
        return
    Tour_Start()
}

Tour_Start() {
    global tutOpen, tutStep, tutRects, activetab, tutDoneRead, tutReturnTab
    tutDoneRead := true
    tutReturnTab := activetab
    tutOpen := true
    tutStep := 1
    activetab := 1
    tutRects := []
    RestartAnim("tut1")
    tutSceneAt := A_TickCount
    SetTimer, TutTickFn, 40
    DrawMenu()
}

Tour_Close() {
    global tutOpen, iniPath, activetab, tutReturnTab
    tutOpen := false
    SetTimer, TutTickFn, Off
    activetab := (tutReturnTab != "") ? tutReturnTab : 1
    IniWrite, 1, %iniPath%, Settings, g_tutDone
    Storage_AutoSave()
    DrawMenu()
}

Tour_Go(n) {
    global tutStep, tutTotal, tutAskOpen, activetab
    tutAskOpen := false
    tutStep := (n < 1) ? 1 : ((n > tutTotal) ? tutTotal : n)
    if (tutStep = 2)
        activetab := 1
    else if (tutStep >= 3 && tutStep <= 5)
        activetab := 2
    else if (tutStep = 7)
        activetab := 2
    else if (tutStep = 8)
        activetab := 5
    else if (tutStep = 9)
        activetab := 7
    else if (tutStep = 10)
        activetab := 3
    else if (tutStep = 11)
        activetab := 4
    RestartAnim("tut" . tutStep)
    tutSceneAt := A_TickCount
    SetTimer, TutTickFn, 40
    DrawMenu()
}

Tour_Next() {
    global tutStep, tutTotal, tutAskOpen
    if (tutStep = 6 && !tutAskOpen) {
        tutAskOpen := true
        RestartAnim("tutask")
        DrawMenu()
        return
    }
    if (tutStep >= tutTotal)
        Tour_Close()
    else
        Tour_Go(tutStep + 1)
}

Tour_Back() {
    global tutStep
    Tour_Go(tutStep - 1)
}

Tour_Key(wParam) {
    global tutAskOpen
    if (wParam = 39 || wParam = 13 || wParam = 32) {
        if (tutAskOpen) {
            tutAskOpen := false
            Tour_Go(7)
            return
        }
        Tour_Next()
        return
    }
    if (wParam = 27 && tutAskOpen) {
        Tour_Close()
        return
    }
    if (wParam = 37) {
        Tour_Back()
        return
    }
    if (wParam = 27)
        Tour_Close()
}

