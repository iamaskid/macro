Seg(t, a, b) {
    if (t <= a)
        return 0
    if (t >= b)
        return 1
    return (t - a) / (b - a)
}

Ease(u) {
    return u * u * (3 - 2 * u)
}

MockCard(G, x, y, w, h, a, clr := "", bd := "") {
    global cIns, cLn
    fill := (clr = "") ? cIns : clr
    line := (bd = "") ? cLn : bd
    p := Gdip_BrushCreateSolid(ApplyAlpha(fill, 0.35 + 0.5 * a))
    lfillroundrect(G, p, x, y, w, h, 6)
    Gdip_DeleteBrush(p)
    pn := Gdip_CreatePen(ApplyAlpha(line, 0.45 + 0.5 * a), 1)
    ldrawroundrect(G, pn, x, y, w, h, 6)
    Gdip_DeletePen(pn)
}

MockPill(G, x, y, w, h, on, a := 1) {
    global cIns, cA1, cA2, cLn
    p := Gdip_BrushCreateSolid(ApplyAlpha(on ? cA1 : cIns, (on ? 0.45 : 0.35) * a))
    lfillroundrect(G, p, x, y, w, h, h / 2)
    Gdip_DeleteBrush(p)
    pn := Gdip_CreatePen(ApplyAlpha(on ? cA2 : cLn, 0.8 * a), 1)
    ldrawroundrect(G, pn, x, y, w, h, h / 2)
    Gdip_DeletePen(pn)
}

SceneDot(G, cx, cy, press) {
    global cA2
    if (press > 0) {
        pR := Gdip_CreatePen(ApplyAlpha(cA2, 0.6 * (1 - press)), 1.4)
        rr := 9 + press * 14
        Gdip_DrawEllipse(G, pR, cx - rr, cy - rr, rr * 2, rr * 2)
        Gdip_DeletePen(pR)
    }
    pS := Gdip_BrushCreateSolid(ApplyAlpha(0xFF000000, 0.40))
    Gdip_FillEllipse(G, pS, cx - 7, cy - 7, 14, 14)
    Gdip_DeleteBrush(pS)
    pB := Gdip_BrushCreateSolid(0xFFFFFFFF)
    Gdip_FillEllipse(G, pB, cx - 5, cy - 5, 10, 10)
    Gdip_DeleteBrush(pB)
    pC := Gdip_BrushCreateSolid(cA2)
    Gdip_FillEllipse(G, pC, cx - 3, cy - 3, 6, 6)
    Gdip_DeleteBrush(pC)
}

SceneCursorMove(G, ax, ay, bx, by, u, press) {
    SceneDot(G, ax + (bx - ax) * u, ay + (by - ay) * u, press)
}

